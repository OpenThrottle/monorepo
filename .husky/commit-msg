#!/usr/bin/env sh

#
# Strip agent-attribution lines so only conventional footers remain.
#
# Emitter-agnostic on purpose — the pattern set is shared with CI in
# .husky/lib/attribution-patterns.sh, and the match is case-insensitive because
# the exact spelling varies by tool (`Co-Authored-By:` vs `Co-authored-by:`).
#
. "$(dirname "$0")/lib/attribution-patterns.sh"

if [ -n "$1" ] && [ -f "$1" ]; then
  if grep -qiE "$OT_ATTRIBUTION_PATTERN" "$1"; then
    grep -viE "$OT_ATTRIBUTION_PATTERN" "$1" > "$1.stripped" || true
    mv "$1.stripped" "$1"
  fi
fi

#
# Propose a better commit type than "chore"
#
proposeBetterCommitType () {
  GIT_DIR=$(git rev-parse --git-dir)
  THE_COMMIT_MESSAGE=$(cat "$GIT_DIR/COMMIT_EDITMSG")
  # echo "💬 THE_COMMIT_MESSAGE: $THE_COMMIT_MESSAGE"

  if [[ $THE_COMMIT_MESSAGE = chore* ]];
  then
    echo "
  ⚠️  The \"chore\" type is generally used for maintenance and housekeeping tasks.

  Try using one of the following more descriptive types:
    build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test
    "

    # proposeBetterCommitTypeDelay;
  fi
}

#
# Add a slight delay (friction) to encourage better commit types. Why?
# Well we use these commit messages to generate change logs and to automate
# the versioning of our packages and applications.
#
proposeBetterCommitTypeDelay () {
  TIMER=$((5 * 1))

  while [ $TIMER -gt 0 ];
  do
    printf "  ... $TIMER \033[0K\r";
    sleep 1;
    TIMER=$((TIMER - 1))
  done
}

#
# Now we run the commit linting and propose a better commit type if needed.
#
echo "💬 Commit Lint"

pnpm exec commitlint --edit $1
proposeBetterCommitType;

echo "✅ Commit Lint Passed"
