{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["./tsconfig.json", "../../tsconfig.vitest-node.json"],
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": [
    "scripts/**/*.spec.ts",
    "scripts/**/*.test.ts",
    "scripts/__tests__/**/*.ts"
  ]
}
