# always-auth=true
# auto-install-peers=true
# node-linker=hoisted

registry=https://registry.npmjs.org

# Package registry via Github Packages
@openthrottle:registry=https://npm.pkg.github.com

# 🔐 GitHub Packages auth — NOTE: the `//npm.pkg.github.com/:_authToken`
# credential is intentionally NOT in this committed file. pnpm 11 refuses to
# expand ${ENV} in a committed project .npmrc (it could leak a secret to an
# attacker-controlled registry), so the token must live in a trusted source.
# Set it once locally (token needs the `packages:read` scope):
#   pnpm config set "//npm.pkg.github.com/:_authToken" "$GITHUB_TOKEN"
# CI (.github/actions/node-setup) and the Docker build stages do the same.
