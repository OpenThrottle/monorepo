API_URL_INTERNAL="http://localhost:6021"
API_URL_EXTERNAL="http://localhost:6021"
APP_ENABLE_ANALYTICS="false"
APP_ENABLE_AUTHENTICATION="false"
APP_ENV="development"
APP_NAME="openthrottle-server"
APP_URL="http://localhost:6021"
APP_VERSION="localhost"
OPENTHROTTLE_WORKER_GRAPHQL_PLACEHOLDER_TOKEN="openthrottle_worker_graphql_placeholder_token"

BULLMQ_BOARD_ADMIN_PASSWORD="admin"
BULLMQ_BOARD_ADMIN_USERNAME="admin"

# Optional: Used by @openthrottle/nestjs-profiling to write execution metadata to a file.
PROFILE_EXECUTION_OUTPUT_PATH="false"

# Optional: GitHub token for listing PRs (list pull requests). Leave unset for public repos only.
GITHUB_TOKEN=""

# Optional: JWT issuer claim (iss). When set, strategy and login both use it.
# JWT_ISSUER="openthrottle-server"
JWT_SECRET="openthrottle_jwt_secret"
LANGSMITH_TRACING="false"
LOG_FORMAT="compact" # compact | development | pretty | production
NODE_ENV="production"
PORT="6021"
ROLLBAR_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# CORS: for frontend on another origin set CORS_ORIGINS (comma-separated); use CORS_CREDENTIALS=true when sending Authorization/cookies. See docs/nestjs/wiring-auth-rbac.md.
# openthrottle-developer default port 6012; 5173 is common Vite fallback; developer.local from allowedHosts.
CORS_CREDENTIALS="true"
CORS_ORIGINS="
http://localhost:6020,
http://localhost:6021,
http://developer.local:6020,
http://developer.local:6021,
http://docker.for.mac.localhost:6020,
http://docker.for.mac.localhost:6021
"

WORKFLOW_RALPH_DEBUG="1"

# Optional: `@openthrottle/nestjs-logging` in openthrottle-server (JSONL + Socket.IO `/ot-logging`). Off by default; restart required after toggling.
OT_SERVER_DEV_JSONL_LOGGING="true"
# OT_SERVER_DEV_JSONL_LOG_DIR=""  # default: .openthrottle/server-logs under process.cwd()

# Optional: per BullMQ job Ralph stdout/stderr JSONL (`KeyedJsonlWriter`). Separate from OT_SERVER_DEV_JSONL_LOG_DIR. Unset = no keyed run files.
# OT_BULLMQ_RUN_OUTPUT_DIR=".openthrottle/bullmq-run-output"

# Plans queue / BullMQ → GraphQL (in-process Ralph orchestrator). Prefer OPENTHROTTLE_WORKER_GRAPHQL_AUTH_TOKEN in production; do not rely on OPENTHROTTLE_WORKER_GRAPHQL_PLACEHOLDER_TOKEN outside local dev.
# OPENTHROTTLE_WORKER_GRAPHQL_AUTH_TOKEN=""
# OPENTHROTTLE_WORKER_GRAPHQL_URL=""
# OPENTHROTTLE_WORKER_GRAPHQL_PLACEHOLDER_TOKEN=""
# 🌳 Worktree Targets (JSON array of [id, path] tuples). Unset = run Ralph in process cwd.
# WORKTREE_TARGETS='[
#   ["worktree-one","/Users/matt/Development/monorepo-worktree-one"],
#   ["worktree-two","/Users/matt/Development/monorepo-worktree-two"]
# ]'

###############################################################################
# 🤖 Google Cloud Platform
###############################################################################
CLOUDSDK_ACTIVE_CONFIG_NAME="openthrottle-staging"
GOOGLE_CLOUD_PROJECT_ID="openthrottle-staging"
GOOGLE_APPLICATION_CREDENTIALS="/Users/matt/.config/gcloud/application_default_credentials.json"

###############################################################################
# 🤖 Postgres
###############################################################################
POSTGRES_HOST="localhost"
POSTGRES_PORT="6010"
POSTGRES_DB="openthrottle"
POSTGRES_USER="openthrottle_user"
POSTGRES_PASSWORD="openthrottle_password"
POSTGRES_URL="postgresql://openthrottle_user:openthrottle_password@localhost:6010/openthrottle"

###############################################################################
# 🤖 Redis
###############################################################################
REDIS_HOST="localhost"
REDIS_PORT="6011"

###############################################################################
# 💰 Stripe
###############################################################################
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
