API_URL_INTERNAL="http://localhost:6021"
API_URL_EXTERNAL="http://localhost:6021"
APP_ENABLE_ANALYTICS="false"
APP_ENV="development"
APP_NAME="openthrottle-server"
APP_NAME_SHORT="Server"
APP_URL="http://localhost:6021"
APP_VERSION="localhost"

# Service account bearer for @openthrottle/openthrottle-mcp (format: ot_sa_<prefix>_<secret>).
# After migrate: pnpm run database:bootstrap-service-accounts — copy printed token here and into Cursor MCP env.
# Rotation: createServiceAccountCredential (admin GraphQL) → update env → revokeServiceAccountCredential. See packages/openthrottle-mcp/docs/AUTH.md.
OPENTHROTTLE_MCP_AUTH_TOKEN=ot_sa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Plans queue / BullMQ → GraphQL (in-process Ralph orchestrator). Prefer a workflow-ralph service account token (ot_sa_…); mint via pnpm run database:bootstrap-service-accounts.
OPENTHROTTLE_WORKER_GRAPHQL_AUTH_TOKEN=""
OPENTHROTTLE_WORKER_GRAPHQL_URL="http://localhost:6021/graphql"

# Optional: when true, allows routed write tools listed in agents-chat-mutation-policy (default read-only agents chat).
# AGENTS_CHAT_ALLOW_MUTATIONS="false"

# Optional: agentsRunChatTurn hybrid router — when AGENTS_MCP_ROUTER_LLM_FALLBACK is true, low-confidence rule routes trigger one structured LLM call (requires OPENAI_API_KEY or OLLAMA_BASE_URL).
# AGENTS_MCP_ROUTER_LLM_FALLBACK="false"
# AGENTS_MCP_ROUTER_LLM_CONFIDENCE_THRESHOLD="0.55"
# AGENTS_MCP_ROUTER_LLM_OPENAI_MODEL="gpt-4o-mini"
# AGENTS_MCP_ROUTER_LLM_OLLAMA_MODEL="llama3.2"

# Optional: Used by @openthrottle/nestjs-profiling to write execution metadata to a file.
PROFILE_EXECUTION_OUTPUT_PATH="false"

# Optional: GitHub token for listing PRs (list pull requests). Leave unset for public repos only.
GITHUB_TOKEN="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"

# Optional: JWT issuer claim (iss). When set, strategy and login both use it.
# JWT_ISSUER="openthrottle-server"
JWT_SECRET="openthrottle_jwt_secret"
LANGSMITH_TRACING="false"
LOG_FORMAT="compact" # compact | development | pretty | production
NODE_ENV="production"
PORT="6021"
ROLLBAR_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# CORS: for frontend on another origin set CORS_ORIGINS (comma-separated); use CORS_CREDENTIALS=true when sending Authorization/cookies. See docs/nestjs/wiring-auth-rbac.md.
# openthrottle-developer default port 6012; 5173 is common Vite fallback; developer.local from allowedHosts.
CORS_CREDENTIALS="true"
CORS_ORIGINS="
http://localhost:6020,
http://localhost:6021,
http://localhost:6022,
http://developer.local:6020,
http://developer.local:6021,
http://developer.local:6022,
http://docker.for.mac.localhost:6020,
http://docker.for.mac.localhost:6021,
http://docker.for.mac.localhost:6022
"

# Optional: scheduled local Postgres backup (BullMQ queue "Database Backup"). See docs/openthrottle/database-backup-scheduled-job-spec.md
# Requires pg_dump and zip on PATH; set WORKSPACE_ROOT when the server cwd is not the monorepo root.
DATABASE_BACKUP_CRON="0 0 0 * * *"
DATABASE_BACKUP_TZ=""
DATABASE_BACKUP_ENABLED="true"
DATABASE_BACKUP_JOB_TIMEOUT_MS="1800000"

# Ralph/workflow tuning for worker + nested workflow-ralph (see docs/workflows/ralph-config-migration.md).
# Precedence: GraphQL enqueue tuning → env → .workflow-ralph.json in worktree cwd → built-ins.
# Prefer WORKFLOW_RALPH_DEBUG; RALPH_DEBUG is a deprecated alias. Same keys can live in repo-root
# .workflow-ralph.json (spawn.diagnostics, debug, transport) — env here still overrides file.
OPENTHROTTLE_PLANS_SPAWN_DIAGNOSTICS="1"
WORKFLOW_RALPH_OT_DIAGNOSTICS="1"
WORKFLOW_RALPH_DEBUG="1"

# WORKSPACE_ROOT="/Users/matt/Development/openthrottle"

# Optional: `@openthrottle/nestjs-logging` in openthrottle-server (JSONL + Socket.IO `/ot-logging`). Off by default; restart required after toggling.
OT_SERVER_DEV_JSONL_LOGGING="true"
# OT_SERVER_DEV_JSONL_LOG_DIR=""  # default: .openthrottle/server-logs under process.cwd()

# Optional: per BullMQ job Ralph stdout/stderr JSONL (`KeyedJsonlWriter`). Separate from OT_SERVER_DEV_JSONL_LOG_DIR. Unset = no keyed run files.
BULLMQ_RUN_OUTPUT_DIR=".openthrottle/bullmq-run-output"

# Optional retention (requires BULLMQ_RUN_OUTPUT_DIR; set at least one of max-age or max-total-bytes). Throttled post-job prune in workers; default min interval 300000 ms.
# BULLMQ_RUN_OUTPUT_MAX_AGE_MS="604800000"
# BULLMQ_RUN_OUTPUT_MAX_TOTAL_BYTES="1073741824"
# BULLMQ_RUN_OUTPUT_PRUNE_MIN_INTERVAL_MS="300000"

# 🌳 Worktree Targets (JSON array of [id, path] tuples). Unset = run Ralph in process cwd.
# WORKTREE_TARGETS='[
#   ["worktree-one","/Users/matt/Development/monorepo-worktree-one"],
#   ["worktree-two","/Users/matt/Development/monorepo-worktree-two"]
# ]'

###############################################################################
# 🎯 BullMQ Board
###############################################################################
BULLMQ_BOARD_ADMIN_PASSWORD="admin"
BULLMQ_BOARD_ADMIN_USERNAME="admin"

###############################################################################
# 🤖 Google Cloud Platform
###############################################################################
CLOUDSDK_ACTIVE_CONFIG_NAME="openthrottle-staging"
GOOGLE_CLOUD_PROJECT_ID="openthrottle-staging"
GOOGLE_APPLICATION_CREDENTIALS="/Users/matt/.config/gcloud/application_default_credentials.json"

###############################################################################
# 🤖 Postgres
###############################################################################
POSTGRES_HOST="localhost"
POSTGRES_PORT="6010"
POSTGRES_DB="openthrottle"
POSTGRES_USER="openthrottle_user"
POSTGRES_PASSWORD="openthrottle_password"
POSTGRES_URL="postgresql://openthrottle_user:openthrottle_password@localhost:6010/openthrottle"

###############################################################################
# 🤖 Redis
###############################################################################
REDIS_HOST="localhost"
REDIS_PORT="6011"

###############################################################################
# 💰 Stripe
###############################################################################
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
