###############################################################################
#
#   - ✏️ = Customizable for a "fresh" installation ~ first time setup ONLY
#   - ♻️ = Grab values from ".bootstrap-secrets.local" ~ after initial setup
#   - 🔐 = Use the subscription(s) you already have ~ totally optional
#
###############################################################################

# ♻️ Replace these two tokens
OPENTHROTTLE_MCP_AUTH_TOKEN=
OPENTHROTTLE_WORKER_GRAPHQL_AUTH_TOKEN=

# 🔐 Webhook-triggered agent jobs: AES-256-GCM key (32 bytes, base64) that encrypts each
# trigger's HMAC secret at rest. REQUIRED to create a webhook trigger; without it, trigger
# creation fails and /webhooks/agent-jobs/:token answers 503 (fail closed, never plaintext).
# `./scripts/setup.sh` and worktree provisioning generate one here when this line is empty;
# otherwise make one with `openssl rand -base64 32`. Changing it orphans existing secrets
# (rotate each trigger afterwards).
WEBHOOK_SECRET_ENCRYPTION_KEY=

# 🛡️ MCP scheduling guardrails (docs/openthrottle/webhook-triggered-agent-jobs.md, threat T10).
# Most live scheduled agent jobs one user may own, however they were created. Creating past it fails
# loudly. At most 10 of them may be agent-created (MCP), which is not configurable.
SCHEDULED_AGENT_JOBS_MAX_PER_OWNER=25
# When true, a job an agent creates over MCP is stored disabled with approval_state=pending and arms
# only when a person approves it (approveScheduledAgentJob). Editing an approved agent job then sends
# it back to pending. Default false.
SCHEDULED_AGENT_JOBS_MCP_REQUIRE_APPROVAL=false

# 🔐 Keys for specific AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# ⚙️ OpenThrottle Settings
OPENTHROTTLE_PERSONAL_SKILLS_ENABLED=true
OT_AGENT_CLI_INSTALL_ENABLED=false

###############################################################################
#
#   👀  Feel free to adjust the values below to suite your needs.  👀
#
###############################################################################


# 🤖 OpenThrottle | MCP Server
# OPENTHROTTLE_WORKER_GRAPHQL_URL="http://localhost:6021/graphql"

# 🤖 OpenThrottle | MCP Server
API_URL_INTERNAL="http://localhost:6021"
API_URL_EXTERNAL="http://localhost:6021"
APP_ENV="development"
APP_NAME="openthrottle-server"
APP_NAME_SHORT="Server"
APP_URL="http://localhost:6021"
APP_VERSION="localhost"

# Optional: when true, allows routed write tools listed in agents-chat-mutation-policy (default read-only agents chat).
AGENTS_CHAT_ALLOW_MUTATIONS="true"

# Optional: agentsRunChatTurn hybrid router — when AGENTS_MCP_ROUTER_LLM_FALLBACK is true, low-confidence rule routes trigger one structured LLM call (requires OPENAI_API_KEY or OLLAMA_BASE_URL).
# AGENTS_MCP_ROUTER_LLM_FALLBACK="false"
# AGENTS_MCP_ROUTER_LLM_CONFIDENCE_THRESHOLD="0.55"
# AGENTS_MCP_ROUTER_LLM_OPENAI_MODEL="gpt-4o-mini"
# AGENTS_MCP_ROUTER_LLM_OLLAMA_MODEL="llama3.2"

# Optional: Used by @openthrottle/nestjs-profiling to write execution metadata to a file.
PROFILE_EXECUTION_OUTPUT_PATH="false"

# Optional: GitHub token for listing PRs (list pull requests). Leave unset for public repos only.
# GITHUB_TOKEN=

# Optional: serve the work ledger for GitLab-hosted repositories. Self-hosted: set the base URL.
# GITLAB_BASE_URL=https://gitlab.com
# GITLAB_TOKEN=

# Optional: JWT issuer claim (iss). When set, strategy and login both use it.
# JWT_ISSUER="openthrottle-server"
# Local-dev value. The server refuses it when NODE_ENV=production unless
# OPENTHROTTLE_ALLOW_DEFAULT_JWT_SECRET=true (set only by the local root docker-compose stack).
JWT_SECRET="OpenThrottle_2026_default_secret"
LANGSMITH_TRACING="false"
LOG_FORMAT="compact" # compact | development | pretty | production
NODE_ENV="development"
# Optional: open self-registration (the public `register` mutation). Unset = on outside
# production, off when NODE_ENV=production; "true" / "false" force it either way.
# OPENTHROTTLE_REGISTRATION_ENABLED="false"
# Optional: dev-only test mutations (triggerWebsocketNotification, triggerDevJsonlLogSample).
# Unset = on outside production, off when NODE_ENV=production; "true" / "false" force it.
# OT_ENABLE_DEV_GRAPHQL="false"
PORT="6021"
ROLLBAR_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# CORS: for frontend on another origin set CORS_ORIGINS (comma-separated); use CORS_CREDENTIALS=true when sending Authorization/cookies. See docs/nestjs/wiring-auth-rbac.md.
# openthrottle-developer default port 6012; 5173 is common Vite fallback; developer.local from allowedHosts.
CORS_CREDENTIALS="true"
CORS_ORIGINS="
http://localhost:6020,
http://localhost:6021,
http://localhost:6022,
http://developer.local:6020,
http://developer.local:6021,
http://developer.local:6022,
http://docker.for.mac.localhost:6020,
http://docker.for.mac.localhost:6021,
http://docker.for.mac.localhost:6022
"

# Optional: scheduled local Postgres backup (BullMQ queue "Database Backup"). See docs/openthrottle/database-backup-scheduled-job-spec.md
# Requires pg_dump and zip on PATH; set WORKSPACE_ROOT when the server cwd is not the monorepo root.
DATABASE_BACKUP_CRON="0 0 0 * * *"
DATABASE_BACKUP_TZ=""
DATABASE_BACKUP_ENABLED="true"
DATABASE_BACKUP_JOB_TIMEOUT_MS="1800000"

# Ralph/workflow tuning for worker + nested workflow-ralph (see docs/workflows/ralph-config-migration.md).
# Precedence: GraphQL enqueue tuning → env → .workflow-ralph.json in worktree cwd → built-ins.
# Prefer WORKFLOW_RALPH_DEBUG; RALPH_DEBUG is a deprecated alias. Same keys can live in repo-root
# .workflow-ralph.json (spawn.diagnostics, debug, transport) — env here still overrides file.
OPENTHROTTLE_PLANS_SPAWN_DIAGNOSTICS="1"
OT_BULLMQ_REDIS_INTEGRATION="true"
OT_QUEUE_PLAN_CONCURRENCY="4"
WORKFLOW_RALPH_OT_DIAGNOSTICS="1"
WORKFLOW_RALPH_DEBUG="1"

# WORKSPACE_ROOT="/Users/matt/Development/openthrottle"

# Optional: `@openthrottle/nestjs-logging` in openthrottle-server (JSONL + Socket.IO `/ot-logging`). Off by default; restart required after toggling.
OT_SERVER_DEV_JSONL_LOGGING="true"
# OT_SERVER_DEV_JSONL_LOG_DIR=""  # default: .openthrottle/server-logs under process.cwd()

# Optional: per BullMQ job Ralph stdout/stderr JSONL (`KeyedJsonlWriter`). Separate from OT_SERVER_DEV_JSONL_LOG_DIR. Unset = no keyed run files.
BULLMQ_RUN_OUTPUT_DIR=".openthrottle/bullmq-run-output"

# Optional retention (requires BULLMQ_RUN_OUTPUT_DIR; set at least one of max-age or max-total-bytes). Throttled post-job prune in workers; default min interval 300000 ms.
# BULLMQ_RUN_OUTPUT_MAX_AGE_MS="604800000"
# BULLMQ_RUN_OUTPUT_MAX_TOTAL_BYTES="1073741824"
# BULLMQ_RUN_OUTPUT_PRUNE_MIN_INTERVAL_MS="300000"

# 🌳 Worktree Targets (JSON array of [id, path] tuples). Unset = run Ralph in process cwd.
# WORKTREE_TARGETS='[
#   ["worktree-one","/Users/matt/Development/monorepo-worktree-one"],
#   ["worktree-two","/Users/matt/Development/monorepo-worktree-two"]
# ]'

# OT_WORKTREE_DB marks a git worktree: "shared" = uses the primary checkout's
# Postgres/Redis, "isolated" = owns its own (`pnpm worktree:db isolate`). Written by scripts/setup_worktree.ts
# (and backfilled by `pnpm worktree:heal`); leave unset in the primary checkout.
# OT_WORKTREE_DB=

# BullMQ key prefix (environment-scoped queue namespacing). Leave unset to
# derive it: OT_QUEUE_PREFIX wins, else OT_CONTAINER_PREFIX (set per-worktree
# by setup_worktree.ts) yields "bull:wt-<slug>", else BullMQ's default "bull".
# Checkouts sharing one Redis MUST resolve different prefixes or their workers
# will consume each other's jobs (e.g. a plan run executing on the wrong
# checkout).
# OT_QUEUE_PREFIX=""

# Which halves of the server this process hosts: "api" (HTTP/GraphQL + queue
# producers), "worker" (BullMQ processors, no HTTP), or "all" (default —
# single-process, today's behavior). Split them in dev (nx targets dev-api +
# worker) so editing API code never restarts an in-flight job or detaches the
# worker debugger.
# PROCESS_ROLE="all"

# 🎯 BullMQ Board
BULLMQ_BOARD_ADMIN_PASSWORD="openthrottle_password"
BULLMQ_BOARD_ADMIN_USERNAME="admin"

# 🤖 Google Cloud Platform
CLOUDSDK_ACTIVE_CONFIG_NAME="openthrottle-staging"
GOOGLE_CLOUD_PROJECT_ID="openthrottle-staging"
GOOGLE_APPLICATION_CREDENTIALS="/Users/matt/.config/gcloud/application_default_credentials.json"

# 🤖 Postgres
POSTGRES_HOST="localhost"
POSTGRES_DB="openthrottle" # ✏️ CHANGE THIS ✏️
POSTGRES_PASSWORD="openthrottle_password" # ✏️ CHANGE THIS ✏️
POSTGRES_PORT="6010"
POSTGRES_USER="openthrottle_user" # ✏️ CHANGE THIS ✏️
POSTGRES_URL="postgresql://openthrottle_user:openthrottle_password@localhost:6010/openthrottle" # ✏️ CHANGE THIS ✏️

# 🤖 Redis
REDIS_HOST="localhost"
REDIS_PORT="6011"

# 💰 Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# 🗣️ Whisper voice transcription (`pnpm run voice:start`). Not in the worktree
# port block on purpose: every worktree shares the primary checkout's whisper on
# :6030, so a worktree server transcribes against it unchanged.
WHISPER_SERVICE_URL="ws://localhost:6030"
# WHISPER_MODEL="tiny.en"
