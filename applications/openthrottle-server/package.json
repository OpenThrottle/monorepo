{
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://openthrottle.ai"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "catalog:",
    "@langchain/core": "catalog:",
    "@langchain/ollama": "catalog:",
    "@langchain/openai": "catalog:",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/graphql": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/passport": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@openthrottle/agentic-token-usage": "workspace:^",
    "@openthrottle/nestjs-agentic-workflow": "workspace:^",
    "@openthrottle/nestjs-auth": "workspace:^",
    "@openthrottle/nestjs-bullmq": "workspace:^",
    "@openthrottle/nestjs-bullmq-board": "workspace:^",
    "@openthrottle/nestjs-github": "workspace:^",
    "@openthrottle/nestjs-graphql": "workspace:^",
    "@openthrottle/nestjs-logging": "workspace:^",
    "@openthrottle/nestjs-model-discovery": "workspace:^",
    "@openthrottle/nestjs-modules": "workspace:^",
    "@openthrottle/nestjs-openthrottle-mcp": "workspace:^",
    "@openthrottle/nestjs-profiling": "workspace:^",
    "@openthrottle/nestjs-rbac": "workspace:^",
    "@openthrottle/nestjs-repositories": "workspace:^",
    "@openthrottle/nestjs-rollout": "workspace:^",
    "@openthrottle/nestjs-stripe": "workspace:^",
    "@openthrottle/nestjs-throttler": "workspace:^",
    "@openthrottle/nestjs-utils": "workspace:^",
    "@openthrottle/nestjs-vector-search": "workspace:^",
    "@openthrottle/nestjs-websockets": "workspace:^",
    "@openthrottle/nestjs-worktrees": "workspace:^",
    "@openthrottle/node-client": "workspace:^",
    "@openthrottle/nodejs-graphql": "workspace:^",
    "@openthrottle/openthrottle-agentic-ralph": "workspace:^",
    "@openthrottle/openthrottle-agentic-utils": "workspace:^",
    "@openthrottle/openthrottle-agentic-workflow": "workspace:^",
    "@openthrottle/openthrottle-notifications": "workspace:^",
    "@openthrottle/openthrottle-skills": "workspace:^",
    "@tools/workflows": "workspace:^",
    "bullmq": "catalog:",
    "chokidar": "catalog:",
    "dataloader": "catalog:",
    "dotenv": "catalog:",
    "graphql": "catalog:",
    "ignore": "catalog:",
    "passport-local": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typeorm": "catalog:",
    "zod": "catalog:"
  },
  "description": "NestJS GraphQL API for OpenThrottle plans, tasks, embeddings, and related platform services (Redis, BullMQ, Stripe).",
  "license": "Apache-2.0",
  "main": "./src/main.ts",
  "module": "./src/main.ts",
  "name": "openthrottle-server",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "./",
    "tags": [
      "name:openthrottle-server",
      "production:true",
      "technology:nestjs",
      "type:application"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "^build-package"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "nest build --path tsconfig.app.json",
          "cwd": "{projectRoot}"
        }
      },
      "docker-build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "docker build -f Dockerfile.NestJS --target production --build-arg APP_NAME=openthrottle-server --build-arg APP_VERSION=$APP_VERSION --build-arg NX_VERSION=$NX_VERSION --build-arg PNPM_VERSION=$PNPM_VERSION --build-arg GITHUB_TOKEN=$GITHUB_TOKEN --build-arg NX_KEY=$NX_KEY -t openthrottle-server:local .",
          "cwd": "{workspaceRoot}",
          "env": {
            "APP_VERSION": "1.3.0",
            "NX_VERSION": "22.7.4",
            "PNPM_VERSION": "11.6.0"
          }
        },
        "description": "Build openthrottle-server image from root Dockerfile.NestJS (monorepo context). Set GITHUB_TOKEN and NX_KEY in environment for private deps and Nx cache."
      },
      "dev": {
        "continuous": true,
        "dependsOn": [
          {
            "target": "ensure-worktree",
            "projects": "monorepo"
          },
          "^dev"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "nest start --path tsconfig.app.json --watch",
          "cwd": "{projectRoot}",
          "env": {
            "PROCESS_ROLE": "all"
          }
        }
      },
      "dev-api": {
        "continuous": true,
        "dependsOn": [
          "^dev"
        ],
        "description": "dev (watch) restricted to PROCESS_ROLE=api: HTTP/GraphQL + queue producers, no BullMQ processors. Pair with the `worker` target so API edits never restart in-flight jobs or detach the worker debugger.",
        "executor": "nx:run-commands",
        "options": {
          "command": "nest start --path tsconfig.app.json --watch",
          "cwd": "{projectRoot}",
          "env": {
            "PROCESS_ROLE": "api"
          }
        }
      },
      "dev-debug": {
        "continuous": true,
        "dependsOn": [
          "^dev"
        ],
        "description": "dev with the Node inspector bound to 0.0.0.0:9229 (used by the compose dev profile so a host debugger can attach; --debug flags only the Nest app process, unlike NODE_OPTIONS).",
        "executor": "nx:run-commands",
        "options": {
          "command": "nest start --path tsconfig.app.json --debug 0.0.0.0:9229 --watch",
          "cwd": "{projectRoot}"
        }
      },
      "lint": {
        "options": {
          "command": "pnpm exec eslint -c ./eslint.config.mts .",
          "cwd": "{projectRoot}"
        }
      },
      "start": {
        "continuous": true,
        "dependsOn": [
          "^build"
        ],
        "description": "Run openthrottle-server via `nest start` (no watch, no debug) after dependencies build.",
        "executor": "nx:run-commands",
        "options": {
          "command": "nest start --path tsconfig.app.json",
          "cwd": "{projectRoot}"
        }
      },
      "test": {},
      "typecheck": {},
      "worker": {
        "continuous": true,
        "dependsOn": [
          "^build"
        ],
        "description": "Run BullMQ processors only (PROCESS_ROLE=worker, no HTTP listener, no watch — deliberately, so API edits can't restart it). Pair with `dev-api` for the split dev loop.",
        "executor": "nx:run-commands",
        "options": {
          "command": "nest start --path tsconfig.app.json",
          "cwd": "{projectRoot}",
          "env": {
            "PROCESS_ROLE": "worker"
          }
        }
      }
    }
  },
  "private": true,
  "repository": "git://github.com/OpenThrottle/server.git",
  "scripts": {
    "langgraph": "npx @langchain/langgraph-cli dev",
    "start:docker": "node -r dotenv/config ./build/src/main.js"
  },
  "sideEffects": false,
  "type": "commonjs",
  "version": "1.3.0",
  "devDependencies": {
    "@openthrottle/nestjs-testing": "workspace:^"
  }
}
