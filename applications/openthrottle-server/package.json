  "description": "NestJS GraphQL API for OpenThrottle plans, tasks, embeddings, and related platform services (Redis, BullMQ, Stripe).",
  "license": "Apache-2.0",
  "main": "./src/main.ts",
  "module": "./src/main.ts",
  "name": "openthrottle-server",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "./",
    "tags": [
      "name:openthrottle-server",
      "production:true",
      "technology:nestjs",
      "type:application"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "^build-package"
        ],
        "description": "Emit the server to ./build with tsc. NOT `nest build`: its SWC builder cannot rewrite `.ts` import specifiers to `.js`, so ESM output would not resolve at runtime (OT plan 31454927 task 2). `--noCheck` keeps this an emit-only step, preserving the separation the old `typeCheck: false` had \u2014 the `typecheck` target is the type gate, and it resolves workspace types through project references that the pruned Docker tree does not carry. The compiler is the same $OPENTHROTTLE_TSC_BIN knob typecheck uses.",
        "executor": "nx:run-commands",
        "options": {
          "command": "${OPENTHROTTLE_TSC_BIN:-tsc} -p tsconfig.app.json --noCheck",
          "cwd": "{projectRoot}"
        }
      },
      "dev": {
        "continuous": true,
        "dependsOn": [
          {
            "target": "ensure-worktree",
            "projects": "monorepo"
          },
          {
            "target": "ensure-migrations",
            "projects": "monorepo"
          },
          "^dev"
        ],
        "description": "Run the server in watch mode (PROCESS_ROLE=all). Replaces `nest start`: the SWC builder it uses cannot rewrite `.ts` import specifiers to `.js`, so ESM output does not resolve at runtime (OT plan 31454927 task 2). tsc emits, `node --watch` reruns.",
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "${OPENTHROTTLE_TSC_BIN:-tsc} -p tsconfig.app.json --watch --preserveWatchOutput",
            "node --watch --enable-source-maps ./build/src/main.js"
          ],
          "cwd": "{projectRoot}",
          "parallel": true,
          "env": {
            "PROCESS_ROLE": "all"
          }
        }
      },
      "dev-api": {
        "continuous": true,
        "dependsOn": [
          {
            "target": "ensure-migrations",
            "projects": "monorepo"
          },
          "^dev"
        ],
        "description": "Run the API role in watch mode. Replaces `nest start`: the SWC builder it uses cannot rewrite `.ts` import specifiers to `.js`, so ESM output does not resolve at runtime (OT plan 31454927 task 2). tsc emits, `node --watch` reruns.",
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "${OPENTHROTTLE_TSC_BIN:-tsc} -p tsconfig.app.json --watch --preserveWatchOutput",
            "node --watch --enable-source-maps ./build/src/main.js"
          ],
          "cwd": "{projectRoot}",
          "parallel": true,
          "env": {
            "PROCESS_ROLE": "api"
          }
        }
      },
      "dev-debug": {
        "continuous": true,
        "dependsOn": [
          "^dev"
        ],
        "description": "Run the server in watch mode with the inspector on 9229. Replaces `nest start`: the SWC builder it uses cannot rewrite `.ts` import specifiers to `.js`, so ESM output does not resolve at runtime (OT plan 31454927 task 2). tsc emits, `node --watch` reruns.",
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "${OPENTHROTTLE_TSC_BIN:-tsc} -p tsconfig.app.json --watch --preserveWatchOutput",
            "node --watch --enable-source-maps --inspect=0.0.0.0:9229 ./build/src/main.js"
          ],
          "cwd": "{projectRoot}",
          "parallel": true
        }
      },
      "docker-build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "docker build -f Dockerfile.NestJS --target production --build-arg APP_NAME=openthrottle-server --build-arg APP_VERSION=$APP_VERSION --build-arg PNPM_VERSION=$PNPM_VERSION --build-arg GITHUB_TOKEN=$GITHUB_TOKEN -t openthrottle-server:local .",
          "cwd": "{workspaceRoot}",
          "env": {
            "APP_VERSION": "1.3.0",
            "PNPM_VERSION": "11.6.0"
          }
        },
        "description": "Build openthrottle-server image from root Dockerfile.NestJS (monorepo context). Set GITHUB_TOKEN in environment for private deps."
      },
      "lint": {
        "options": {
          "command": "pnpm exec eslint -c ./eslint.config.ts .",
          "cwd": "{projectRoot}"
        }
      },
      "start": {
        "continuous": true,
        "description": "Run openthrottle-server (no watch, no debug) after building the server and its dependencies. `build` is listed in dependsOn alongside `^build`: `^build` is only *dependencies'* output, so without it this target would run whatever stale `build/` happened to be on disk. Replaces `nest start`: the SWC builder it uses cannot rewrite `.ts` import specifiers to `.js`, so ESM output does not resolve at runtime (OT plan 31454927 task 2). tsc emits, `node --watch` reruns.",
        "executor": "nx:run-commands",
        "options": {
          "command": "node --enable-source-maps ./build/src/main.js",
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          {
            "target": "ensure-migrations",
            "projects": "monorepo"
          },
          "build",
          "^build"
        ]
      },
      "test": {},
      "typecheck": {},
      "worker": {
        "continuous": true,
        "description": "Run BullMQ processors only (PROCESS_ROLE=worker, no HTTP listener, no watch \u2014 deliberately, so API edits can't restart it). Pair with `dev-api` for the split dev loop. Replaces `nest start`: the SWC builder it uses cannot rewrite `.ts` import specifiers to `.js`, so ESM output does not resolve at runtime (OT plan 31454927 task 2). tsc emits, `node --watch` reruns.",
        "executor": "nx:run-commands",
        "options": {
          "command": "node --enable-source-maps ./build/src/main.js",
          "cwd": "{projectRoot}",
          "env": {
            "PROCESS_ROLE": "worker"
          }
        },
        "dependsOn": [
          {
            "target": "ensure-migrations",
            "projects": "monorepo"
          },
          "build",
          "^build"
        ]
      }
    }
  },
  "private": true,
  "repository": "git://github.com/OpenThrottle/server.git",
  "scripts": {
    "langgraph": "npx @langchain/langgraph-cli dev",
    "start:docker": "node ./build/src/main.js"
  },
  "sideEffects": false,
  "type": "module",
  "version": "1.3.0",
  "devDependencies": {
    "@golevelup/ts-vitest": "catalog:",
    "@nestjs/testing": "catalog:",
    "@openthrottle/nestjs-testing": "workspace:^",
    "@testing-library/jest-dom": "catalog:",
    "nestjs-cls": "catalog:",
    "unplugin-swc": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
