{
  "name": "openthrottle-server",
  "description": "NestJS GraphQL API for OpenThrottle plans, tasks, embeddings, and related platform services (Redis, BullMQ, Stripe).",
  "version": "1.3.0",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://openthrottle.ai"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./src/main.ts",
  "module": "./src/main.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "projectType": "application",
    "sourceRoot": "./",
    "tags": [
      "name:openthrottle-server",
      "production:true",
      "technology:nestjs",
      "type:application"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "nest build --path {projectRoot}/tsconfig.app.json"
        },
        "dependsOn": [
          "^build",
          "^build-package"
        ]
      },
      "docker-build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "docker build -f Dockerfile.NestJS.v3 --target production --build-arg APP_NAME=openthrottle-server --build-arg APP_VERSION=$APP_VERSION --build-arg NX_VERSION=$NX_VERSION --build-arg PNPM_VERSION=$PNPM_VERSION --build-arg GITHUB_TOKEN=$GITHUB_TOKEN --build-arg NX_KEY=$NX_KEY -t openthrottle-server:local .",
          "cwd": "{workspaceRoot}",
          "env": {
            "APP_VERSION": "1.3.0",
            "NX_VERSION": "22.6.4",
            "PNPM_VERSION": "10.33.4"
          }
        },
        "description": "Build openthrottle-server image from root Dockerfile.NestJS.v3 (monorepo context). Set GITHUB_TOKEN and NX_KEY in environment for private deps and Nx cache."
      },
      "dev": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "nest start --path {projectRoot}/tsconfig.app.json --watch"
        },
        "dependsOn": [
          "^dev"
        ]
      },
      "lint": {
        "options": {
          "command": "pnpm exec eslint -c ./eslint.config.mts .",
          "cwd": "{projectRoot}"
        }
      },
      "start": {
        "continuous": true,
        "dependsOn": [
          "^build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "nest start --path {projectRoot}/tsconfig.app.json"
        }
      },
      "test": {},
      "typecheck": {},
      "verify-graphql-schema-sync": {
        "cache": false,
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec tsx ./scripts/verify-graphql-schema-sync.ts",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
  "private": true,
  "repository": "git://github.com/OpenThrottle/server.git",
  "scripts": {
    "langgraph": "npx @langchain/langgraph-cli dev",
    "start:docker": "node -r dotenv/config ./build/src/main.js"
  },
  "sideEffects": false,
  "type": "commonjs",
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@langchain/core": "^1.1.39",
    "@langchain/ollama": "^1.2.0",
    "@langchain/openai": "^1.2.2",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.18",
    "@nestjs/graphql": "^13.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.18",
    "@openthrottle/ai-mcp": "workspace:*",
    "@openthrottle/nestjs-agentic-workflow": "workspace:*",
    "@openthrottle/nestjs-auth": "workspace:*",
    "@openthrottle/nestjs-bullmq": "workspace:*",
    "@openthrottle/nestjs-bullmq-board": "workspace:*",
    "@openthrottle/nestjs-github": "workspace:*",
    "@openthrottle/nestjs-graphql": "workspace:*",
    "@openthrottle/nestjs-logging": "workspace:*",
    "@openthrottle/nestjs-modules": "workspace:*",
    "@openthrottle/nestjs-openthrottle-mcp": "workspace:*",
    "@openthrottle/nestjs-profiling": "workspace:*",
    "@openthrottle/nestjs-rbac": "workspace:*",
    "@openthrottle/nestjs-repositories": "workspace:*",
    "@openthrottle/nestjs-stripe": "workspace:*",
    "@openthrottle/nestjs-utils": "workspace:*",
    "@openthrottle/nestjs-websockets": "workspace:*",
    "@openthrottle/nestjs-worktrees": "workspace:*",
    "@openthrottle/nodejs-graphql": "workspace:*",
    "@openthrottle/openthrottle-agentic-ralph": "workspace:*",
    "@openthrottle/openthrottle-agentic-utils": "workspace:*",
    "@openthrottle/openthrottle-agentic-workflow": "workspace:*",
    "@openthrottle/openthrottle-notifications": "workspace:*",
    "@openthrottle/openthrottle-workflows": "workspace:*",
    "@tools/workflows": "workspace:*",
    "bullmq": "^5.73.0",
    "dataloader": "^2.2.3",
    "dotenv": "^17.2.3",
    "graphql": "^16.13.2",
    "passport-local": "^1.0.0",
    "pg": "^8.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28",
    "zod": "^4.3.6"
  }
}
