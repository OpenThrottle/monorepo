    "@openthrottle/nestjs-rollout": "workspace:^",
    "@openthrottle/nestjs-stripe": "workspace:^",
    "@openthrottle/nestjs-throttler": "workspace:^",
    "@openthrottle/nestjs-utils": "workspace:^",
    "@openthrottle/nestjs-vector-search": "workspace:^",
    "@openthrottle/nestjs-websockets": "workspace:^",
