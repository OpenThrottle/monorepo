    "@openthrottle/openthrottle-agentic-ralph": "workspace:^",
    "@openthrottle/openthrottle-agentic-utils": "workspace:^",
    "@openthrottle/openthrottle-agentic-workflow": "workspace:^",
    "@openthrottle/openthrottle-drivers": "workspace:^",
    "@openthrottle/openthrottle-notifications": "workspace:^",
    "@openthrottle/openthrottle-skills": "workspace:^",
    "@tools/workflows": "workspace:^",
    "bullmq": "catalog:",
    "dataloader": "catalog:",
    "dotenv": "catalog:",
    "graphql": "catalog:",
    "ignore": "catalog:",
    "ioredis": "catalog:",
