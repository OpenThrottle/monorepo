{
  "name": "openthrottle-server",
  "description": "NestJS GraphQL API for OpenThrottle—Cortex plans, tasks, embeddings, and related platform services (Redis, BullMQ, Stripe).",
  "version": "1.3.0",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://openthrottle.ai"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./src/main.ts",
  "module": "./src/main.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "projectType": "application",
    "sourceRoot": "./",
    "tags": [
      "name:openthrottle-server",
      "production:true",
      "technology:nestjs",
      "type:application"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "nest build --path {projectRoot}/tsconfig.app.json"
        },
        "dependsOn": [
          "^build",
          "^build-package"
        ]
      },
      "docker-build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "docker build -f Dockerfile.NestJS.v3 --target production --build-arg APP_NAME=openthrottle-server --build-arg APP_VERSION=$APP_VERSION --build-arg NX_VERSION=$NX_VERSION --build-arg GITHUB_TOKEN=$GITHUB_TOKEN --build-arg NX_KEY=$NX_KEY -t openthrottle-server:local .",
          "cwd": "{workspaceRoot}",
          "env": {
            "APP_VERSION": "1.3.0",
            "NX_VERSION": "22.5.4"
          }
        },
        "description": "Build openthrottle-server image from root Dockerfile.NestJS.v3 (monorepo context). Set GITHUB_TOKEN and NX_KEY in environment for private deps and Nx cache."
      },
      "dev": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "nest start --path {projectRoot}/tsconfig.app.json --watch"
        },
        "dependsOn": [
          "^dev"
        ]
      },
      "lint": {
        "options": {
          "command": "pnpm exec eslint -c ./eslint.config.mts .",
          "cwd": "{projectRoot}"
        }
      },
      "start": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "nest start --path {projectRoot}/tsconfig.app.json"
        }
      },
      "test": {},
      "typecheck": {}
    }
  },
  "private": true,
  "repository": "git://github.com/OpenThrottle/server.git",
  "scripts": {
    "langgraph": "npx @langchain/langgraph-cli dev",
    "start:docker": "node -r dotenv/config ./build/src/main.js"
  },
  "sideEffects": false,
  "type": "commonjs"
}
