# BullMQ Board
BULLMQ_BOARD_ADMIN_PASSWORD="admin"
BULLMQ_BOARD_ADMIN_USERNAME="admin"

# CORS: for frontend on another origin set CORS_ORIGINS (comma-separated); use CORS_CREDENTIALS=true when sending Authorization/cookies. See docs/nestjs/wiring-auth-rbac.md.
# openthrottle-developer default port 6012; 5173 is common Vite fallback; developer.local from allowedHosts.
CORS_ORIGINS="http://localhost:6012,http://localhost:5173,http://developer.local:6012"
CORS_CREDENTIALS="true"

# Optional: GitHub token for listing PRs (list pull requests). Leave unset for public repos only.
GITHUB_TOKEN="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"

NX_KEY=""
NX_VERSION="22.5.4"

# Optional: JWT issuer claim (iss). When set, strategy and login both use it.
# JWT_ISSUER="openthrottle-server"
JWT_SECRET="openthrottle_jwt_secret"
LANGSMITH_TRACING="false"
LOG_FORMAT="compact" # compact | development | pretty | production
NODE_ENV="production"
PNPM_VERSION="10.32.1"
ROLLBAR_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

###############################################################################
# 🏎️💨 OpenThrottle | Developer
###############################################################################
OPENTHROTTLE_DEVELOPER_API_URL_INTERNAL="http://host.docker.internal:6021"
OPENTHROTTLE_DEVELOPER_API_URL_EXTERNAL="http://host.docker.internal:6021"
OPENTHROTTLE_DEVELOPER_APP_NAME="openthrottle-developer"
OPENTHROTTLE_DEVELOPER_APP_ENV="development"
OPENTHROTTLE_DEVELOPER_APP_URL="http://localhost:6020"
OPENTHROTTLE_DEVELOPER_APP_VERSION="latest"
OPENTHROTTLE_DEVELOPER_PORT="6020"

###############################################################################
# 🧠 OpenThrottle | Server
###############################################################################
OPENTHROTTLE_SERVER_APP_NAME="openthrottle-server"
OPENTHROTTLE_SERVER_APP_ENV="development"
OPENTHROTTLE_SERVER_APP_URL="http://localhost:6021"
OPENTHROTTLE_SERVER_APP_VERSION="latest"
OPENTHROTTLE_SERVER_PORT="6021"

###############################################################################
# 🤖 Postgres
###############################################################################
OPENTHROTTLE_POSTGRES_HOST="host.docker.internal"
OPENTHROTTLE_POSTGRES_DB="openthrottle"
OPENTHROTTLE_POSTGRES_PASSWORD="openthrottle_password"
OPENTHROTTLE_POSTGRES_PORT="6010"
OPENTHROTTLE_POSTGRES_USER="openthrottle_user"
OPENTHROTTLE_POSTGRES_VERSION="17"

###############################################################################
# 🤖 Redis
###############################################################################
OPENTHROTTLE_REDIS_HOST="host.docker.internal"
OPENTHROTTLE_REDIS_PORT="6011"
OPENTHROTTLE_REDIS_VERSION="8.6-rc1" # https://hub.docker.com/_/redis
