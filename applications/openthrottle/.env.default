###############################################################################
#
#  🏍️💨 OpenThrottle
#
#   1. Copy the default env `cp .env.default .env`
#   2. Then edit the values marked ✏️ below.
#   3. Run `docker compose up -d`
#
###############################################################################

###############################################################################
# Only the variables this compose file actually uses are here. There is NO
# GITHUB_TOKEN — that is build-time only and consumers run published
# images. Service-to-service traffic uses compose service names; the values you
# edit are the host/browser-facing ports and your local workspace directory.
###############################################################################
NODE_ENV="production"
ROLLBAR_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

APP_ENV="production"
# Image tag for all openthrottle/* images. Pin to a release (e.g. "1.3.0") or
# keep "latest". Upgrade = bump this, then `docker compose pull && up -d`.
APP_VERSION="latest"

###############################################################################
# 🏎️💨 Developer UI (browser)
###############################################################################
OPENTHROTTLE_DEVELOPER_API_URL_INTERNAL="http://server:9021"
OPENTHROTTLE_DEVELOPER_API_URL_EXTERNAL="http://localhost:9021"
OPENTHROTTLE_DEVELOPER_APP_NAME="openthrottle-developer"
OPENTHROTTLE_DEVELOPER_APP_NAME_SHORT="Dev"
OPENTHROTTLE_DEVELOPER_APP_URL="http://localhost:9020"
OPENTHROTTLE_DEVELOPER_APP_URL_ADMIN="http://localhost:9022"
OPENTHROTTLE_DEVELOPER_APP_URL_CMS="http://localhost:9023"
OPENTHROTTLE_DEVELOPER_APP_URL_DEVELOPER="http://localhost:9020"
OPENTHROTTLE_DEVELOPER_APP_URL_EMAIL="http://localhost:9024"
OPENTHROTTLE_DEVELOPER_APP_URL_SERVER="http://localhost:9021"
OPENTHROTTLE_DEVELOPER_APP_URL_WEBSITE="http://localhost:9025"
OPENTHROTTLE_DEVELOPER_PORT="9020"

# ✏️ Secret used to sign sessions/JWTs. CHANGE THIS to a long random string.
OPENTHROTTLE_DEVELOPER_JWT_SECRET="OpenThrottle_2026_default_secret"

###############################################################################
# 🧠 NestJS API (server)
###############################################################################
OPENTHROTTLE_SERVER_APP_NAME="openthrottle-server"
OPENTHROTTLE_SERVER_APP_NAME_SHORT="Server"
OPENTHROTTLE_SERVER_APP_URL="http://localhost:9021"
OPENTHROTTLE_SERVER_CORS_CREDENTIALS="true"
OPENTHROTTLE_SERVER_CORS_ORIGINS="http://localhost:9020"
OPENTHROTTLE_SERVER_PORT="9021"

# ✏️ BullMQ Board (queue dashboard) basic-auth — change for anything exposed.
OPENTHROTTLE_SERVER_BULLMQ_BOARD_ADMIN_PASSWORD="openthrottle_password"
OPENTHROTTLE_SERVER_BULLMQ_BOARD_ADMIN_USERNAME="admin"

# ✏️ Host execution bridge: absolute path to the directory containing your local
# checkouts. Mounted at /workspaces so registered repositories resolve inside the
# containers. Leave as-is to mount a harmless placeholder (browse-only).
OPENTHROTTLE_WORKSPACES_DIR="/tmp/workspaces"

###############################################################################
# 🧠 openthrottle-mcp (streamable-HTTP MCP — Docker-native transport; opt-in)
###############################################################################
# ✏️ Service-account bearer token (ot_sa_<prefix>_<secret>) the mcp container uses
# for machine tools. Provision once with `docker compose run --rm bootstrap`, then
# paste the printed value here. The mcp service refuses to start if this is
# missing/invalid. Clients may additionally send Authorization: Bearer <human JWT>
# for the agent_conversation_* tools.
OPENTHROTTLE_MCP_AUTH_TOKEN=""

# Published port for the `mcp` service. Register in your MCP client as:
#   { "type": "http", "url": "http://localhost:9026/mcp" }
# Opt-in: start it after provisioning with `docker compose --profile mcp up -d mcp`.
OPENTHROTTLE_MCP_PORT="9026"

# Advanced: leave empty so mcp reaches the server over the compose network. Only
# set to target a server outside this compose project (e.g. host.docker.internal).
OPENTHROTTLE_MCP_UPSTREAM_URL=""

###############################################################################
# 🤖 Postgres (published seeded image)
###############################################################################
POSTGRES_PORT="9010"
POSTGRES_VERSION="18"

# ✏️ CHANGE THESE VALUES.
POSTGRES_DB="openthrottle"
POSTGRES_PASSWORD="openthrottle_password"
POSTGRES_USER="openthrottle_user"

###############################################################################
# 🤖 Redis
###############################################################################
REDIS_PORT="9011"
REDIS_VERSION="8.8"
