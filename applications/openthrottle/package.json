{
  "name": "openthrottle",
  "description": "Nx aggregate for the OpenThrottle stack: coordinates dev across server, developer, CMS, admin, email, and website; Docker Compose scripts for local Postgres and Redis.",
  "version": "1.0.0",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://openthrottle.ai"
  },
  "dependencies": {},
  "devDependencies": {},
  "engines": {
    "node": ">=22"
  },
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "sourceRoot": "./",
    "projectType": "application",
    "tags": [
      "name:openthrottle",
      "production:true",
      "type:application"
    ],
    "targets": {
      "dev": {},
      "lint": {},
      "test": {},
      "test-e2e": {},
      "typecheck": {}
    }
  },
  "private": true,
  "repository": "git://github.com/OpenThrottle/openthrottle.git",
  "sideEffects": false,
  "scripts": {
    "docker:start": "docker compose up -d openthrottle-postgres openthrottle-redis",
    "docker:stop": "docker compose down openthrottle-postgres openthrottle-redis"
  },
  "type": "module"
}
