{
  "extends": "../../tsconfig.react-router.json",
  "compilerOptions": {
    // Opts out of the repo-wide `erasableSyntaxOnly` (tsconfig.base.json)
    // because GraphQL Codegen emits `export enum` into `__generated__/graphql.ts`
    // and a compiler flag cannot be scoped to exclude a directory. The durable
    // fix is `enumsAsConst` in the codegen preset — a cross-consumer migration,
    // not a silent flip. This project ships built output, so nothing hands a
    // consumer its raw TypeScript:
    // docs/monorepo/source-first-packages-and-strip-only.md
    "erasableSyntaxOnly": false,
    "paths": {
      "~/*": ["./app/*"],
      "@/*": ["./.react-router/types/*"]
    },
    "rootDirs": ["./", ".react-router/types"]
  },
  "exclude": ["build", "dist", "node_modules"],
  "files": [],
  "include": ["**/*", "**/*.json", ".react-router/types"],
  "references": [
    {
      "path": "../../tools/dotfiles"
    },
    {
      "path": "../../packages/graphql-codegen"
    },
    {
      "path": "../../packages/react-router-chat-state"
    },
    {
      "path": "../../packages/react-router-docs"
    },
    {
      "path": "../../packages/react-router-ui"
    },
    {
      "path": "../../packages/react-router-testing"
    },
    {
      "path": "../../packages/react-router-shadcn"
    },
    {
      "path": "../../packages/react-router-auth"
    },
    {
      "path": "../../packages/react-router-graphql"
    },
    {
      "path": "../../packages/react-router-chat"
    },
    {
      "path": "../../packages/react-router-ui-global"
    },
    {
      "path": "../../packages/react-router-utils"
    }
  ]
}
