{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "#/*": ["*"],
      "@/*": [".react-router/types/*"],
      "~/*": ["app/*"]
    },
    // This app never emits (Vite transpiles; `noEmit: true` from
    // tsconfig.react-router.json). `rewriteRelativeImportExtensions` only
    // affects tsc emit and otherwise raises a spurious project-level TS2878
    // for imports that resolve into referenced source-first packages, so it is
    // disabled here to let `tsc --noEmit` (the `typecheck` target) run clean.
    "rewriteRelativeImportExtensions": false,

    "rootDirs": ["./", ".react-router/types"]
  },
  "exclude": ["build", "dist", "node_modules"],
  "extends": "../../tsconfig.react-router.json",
  "files": [],
  "include": ["**/*", "**/*.json", ".react-router/types"],
  "references": [
    {
      "path": "../../tools/dotfiles"
    },
    {
      "path": "../../packages/graphql-codegen"
    },
    {
      "path": "../../packages/openthrottle-notifications"
    },
    {
      "path": "../../packages/openthrottle-plan-config"
    },
    {
      "path": "../../packages/openthrottle-ide"
    },
    {
      "path": "../../packages/react-router-scheduling"
    },
    {
      "path": "../../packages/openthrottle-agentic-utils"
    },
    {
      "path": "../../packages/openthrottle-skills"
    },
    {
      "path": "../../packages/react-router-editor"
    },
    {
      "path": "../../packages/react-router-markdown"
    },
    {
      "path": "../../packages/react-router-docs"
    },
    {
      "path": "../../packages/openthrottle-drivers"
    },
    {
      "path": "../../packages/react-router-testing"
    },
    {
      "path": "../../packages/react-router-chat-state"
    },
    {
      "path": "../../packages/react-router-auth"
    },
    {
      "path": "../../packages/react-router-chat"
    },
    {
      "path": "../../packages/openthrottle-developer-codegen"
