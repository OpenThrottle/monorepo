API_URL_INTERNAL="http://localhost:6021"
API_URL_EXTERNAL="http://localhost:6021"
APP_ENABLE_ANALYTICS="false"
APP_ENV="development"
APP_NAME="openthrottle-developer"
APP_NAME_SHORT="Dev"
APP_URL="http://localhost:6020"
APP_URL_ADMIN="http://localhost:6022"
APP_URL_CMS="http://localhost:6023"
APP_URL_DEVELOPER="http://localhost:6020"
APP_URL_EMAIL="http://localhost:6024"
APP_URL_SERVER="http://localhost:6021"
APP_URL_WEBSITE="http://localhost:6025"
APP_VERSION="localhost"
NODE_ENV="development"
OPENTHROTTLE_GITHUB_OWNER="visormatt"
OPENTHROTTLE_GITHUB_REPO="monorepo"
PORT="6020"
REACT_ROUTER_DEV_TOOLS="false"
ROLLBAR_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxx"

FEATURE_BETA_PREVIEW="true"
FEATURE_CHARLIE_PREVIEW="true"

# Optional: absolute path to the OpenThrottle monorepo root. Used by the Skills page loader to
# scan `.agents/skills` and `.cursor/skills` (see `getMonorepoRoot` in resolve-monorepo-root.server.ts).
# When unset, the app walks up from process.cwd() for nx.json + pnpm-workspace.yaml (typical local dev).
# Set when cwd is not the repo root, or in Docker when the checkout is mounted at a known path.
# Production/Vercel builds without a checkout show an empty Skills list unless this points at one.
# Same variable name as openthrottle-server and workflow workers.
# WORKSPACE_ROOT="/Users/matt/Development/openthrottle"
