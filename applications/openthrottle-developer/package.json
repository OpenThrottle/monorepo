{
  "name": "openthrottle-developer",
  "description": "OpenThrottle | Developer: dashboard for plans, projects, notes, generators, and pull requests.",
  "version": "1.0.0",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://developer.openthrottle.ai"
  },
  "dependencies": {
    "@openthrottle/openthrottle-developer-codegen": "workspace:*",
    "@openthrottle/openthrottle-ide": "workspace:*",
    "@openthrottle/openthrottle-notifications": "workspace:*",
    "@openthrottle/openthrottle-skills": "workspace:*",
    "@openthrottle/react-router-auth": "workspace:*",
    "@openthrottle/react-router-chat": "workspace:*",
    "@openthrottle/react-router-editor": "workspace:*",
    "@openthrottle/react-router-graphql": "workspace:*",
    "@openthrottle/react-router-ide": "workspace:*",
    "@openthrottle/react-router-markdown": "workspace:*",
    "@openthrottle/react-router-notifications": "workspace:*",
    "@openthrottle/react-router-shadcn": "workspace:*",
    "@openthrottle/react-router-ui": "workspace:*",
    "@openthrottle/react-router-ui-global": "workspace:*",
    "@openthrottle/react-router-utils": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@react-router/node": "^7.14.0",
    "@react-router/serve": "^7.14.0",
    "@tanstack/react-table": "^8.21.3",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "isbot": "^5.1.37",
    "jotai": "^2.19.0",
    "lucide-react": "^1.7.0",
    "react": "19.2.4",
    "react-dnd": "^16.0.1",
    "react-dom": "19.2.4",
    "react-router": "^7.14.0",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7"
  },
  "engines": {
    "node": ">=22"
  },
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "sourceRoot": "./",
    "projectType": "application",
    "tags": [
      "name:openthrottle-developer",
      "production:true",
      "technology:react",
      "technology:react-router",
      "type:application"
    ],
    "targets": {
      "codegen-graphql": {},
      "codegen-graphql-watch": {},
      "codegen-react-router": {},
      "codegen-react-router-watch": {},
      "lint": {},
      "test": {},
      "test-e2e": {
        "configurations": {
          "record": {
            "command": "maestro record --local"
          },
          "studio": {
            "command": "maestro studio"
          },
          "watch": {
            "command": "find flows -name '*.yaml' -type f | sort -u | xargs maestro test --config config.yaml -c"
          }
        },
        "executor": "nx:run-commands",
        "options": {
          "command": "find flows -name '*.yaml' -type f | sort -u | xargs maestro test --config config.yaml",
          "cwd": "{projectRoot}/tests/e2e"
        }
      },
      "typecheck": {}
    }
  },
  "private": true,
  "repository": "git://github.com/OpenThrottle/developer.git",
  "sideEffects": false,
  "scripts": {
    "start:docker": "react-router-serve ./build/server/index.js"
  },
  "type": "module"
}
