{
  "name": "openthrottle-developer",
  "description": "OpenThrottle | Developer: dashboard for plans, projects, notes, generators, and pull requests.",
  "version": "1.0.0",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://developer.openthrottle.ai"
  },
  "dependencies": {
    "@openthrottle/graphql-codegen": "workspace:^",
    "@openthrottle/openthrottle-agentic-utils": "workspace:*",
    "@openthrottle/openthrottle-developer-codegen": "workspace:^",
    "@openthrottle/openthrottle-ide": "workspace:^",
    "@openthrottle/openthrottle-notifications": "workspace:^",
    "@openthrottle/openthrottle-skills": "workspace:^",
    "@openthrottle/react-router-auth": "workspace:^",
    "@openthrottle/react-router-chat": "workspace:^",
    "@openthrottle/react-router-docs": "workspace:^",
    "@openthrottle/react-router-editor": "workspace:^",
    "@openthrottle/react-router-graphql": "workspace:^",
    "@openthrottle/react-router-ide": "workspace:^",
    "@openthrottle/react-router-markdown": "workspace:^",
    "@openthrottle/react-router-notifications": "workspace:^",
    "@openthrottle/react-router-scheduling": "workspace:^",
    "@openthrottle/react-router-shadcn": "workspace:^",
    "@openthrottle/react-router-ui": "workspace:^",
    "@openthrottle/react-router-ui-global": "workspace:^",
    "@openthrottle/react-router-utils": "workspace:^",
    "@phosphor-icons/react": "catalog:",
    "@react-router/express": "catalog:",
    "@react-router/fs-routes": "catalog:",
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@vercel/analytics": "catalog:",
    "clsx": "catalog:",
    "date-fns": "catalog:",
    "dotenv": "catalog:",
    "isbot": "catalog:",
    "jotai": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dnd": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "react-router-dom": "catalog:",
    "recharts": "catalog:",
    "sonner": "catalog:",
    "vite-node": "catalog:"
  },
  "devDependencies": {
    "@openthrottle/react-router-testing": "workspace:^"
  },
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "./",
    "projectType": "application",
    "tags": [
      "name:openthrottle-developer",
      "production:true",
      "technology:react",
      "technology:react-router",
      "type:application"
    ],
    "targets": {
      "codegen-graphql": {},
      "codegen-graphql-watch": {},
      "codegen-react-router": {},
      "codegen-react-router-watch": {},
      "docker-build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "docker build -f Dockerfile.ReactRouter --target production --build-arg APP_NAME=openthrottle-developer --build-arg APP_VERSION=$APP_VERSION --build-arg NX_VERSION=$NX_VERSION --build-arg PNPM_VERSION=$PNPM_VERSION --build-arg GITHUB_TOKEN=$GITHUB_TOKEN --build-arg NX_KEY=$NX_KEY -t openthrottle-developer:local .",
          "cwd": "{workspaceRoot}",
          "env": {
            "APP_VERSION": "1.0.0",
            "NX_VERSION": "22.7.4",
            "PNPM_VERSION": "11.6.0"
          }
        },
        "description": "Build openthrottle-developer image from root Dockerfile.ReactRouter (monorepo context). Set GITHUB_TOKEN and NX_KEY in environment for private deps and Nx cache."
      },
      "lint": {},
      "test": {},
      "test-e2e": {}
    }
  },
  "private": true,
  "repository": "git://github.com/OpenThrottle/developer.git",
  "sideEffects": false,
  "scripts": {
    "start:docker": "react-router-serve ./build/server/index.js"
  },
  "type": "module"
}
