exports[`SettingsKeysServiceAccountCredentials Component > should render 1`] = `
<body>
  <div>
    <fieldset
      aria-labelledby="service-account-credentials"
      class="--bg-card border border-border rounded-md transition-colors space-y-4 p-4 md:p-8"
      data-testid="OpenThrottleFieldset"
    >
      <legend
        class="px-1 mb-0 text-base font-medium text-foreground flex gap-2 items-center"
        id="service-account-credentials"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-lock-keyhole size-4"
          fill="none"
          height="24"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle
            cx="12"
            cy="16"
            r="1"
          />
          <rect
            height="12"
            rx="2"
            width="18"
            x="3"
            y="10"
          />
          <path
            d="M7 10V7a5 5 0 0 1 10 0v3"
          />
        </svg>
        Service account credentials
      </legend>
      <div
        class="space-y-4 text-sm text-muted-foreground"
      >
        <p>
          Long-lived bearer tokens for automation (MCP, Ralph workers, CI). Each credential uses the

          <code
            class="text-xs"
          >
            ot_sa_&lt;prefix&gt;_&lt;secret&gt;
          </code>

          format in the
          <code
            class="text-xs"
          >
            Authorization
          </code>
           header.
        </p>
        <p>
          <span
            class="font-medium text-foreground"
          >
            One-time secret:
          </span>

          when you create a credential, the full token is shown once. Copy it immediately into

          <code
            class="text-xs"
          >
            MCP_DEVELOPER_AUTH_TOKEN
          </code>
           or worker env — it cannot be retrieved again.
        </p>
        <p>
          <span
            class="font-medium text-foreground"
          >
            Rotation:
          </span>
           create a new credential, update your env, then revoke the old one from the table below. Revoked or expired credentials stop working at the next request.
        </p>
        <p>
          Human JWT sessions manage these keys in the developer portal; service account tokens must not call these admin mutations. See

          <a
            class="text-primary underline-offset-4 hover:underline"
            data-testid="SettingsKeysIntroduction-docs-link"
            href="https://github.com/OpenThrottle/monorepo/blob/main/packages/openthrottle-mcp/docs/AUTH.md"
            rel="noreferrer"
            target="_blank"
          >
            MCP and worker authentication (AUTH.md)
          </a>

          for bootstrap and env setup.
        </p>
      </div>
    </fieldset>
  </div>
</body>
`;
