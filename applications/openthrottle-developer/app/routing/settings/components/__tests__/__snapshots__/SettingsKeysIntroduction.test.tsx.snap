// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SettingsKeysIntroduction Component > should render 1`] = `
<body>
  <div>
    <div
      class="flex flex-col gap-6 rounded-xl border bg-card py-6 text-card-foreground shadow-sm"
      data-slot="card"
      data-testid="SettingsKeysIntroduction"
    >
      <div
        class="@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-2 px-6 has-data-[slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-6"
        data-slot="card-header"
      >
        <div
          class="font-semibold text-base"
          data-slot="card-title"
        >
          Service account credentials
        </div>
        <div
          class="text-sm text-muted-foreground"
          data-slot="card-description"
        >
          Long-lived bearer tokens for automation (MCP, Ralph workers, CI). Each credential uses the
           
          <code
            class="text-xs"
          >
            ot_sa_&lt;prefix&gt;_&lt;secret&gt;
          </code>
           
          format in the 
          <code
            class="text-xs"
          >
            Authorization
          </code>
           header.
        </div>
      </div>
      <div
        class="px-6 space-y-3 text-sm text-muted-foreground"
        data-slot="card-content"
      >
        <p>
          <span
            class="font-medium text-foreground"
          >
            One-time secret:
          </span>
           
          when you create a credential, the full token is shown once. Copy it immediately into
           
          <code
            class="text-xs"
          >
            MCP_DEVELOPER_AUTH_TOKEN
          </code>
           or worker env — it cannot be retrieved again.
        </p>
        <p>
          <span
            class="font-medium text-foreground"
          >
            Rotation:
          </span>
           create a new credential, update your env, then revoke the old one from the table below. Revoked or expired credentials stop working at the next request.
        </p>
        <p>
          Human JWT sessions manage these keys in the developer portal; service account tokens must not call these admin mutations. See
           
          <a
            class="text-primary underline-offset-4 hover:underline"
            data-testid="SettingsKeysIntroduction-docs-link"
            href="https://github.com/OpenThrottle/monorepo/blob/main/packages/mcp-developer/docs/AUTH.md"
            rel="noreferrer"
            target="_blank"
          >
            MCP and worker authentication (AUTH.md)
          </a>
           
          for bootstrap and env setup.
        </p>
      </div>
    </div>
  </div>
</body>
`;
