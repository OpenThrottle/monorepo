// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`UsageDailyActivityOverview Component > should render 1`] = `
<body>
  <div>
    <div
      class="bg-transparent p-0 border-none"
    >
      <div
        class="flex gap-2"
      >
        <h2
          class="flex flex-1 items-center gap-4 mb-4"
          data-testid="GlobalHeading"
        >
          What this chart includes
        </h2>
      </div>
      <p
        class="text-muted-foreground text-sm mb-4 md:mb-8"
      >
        Daily counts are aggregated in OpenThrottle for each calendar day over the last 
         days. They reflect Cortex plan and task activity surfaced through the developer portal and automation—not IDE-only runs or model billing.
      </p>
      <dl
        class="grid gap-4 md:gap-8 text-sm md:grid-cols-2 lg:grid-cols-3"
      >
        <div
          class="min-w-0"
        >
          <dt
            class="font-medium text-foreground text-sm mb-2"
          >
            Plans completed
          </dt>
          <dd
            class="text-muted-foreground text-xs"
          >
            Plans moved to a completed (or equivalent terminal) state on that calendar day, as recorded in the OT rollups.
          </dd>
        </div>
        <div
          class="min-w-0"
        >
          <dt
            class="font-medium text-foreground text-sm mb-2"
          >
            Plans created
          </dt>
          <dd
            class="text-muted-foreground text-xs"
          >
            New plan records created in OpenThrottle for that day (Ralph, portal, or API), per daily aggregation.
          </dd>
        </div>
        <div
          class="min-w-0"
        >
          <dt
            class="font-medium text-foreground text-sm mb-2"
          >
            Plans updated
          </dt>
          <dd
            class="text-muted-foreground text-xs"
          >
            Plan records that received an update (status, fields, or content) on that day, per daily aggregation.
          </dd>
        </div>
        <div
          class="min-w-0"
        >
          <dt
            class="font-medium text-foreground text-sm mb-2"
          >
            Tasks completed
          </dt>
          <dd
            class="text-muted-foreground text-xs"
          >
            Tasks marked completed (or equivalent) on that day, per daily aggregation.
          </dd>
        </div>
        <div
          class="min-w-0"
        >
          <dt
            class="font-medium text-foreground text-sm mb-2"
          >
            Tasks created
          </dt>
          <dd
            class="text-muted-foreground text-xs"
          >
            New task rows associated with plans for that day, per daily aggregation.
          </dd>
        </div>
        <div
          class="min-w-0"
        >
          <dt
            class="font-medium text-foreground text-sm mb-2"
          >
            Tasks updated
          </dt>
          <dd
            class="text-muted-foreground text-xs"
          >
            Tasks updated (pending → in progress, blocked, etc.) on that day, per daily aggregation.
          </dd>
        </div>
      </dl>
    </div>
  </div>
</body>
`;
