// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`UsageAnalyticsGaps Component > should render 1`] = `
<body>
  <div>
    <div
      class="mt-8"
    >
      <div
        class="mb-4"
      >
        <div
          class="flex gap-2"
        >
          <h2
            class="flex flex-1 items-center gap-4 mb-4"
            data-testid="GlobalHeading"
          >
            Analytics gaps (by design today)
          </h2>
        </div>
        <p
          class="text-muted-foreground text-sm"
        >
          Use other surfaces when you need finer-grained debugging—the Usage chart is a coarse workload signal only.
        </p>
      </div>
      <div
        class="text-xs text-muted-foreground mt-4 md:mt-8"
      >
        <ul
          class="list-disc space-y-1 pl-5"
        >
          <li>
            No per-prompt, per-skill, or per-command invocation counts.
          </li>
          <li>
            No model token, cost, or latency metrics.
          </li>
          <li>
            No visibility into user-local skills under
             
            <code
              class="text-xs"
            >
              ~/.cursor/skills-cursor
            </code>
             (not in-repo).
          </li>
          <li>
            For prompt identity and version drift, open a prompt and expand
             
            <span
              class="text-foreground"
            >
              Prompt versioning & debug
            </span>
             
            (relative timestamps and content fingerprints), or jump from
             
            <a
              class="text-primary underline"
              data-discover="true"
              href="/prompts"
            >
              Prompts
            </a>
            .
          </li>
          <li>
            Use
             
            <span
              class="text-foreground"
            >
              Copy usage snapshot (JSON)
            </span>
             
            above to attach the same daily rows and totals to a ticket—still no per-prompt metrics, but easier than screenshots.
          </li>
          <li>
            For in-repo skill paths, see
             
            <a
              class="text-primary underline"
              data-discover="true"
              href="/skills"
            >
              Skills
            </a>
             
            (
            <code
              class="text-xs"
            >
              .agents/skills
            </code>
             vs
             
            <code
              class="text-xs"
            >
              .cursor/skills
            </code>
            ).
          </li>
        </ul>
      </div>
    </div>
  </div>
</body>
`;
