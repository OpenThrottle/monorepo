###############################################################################
#
#   - ✏️ = Customizable for a "fresh" installation ~ first time setup ONLY
#   - ♻️ = Grab values from ".bootstrap-secrets.local" ~ after initial setup
#   - 🔐 = Use the subscription(s) you already have ~ totally optional
#
###############################################################################

# ✏️ Initialization values
OPENTHROTTLE_BOOTSTRAP_USER_EMAIL="developer@openthrottle.ai"
OPENTHROTTLE_BOOTSTRAP_USER_GITHUB=
OPENTHROTTLE_BOOTSTRAP_USER_PASSWORD="FullThrottle2026!"

# ♻️ Replace these two tokens
OPENTHROTTLE_MCP_AUTH_TOKEN=
OPENTHROTTLE_WORKER_GRAPHQL_AUTH_TOKEN=

# 🔐 Keys for specific AI providers
AGY_ADC_AUTH=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# 🔐 OpenRouter — one key, hundreds of models behind an OpenAI-compatible gateway.
# Entirely OPTIONAL. Unset, the OpenRouter provider simply cannot serve chat
# turns; nothing throws and nothing is blocked. (The model catalog itself is
# public, so it still loads unauthenticated — you just cannot run a turn.)
# Get a key at https://openrouter.ai/keys. Server-side only: it is never sent to
# a browser, never in the GraphQL schema, and never logged.
OPENROUTER_API_KEY=
# Gateway API root. Only change this to point at a compatible proxy.
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Optional attribution shown on openrouter.ai's rankings. Both are omitted from
# the request entirely when unset.
# OPENROUTER_APP_TITLE="OpenThrottle"
# OPENROUTER_SITE_URL="https://openthrottle.ai"
# Catalog cache tuning (ms). Defaults: 1h soft / 24h hard / 10s request timeout.
# OPENROUTER_CATALOG_CACHE_TTL_MS="3600000"
# OPENROUTER_CATALOG_HARD_TTL_MS="86400000"
# OPENROUTER_CATALOG_TIMEOUT_MS="10000"

# 🔐 Keys for text to voice
ELEVENLABS_API_KEY=
FISH_AUDIO_API_KEY=

# 👤 Customization
OPENTHROTTLE_CHECKOUT_ROOT="~/.openthrottle/repositories" # Where a git clone stores a checkout
OPENTHROTTLE_WORKTREE_ROOT="~/.openthrottle/worktrees" # Root for git worktrees; OT organizes <org>/<repo>/<worktree> beneath it

###############################################################################
#
#   👀  Feel free to adjust the values below to suite your needs.  👀
#
###############################################################################


# 🐙 Monorepo Settings
APP_ENV="production"
APP_VERSION="latest"
COMPOSE_BAKE="true"
COMPOSE_PROFILES="prod" # dev | prod
CORS_CREDENTIALS="true"
CORS_ORIGINS="http://localhost:6020,http://localhost:6022,http://localhost:6023,http://localhost:6024"
DEBUG="true"
DOCKER_PLATFORM="linux/amd64"
LANGSMITH_TRACING="false"
LOG_FORMAT="compact" # compact | development | pretty | production
NODE_ENV="production"
NODE_VERSION="24"
NX_SWC="true"
NX_TUI="true"
PNPM_VERSION="11.6.0"
ROLLBAR_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VERCEL="0"

# 🤖 Postgres database
POSTGRES_HOST="host.docker.internal"
POSTGRES_DB="openthrottle" # ✏️ CHANGE THIS ✏️
POSTGRES_PASSWORD="openthrottle_password" # ✏️ CHANGE THIS ✏️
POSTGRES_PORT="6010"
POSTGRES_USER="openthrottle_user" # ✏️ CHANGE THIS ✏️
POSTGRES_VERSION="18"

# 🤖 Redis in-memory database
REDIS_HOST="host.docker.internal"
REDIS_PORT="6011"
REDIS_VERSION="8.8" # https://hub.docker.com/_/redis

# 🗣️ Whisper voice transcription
WHISPER_MODEL="tiny.en"
WHISPER_PORT="6030"
WHISPER_SERVICE_URL="ws://localhost:6030"

# 🏎️💨 OpenThrottle | Developer
OPENTHROTTLE_DEVELOPER_API_URL_EXTERNAL="http://host.docker.internal:6021"
OPENTHROTTLE_DEVELOPER_API_URL_INTERNAL="http://host.docker.internal:6021"
OPENTHROTTLE_DEVELOPER_APP_NAME="openthrottle-developer"
OPENTHROTTLE_DEVELOPER_APP_NAME_SHORT="Dev"
OPENTHROTTLE_DEVELOPER_APP_URL="http://localhost:6020"
OPENTHROTTLE_DEVELOPER_APP_URL_ADMIN="http://localhost:6022"
OPENTHROTTLE_DEVELOPER_APP_URL_CMS="http://localhost:6023"
OPENTHROTTLE_DEVELOPER_APP_URL_DEVELOPER="http://localhost:6020"
OPENTHROTTLE_DEVELOPER_APP_URL_EMAIL="http://localhost:6024"
OPENTHROTTLE_DEVELOPER_APP_URL_SERVER="http://localhost:6021"
OPENTHROTTLE_DEVELOPER_APP_URL_WEBSITE="http://localhost:6025"
OPENTHROTTLE_DEVELOPER_JWT_SECRET="OpenThrottle_2026_default_secret"
OPENTHROTTLE_DEVELOPER_PORT="6020"

# 🧠 OpenThrottle | Server
OPENTHROTTLE_SERVER_APP_NAME="openthrottle-server"
OPENTHROTTLE_SERVER_APP_NAME_SHORT="Server"
OPENTHROTTLE_SERVER_APP_URL="http://localhost:6021"
OPENTHROTTLE_SERVER_CORS_CREDENTIALS="false"
OPENTHROTTLE_SERVER_CORS_ORIGINS="http://localhost:6020,http://localhost:6022,http://localhost:6023,http://localhost:6024,http://localhost:6026"
OPENTHROTTLE_SERVER_PORT="6021"

###############################################################################
# 🐳 OpenThrottle | MCP Server (in Docker)
###############################################################################
# Published port for the Docker-native `mcp` service (streamable-HTTP MCP).
# Clients register { "type": "http", "url": "http://localhost:${OPENTHROTTLE_MCP_PORT}/mcp" }.
# base+6 in the worktree port block (developer=+0 … website=+5, mcp=+6), so it
# never collides with the admin app (6022). Allow-listed in CORS below.
OPENTHROTTLE_MCP_PORT="6026"

# HYBRID fallback: leave empty for the fully-Dockerized default (the mcp
# container reaches the server over the compose network). If you run the server
# on the HOST via Nx (host.docker.internal) rather than in Docker, set this so
# the mcp container targets it, e.g. http://host.docker.internal:6021. Empty →
# compose service name. (Not running the mcp container at all? The host-stdio
# launcher scripts/run-openthrottle-mcp.sh remains the zero-config hybrid path.)
OPENTHROTTLE_MCP_UPSTREAM_URL=""

###############################################################################
# 🐳 OpenThrottle | Organizing the rest...
###############################################################################
# Host execution bridge: directory containing your local checkouts, bind-mounted
# into the server/developer containers at /workspaces so registered repositories
# (WorkspaceLocalRepository) resolve inside Docker. Example: "/Users/you/Development".
# Leave empty to mount a harmless placeholder (/tmp/workspaces).
OPENTHROTTLE_WORKSPACES_DIR=""

# # OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_BASE_URL="https://ollama.local"
# OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
#
# # When Ollama is behind Caddy (or accessed from browsers), set OLLAMA_ORIGINS so CORS allows requests.
# # Local dev: OLLAMA_ORIGINS=* (restart ollama serve after changing). See docs/monorepo/Ollama.md.
# OLLAMA_ORIGINS="*"
#
#
# Precedence: CLI flags → env vars → .workflow-ralph.json → built-in defaults.
# Sample defaults file (copy to .workflow-ralph.json): .workflow-ralph.json.example
# Migration guide: docs/workflows/ralph-config-migration.md
# Schema: tools/workflows/schemas/workflow-ralph.defaults.schema.json
#
# Run tuning (optional; same as pnpm exec workflow-ralph --help):
# WORKFLOW_RALPH_BACKEND="cursor"
# WORKFLOW_RALPH_PROMPT="/agents-ralph"
# WORKFLOW_RALPH_ITERATIONS="10"
# WORKFLOW_RALPH_ITERATION_TIMEOUT="1800"
# WORKFLOW_RALPH_MODEL="auto"
# WORKFLOW_RALPH_PROJECT=""
# WORKFLOW_RALPH_WORKTREE=""
# WORKFLOW_RALPH_WORKTREE_BASE=""
# WORKFLOW_RALPH_SKIP_WORKTREE_SETUP=""
#
# Debug shim (prefer WORKFLOW_RALPH_DEBUG; RALPH_DEBUG is a deprecated alias):
# WORKFLOW_RALPH_DEBUG="1"
# WORKFLOW_RALPH_VERBOSE=""
#
# Transport rollback (canonical: postgres-direct; env alias "postgres" still accepted):
# WORKFLOW_RALPH_TRANSPORT="graphql"
#
# Nested spawn / foreign cwd (also settable under spawn.* in .workflow-ralph.json):
# WORKFLOW_RALPH_OT_ROOT=""
# WORKFLOW_RALPH_SPAWN_HOME=""
# WORKFLOW_RALPH_SPAWN_XDG_CONFIG_HOME=""
#
# Diagnostics (opt-in):
# WORKFLOW_RALPH_OT_DIAGNOSTICS=""
# OPENTHROTTLE_PLANS_SPAWN_DIAGNOSTICS=""
#
# Lifecycle hook child jobs (default true; set false to disable):
# OPENTHROTTLE_LIFECYCLE_HOOKS_CHILD_JOBS=""
