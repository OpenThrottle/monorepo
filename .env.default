###############################################################################
# 🐙 Monorepo Settings
###############################################################################
COMPOSE_BAKE="true"
# Default compose profile: `docker compose up --build` starts the production-shaped
# stack. Override per-invocation for dev mode: `docker compose --profile dev watch`.
COMPOSE_PROFILES="prod"
CORS_CREDENTIALS="true"
CORS_ORIGINS="http://localhost:6020,http://localhost:6022,http://localhost:6023,http://localhost:6024"
DEBUG="true"
DOCKER_PLATFORM="linux/amd64"
GITHUB_TOKEN=""
LANGSMITH_TRACING="false"
LOG_FORMAT="compact" # compact | development | pretty | production
NODE_ENV="development"
NODE_VERSION="24"
# NX_DAEMON=false
NX_KEY=""
NX_SWC="true"
NX_TUI="true"
NX_VERSION="22.7.4"
PNPM_VERSION="11.6.0"
ROLLBAR_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VERCEL="0"

###############################################################################
# 🤖 OpenThrottle | MCP Server
###############################################################################
OPENTHROTTLE_MCP_AUTH_TOKEN=ot_sa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Host execution bridge: directory containing your local checkouts, bind-mounted
# into the server/developer containers at /workspaces so registered repositories
# (WorkspaceLocalRepository) resolve inside Docker. Example: "/Users/you/Development".
# Leave empty to mount a harmless placeholder (/tmp/openthrottle-workspaces).
OPENTHROTTLE_WORKSPACES_DIR=""

APP_ENV="development"
APP_VERSION="latest"

###############################################################################
# 🏎️💨 OpenThrottle | Developer
###############################################################################
OPENTHROTTLE_DEVELOPER_API_URL_EXTERNAL="http://host.docker.internal:6021"
OPENTHROTTLE_DEVELOPER_API_URL_INTERNAL="http://host.docker.internal:6021"
OPENTHROTTLE_DEVELOPER_APP_NAME="openthrottle-developer"
OPENTHROTTLE_DEVELOPER_APP_NAME_SHORT="Dev"
OPENTHROTTLE_DEVELOPER_APP_URL="http://localhost:6020"
OPENTHROTTLE_DEVELOPER_APP_URL_ADMIN="http://localhost:6022"
OPENTHROTTLE_DEVELOPER_APP_URL_CMS="http://localhost:6023"
OPENTHROTTLE_DEVELOPER_APP_URL_DEVELOPER="http://localhost:6020"
OPENTHROTTLE_DEVELOPER_APP_URL_EMAIL="http://localhost:6024"
OPENTHROTTLE_DEVELOPER_APP_URL_SERVER="http://localhost:6021"
OPENTHROTTLE_DEVELOPER_APP_URL_WEBSITE="http://localhost:6025"
OPENTHROTTLE_DEVELOPER_JWT_SECRET="OpenThrottle_2026_default_secret"
OPENTHROTTLE_DEVELOPER_PORT="6020"

###############################################################################
# 🧠 OpenThrottle | NestJS API
###############################################################################
OPENTHROTTLE_SERVER_APP_NAME="openthrottle-server"
OPENTHROTTLE_SERVER_APP_NAME_SHORT="Server"
OPENTHROTTLE_SERVER_APP_URL="http://localhost:6021"
OPENTHROTTLE_SERVER_CORS_CREDENTIALS="false"
OPENTHROTTLE_SERVER_CORS_ORIGINS="http://localhost:6020,http://localhost:6022,http://localhost:6023,http://localhost:6024"
OPENTHROTTLE_SERVER_PORT="6021"

###############################################################################
# 🤖 Postgres
###############################################################################
POSTGRES_HOST="host.docker.internal"
POSTGRES_DB="openthrottle"
POSTGRES_PASSWORD="openthrottle_password"
POSTGRES_PORT="6010"
POSTGRES_USER="openthrottle_user"
POSTGRES_VERSION="18"

###############################################################################
# 🤖 Redis
###############################################################################
REDIS_HOST="host.docker.internal"
REDIS_PORT="6011"
REDIS_VERSION="8.8" # https://hub.docker.com/_/redis

###############################################################################
# 🤖 Ralph / workflow-ralph (optional tuning — secrets stay here, not in JSON file)
###############################################################################
# Precedence: CLI flags → env vars → .workflow-ralph.json → built-in defaults.
# Sample defaults file (copy to .workflow-ralph.json): .workflow-ralph.json.example
# Migration guide: docs/workflows/ralph-config-migration.md
# Schema: tools/workflows/schemas/workflow-ralph.defaults.schema.json
#
# Run tuning (optional; same as pnpm exec workflow-ralph --help):
# WORKFLOW_RALPH_BACKEND="cursor"
# WORKFLOW_RALPH_PROMPT="/agents-ralph"
# WORKFLOW_RALPH_ITERATIONS="10"
# WORKFLOW_RALPH_ITERATION_TIMEOUT="1800"
# WORKFLOW_RALPH_MODEL="auto"
# WORKFLOW_RALPH_PROJECT=""
# WORKFLOW_RALPH_WORKTREE=""
# WORKFLOW_RALPH_WORKTREE_BASE=""
# WORKFLOW_RALPH_SKIP_WORKTREE_SETUP=""
#
# Debug shim (prefer WORKFLOW_RALPH_DEBUG; RALPH_DEBUG is a deprecated alias):
# WORKFLOW_RALPH_DEBUG="1"
# WORKFLOW_RALPH_VERBOSE=""
#
# Transport rollback (canonical: postgres-direct; env alias "postgres" still accepted):
# WORKFLOW_RALPH_TRANSPORT="graphql"
#
# Nested spawn / foreign cwd (also settable under spawn.* in .workflow-ralph.json):
# WORKFLOW_RALPH_OT_ROOT=""
# WORKFLOW_RALPH_SPAWN_HOME=""
# WORKFLOW_RALPH_SPAWN_XDG_CONFIG_HOME=""
#
# Diagnostics (opt-in):
# WORKFLOW_RALPH_OT_DIAGNOSTICS=""
# OPENTHROTTLE_PLANS_SPAWN_DIAGNOSTICS=""
#
# Lifecycle hook child jobs (default true; set false to disable):
# OPENTHROTTLE_LIFECYCLE_HOOKS_CHILD_JOBS=""

###############################################################################
# 🧠 AI - Work in progress
###############################################################################
OPENAI_API_KEY=""

# # OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_BASE_URL="https://ollama.local"
# OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# # When Ollama is behind Caddy (or accessed from browsers), set OLLAMA_ORIGINS so CORS allows requests.
# # Local dev: OLLAMA_ORIGINS=* (restart ollama serve after changing). See docs/monorepo/Ollama.md.
# OLLAMA_ORIGINS="*"
