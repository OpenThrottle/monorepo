{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/format.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "plugins/openthrottle-cursor-guards/hooks/bash-guard.cjs",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "plugins/openthrottle-cursor/hooks/skill-usage-capture.cjs"
      }
    ],
    "preToolUse": [
      {
        "command": "plugins/openthrottle-cursor/hooks/skill-usage-capture.cjs"
      }
    ],
    "sessionEnd": [
      {
        "command": "plugins/openthrottle-cursor/hooks/skill-usage-complete.cjs"
      }
    ],
    "sessionStart": [
      {
        "command": "plugins/openthrottle-cursor/hooks/skill-usage-heartbeat.cjs"
      }
    ]
  }
}
