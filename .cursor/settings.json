{
  "cSpell.words": ["Pressable", "revalidator", "supabase", "Swiper"],
  "cortex.apiBaseUrl": "http://localhost:6021",
  "openthrottle.apiBaseUrl": "http://localhost:6021",
  "editor.codeActionsOnSave": {
    "eslint.experimental.useFlatConfig": "always",
    "source.fixAll.eslint": "explicit"
  },
  "editor.fontFamily": "'DroidSansM Nerd Font', 'Jetbrains mono', 'Inter V', 'Fira Mono for Powerline', 'Courier New', monospaceex",
  "editor.fontSize": 15,
  "editor.formatOnSave": true,
  "eslint.useFlatConfig": true,
  "terminal.integrated.env.osx": {
    "NX_ISOLATE_PLUGINS": "false"
  },
  "terminal.integrated.env.linux": {
    "NX_ISOLATE_PLUGINS": "false"
  },
  "terminal.integrated.env.windows": {
    "NX_ISOLATE_PLUGINS": "false"
  },
  "terminal.integrated.shellArgs.osx": ["-l"],
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#FA5053",
    "titleBar.activeForeground": "#FFF",
    "titleBar.inactiveBackground": "#FA5053EE",
    "titleBar.inactiveForeground": "#FFF"
  }
}
