{
  "mcpServers": {
    "mcp-developer": {
      "description": "OpenThrottle (OT) plans knowledge base (GraphQL). Plans, tasks, notes, commit links, activity, output stream, semantic search, health.",
      "command": "bash",
      "args": ["./scripts/run-mcp-developer.sh"],
      "env": {
        "API_URL": "http://localhost:6021",
        "API_URL_INTERNAL": "http://localhost:6021",
        "MCP_DEVELOPER_AUTH_TOKEN": "ot_sa_<prefix>_<secret>"
      }
    }
  }
}
