{
  "mcpServers": {
    "openthrottle-mcp": {
      "args": ["./scripts/run-openthrottle-mcp.sh"],
      "command": "bash",
      "description": "OpenThrottle (OT) plans knowledge base (Postgres + GraphQL). Plans, tasks, notes, commit links, activity, output stream, semantic search, health.",
      "env": {
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
        "API_URL": "${OPENTHROTTLE_DEVELOPER_API_URL_EXTERNAL}",
        "API_URL_INTERNAL": "${OPENTHROTTLE_DEVELOPER_API_URL_INTERNAL}",
        "OPENTHROTTLE_MCP_AUTH_TOKEN": "${OPENTHROTTLE_MCP_AUTH_TOKEN}"
      }
    }
  }
}
