// https://cursor.com/docs/configuration/worktrees
{
  "cursor.worktreeCleanupIntervalHours": 72,
  "cursor.worktreeMaxCount": 20,
  // Cursor creates the worktree itself, then runs this from cwd=$WORKTREE_PATH.
  // The create action with no name arg + no stdin payload detects it is inside
  // a linked worktree and provisions it in place — the same entrypoint the Claude
  // hook and `pnpm worktree:new` use, so the tools can't drift.
  "setup-worktree": [
    "cwd=$WORKTREE_PATH",
    "sh -c 'd=skills/ot-worktree/scripts; [ -x \"$d/create.sh\" ] || d=.agents/skills/ot-worktree/scripts; exec \"$d/create.sh\" \"$@\"' --"
  ]
}
