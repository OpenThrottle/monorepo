{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github-mcp": {
      "headers": {
        "Authorization": "Bearer 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"
      },
      "enabled": true,
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "nx-mcp": {
      "command": ["npx", "nx", "mcp"],
      "enabled": true,
      "type": "local"
