{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "fetch": {
      "command": ["uvx", "mcp-server-fetch"],
      "enabled": true,
      "type": "local"
    },
    "github": {
      "command": ["bash", "./scripts/run-github-mcp.sh"],
      "enabled": true,
      "type": "local"
    },
    "maestro": {
      "command": ["maestro", "mcp"],
      "enabled": true,
      "type": "local"
    },
    "nx-mcp": {
      "command": ["npx", "nx", "mcp"],
      "enabled": true,
      "type": "local"
    },
    "openthrottle-mcp": {
      "command": ["bash", "./scripts/run-openthrottle-mcp.sh"],
      "enabled": true,
      "environment": {
        "ANTHROPIC_API_KEY": "{env:ANTHROPIC_API_KEY}",
        "API_URL": "{env:OPENTHROTTLE_DEVELOPER_API_URL_EXTERNAL}",
        "API_URL_INTERNAL": "{env:OPENTHROTTLE_DEVELOPER_API_URL_INTERNAL}",
        "OPENTHROTTLE_MCP_AUTH_TOKEN": "{env:OPENTHROTTLE_MCP_AUTH_TOKEN}"
      },
      "type": "local"
    },
    "openthrottle-mcp-docker": {
      "enabled": true,
      "type": "remote",
      "url": "http://localhost:6026/mcp"
    },
    "shadcn": {
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "skill": {
      "*": "allow",
      "experimental-*": "ask",
      "internal-*": "deny",
      "pr-review": "allow"
    }
  }
}
