{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "fetch": {
      "command": ["uvx", "mcp-server-fetch"],
      "enabled": true,
      "type": "local"
    },
    "github": {
      "command": ["bash", "./scripts/run-github-mcp.sh"],
      "enabled": true,
      "type": "local"
    },
    "maestro": {
      "command": ["maestro", "mcp"],
      "enabled": true,
      "type": "local"
    },
    "nx-mcp": {
      "command": ["npx", "nx", "mcp"],
      "enabled": false,
      "type": "local"
    },
    "openthrottle-mcp": {
      "command": ["bash", "./scripts/run-openthrottle-mcp.sh"],
      "enabled": true,
      "type": "local"
    },
    "openthrottle-mcp-docker": {
      "enabled": false,
      "type": "remote",
      "url": "http://localhost:6026/mcp"
    },
    "shadcn": {
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "bash": {
      "gh issue *": "allow",
      "gh pr create *": "allow",
      "gh pr list *": "allow",
      "gh pr ready *": "allow",
      "gh pr view *": "allow",
      "gh repo list *": "allow",
      "gh search issues *": "allow",
      "git branch *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git push --force-with-lease*": "allow",
      "git push -u origin *": "allow",
      "git push origin *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "pnpm nx *": "allow",
      "git push*main*": "deny",
      "git push*--force *": "deny",
      "git push*--force": "deny",
      "git push*-f *": "deny",
      "git push*+*": "deny"
    },
    "skill": {
      "*": "allow",
      "experimental-*": "ask",
      "internal-*": "deny",
      "pr-review": "allow"
    }
  }
}
