{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github-mcp": {
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      },
      "enabled": true,
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "nx-mcp": {
      "command": ["npx", "nx", "mcp"],
      "enabled": true,
      "type": "local"
    },
    "openthrottle-mcp": {
      "args": ["./scripts/run-openthrottle-mcp.sh"],
      "command": "bash",
      "description": "OpenThrottle (OT) plans knowledge base (Postgres + GraphQL). Plans, tasks, notes, commit links, activity, output stream, semantic search, health.",
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}",
        "API_URL": "${env:OPENTHROTTLE_DEVELOPER_API_URL_EXTERNAL}",
        "API_URL_INTERNAL": "${env:OPENTHROTTLE_DEVELOPER_API_URL_INTERNAL}",
        "OPENTHROTTLE_MCP_AUTH_TOKEN": "${env:OPENTHROTTLE_MCP_AUTH_TOKEN}"
      }
    },
    "shadcn-mcp": {
      "args": ["shadcn@latest", "mcp"],
      "command": "npx",
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "skill": {
      "*": "allow",
      "experimental-*": "ask",
      "internal-*": "deny",
      "pr-review": "allow"
    }
  }
}
