# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored, so these
# values stay out of this public repository.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# Or skip the file and export TF_VAR_ssh_allowed_cidrs='["203.0.113.4/32"]'.

# Your administrative IPs, each with a prefix length. Find yours with:
#   curl -4 https://checkip.amazonaws.com
# 0.0.0.0/0 is rejected. If your address changes, update this and re-apply —
# only the firewall rule changes, never the server.
ssh_allowed_cidrs = ["203.0.113.4/32"]
