**/applications/**/vitest.config.ts.timestamp-*.mjs
infra/**/*.tf
gha-creds-*.json
pnpm-lock.yaml

# Code-first GraphQL schema is generated by openthrottle-server and drift-checked
# in CI; Prettier must not reformat it (would cause schema drift).
schema.gql
applications/openthrottle-server/schema.gql

# Legal texts must be preserved verbatim — Prettier would reflow the indented
# Apache-2.0 / EULA wording and corrupt it.
LICENSE-EULA.md
LICENSE.md
**/LICENSE.md
NOTICE

# Generated by scripts/generate-third-party-notices.ts and drift-checked in CI;
# Prettier must not reformat it (would fight the generator and break the guard).
THIRD-PARTY-LICENSES.md

# Every hook bundle here is esbuild output from @openthrottle/agentic-hooks,
# committed and drift-checked byte-for-byte via bundle-hooks-check; Prettier must
# not reformat them (would fight esbuild and break the drift gate). Matched by
# folder rather than by name prefix: a new adapter is generated output the moment
# it is added, and naming it explicitly is a step everyone forgets until the gate
# fails (as it did for plan-run-janitor.cjs).
.claude/hooks/*.cjs
.cursor/hooks/*.cjs

#############################################################################
# Folders
#############################################################################
__generated__/
.nx/
.nx/cache

# Installed agent skills are managed by the skills CLI (skills-lock.json) and
# must stay byte-for-byte 1:1 with their upstream source — never reformat.
# Authored skills are formatted at their real home, skills/ (the .agents
# entries for those are generated symlinks anyway).
.agents/skills/
.nx/workspace-data
.react-router/
.venv/
coverage/
dist/
infra/**/.terraform/

# The Claude plugin payload is generated by @openthrottle/agentic-hooks'
# bundle-hooks target and gated byte-for-byte by bundle-hooks-check. Prettier
# reformatting it would be a second formatter fighting the generator, and every
# reformat would read as drift.
plugins/openthrottle/
tools/generators/src/generators/*/files/**

# Screencast-pipeline capture artifacts (raw frames, manifests, assembled mp4s).
# Generated per run and gitignored; never format or commit them.
applications/*/tests/demo/output/
applications/*/tests/demo/spike/output/
