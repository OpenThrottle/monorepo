{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledMcpjsonServers": [
    "fetch",
    "github",
    "maestro",
    "openthrottle-mcp",
    "shadcn"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "./.claude/hooks/memory-index-guard.cjs",
            "statusMessage": "Memory index budget guard (PostToolUse)",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      },
      {
        "hooks": [
          {
            "command": "./.claude/hooks/plan-auto-close.cjs",
            "statusMessage": "Report plan auto-close (PostToolUse)",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "mcp__.*__update_task"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "./.claude/hooks/skill-usage-capture.cjs",
            "statusMessage": "Skill usage capture (PreToolUse)",
            "type": "command"
          }
        ],
        "matcher": "Skill"
      },
      {
        "hooks": [
          {
            "command": "./.claude/hooks/require-ot-plan-kickoff.cjs",
            "statusMessage": "Require an OT plan for session kickoffs (PreToolUse)",
            "type": "command"
          }
        ],
        "matcher": "mcp__ccd_session__start_session|mcp__ccd_session__hand_off_to_session"
      },
      {
        "hooks": [
          {
            "command": "./.claude/hooks/bash-guard.cjs",
            "statusMessage": "Bash guard (PreToolUse)",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "./.claude/hooks/plan-run-task-guard.cjs",
            "statusMessage": "Plan-run task guard (PreToolUse)",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "./.claude/hooks/skill-usage-complete.cjs",
            "statusMessage": "Skill usage complete (Stop)",
            "type": "command"
          },
          {
            "command": "./.claude/hooks/plan-run-janitor.cjs",
            "statusMessage": "Settle abandoned plan runs (Stop)",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "command": "./.claude/hooks/skill-usage-capture.cjs",
            "statusMessage": "Skill usage capture (UserPromptExpansion)",
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "command": "sh -c 'd=skills/ot-worktree/scripts; [ -x \"$d/create.sh\" ] || d=.agents/skills/ot-worktree/scripts; exec \"$d/create.sh\" \"$@\"' --",
            "statusMessage": "🌳 OT | Creating worktree...",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [],
    "allow": [
      "Bash(gh issue *)",
      "Bash(gh pr create *)",
      "Bash(gh pr list *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr view *)",
      "Bash(gh repo list *)",
      "Bash(gh search issues *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push -u origin:*)",
      "Bash(git push origin:*)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(pnpm nx *)",
      "mcp__openthrottle-mcp__*"
    ],
    "ask": [],
    "deny": [
      "Bash(git push*main*)",
      "Bash(git push*--force *)",
      "Bash(git push*--force)",
      "Bash(git push*-f *)",
      "Bash(git push*+*)"
    ]
  },
  "skillOverrides": {}
}
