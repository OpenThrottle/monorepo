{
  "enabledMcpjsonServers": [],
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "command": "./scripts/setup_worktree.sh",
            "statusMessage": "🌳 Setting up worktree...",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [],
    "allow": [
      "mcp__openthrottle-mcp__*",
      "Bash(gh issue *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(pnpm nx *)"
    ],
    "ask": [],
    "deny": []
  },
  "skillOverrides": {}
}
