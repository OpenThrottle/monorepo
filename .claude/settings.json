{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledMcpjsonServers": [
    "fetch",
    "github",
    "maestro",
    "openthrottle-mcp",
    "shadcn"
  ],
  "enabledPlugins": {
    "openthrottle-guards@openthrottle": false,
    "openthrottle-guards@openthrottle-dev": true,
    "openthrottle-workflow@openthrottle": false,
    "openthrottle-workflow@openthrottle-dev": true,
    "openthrottle@openthrottle": false,
    "openthrottle@openthrottle-dev": true
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "command": "sh -c 'd=skills/ot-worktree/scripts; [ -x \"$d/create.sh\" ] || d=.agents/skills/ot-worktree/scripts; exec \"$d/create.sh\" \"$@\"' --",
            "statusMessage": "🌳 OT | Creating worktree...",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [],
    "allow": [
      "Bash(gh issue *)",
      "Bash(gh pr create *)",
      "Bash(gh pr list *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr view *)",
      "Bash(gh repo list *)",
      "Bash(gh search issues *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(pnpm nx *)",
      "mcp__openthrottle-mcp__*"
    ],
    "ask": [],
    "deny": [
      "Bash(git push*main*)",
      "Bash(git push*--force *)",
      "Bash(git push*--force)",
      "Bash(git push*-f *)",
      "Bash(git push*+*)"
    ]
  },
  "skillOverrides": {}
}
