{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "gcs": {
    "bucket": "openthrottle-staging-nx-cache",
    "localMode": "read-only"
  },
  "generators": {
    "@nx/react": {
      "library": {
        "unitTestRunner": "vitest"
      }
    }
  },
  "namedInputs": {
    "noMarkdown": ["!{projectRoot}/**/*.md"],
    "production": ["default", "!{projectRoot}/jest.config.ts"]
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/react/router-plugin",
      "options": {
        "buildDepsTargetName": "build-deps",
        "buildTargetName": "build",
        "devTargetName": "dev",
        "startTargetName": "start",
        "typecheckTargetName": "__NOT_USED__typecheck",
        "watchDepsTargetName": "watch-deps"
      }
    }
  ],
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": true
    }
  },
  "release": {
    "changelog": {
      "automaticFromRef": true,
      "enabled": true,
      "file": "CHANGELOG.md",
      "projectChangelogs": {
        "createRelease": "github",
        "renderOptions": {
          "authors": true,
          "applyUsernameToAuthors": true,
          "commitReferences": true,
          "versionTitleDate": true
        }
      },
      "workspaceChangelog": false
    },
    "conventionalCommits": {
      "types": {
        "build": true,
        "chore": {
          "semverBump": "patch"
        },
        "ci": true,
        "docs": {
          "semverBump": "patch"
        },
        "feat": true,
        "fix": true,
        "perf": true,
        "refactor": true,
        "revert": true,
        "test": true,
        "style": {
          "semverBump": "patch"
        }
      }
    },
    "git": {
      "commit": true,
      "commitMessage": "chore(monorepo): [skip ci] release {version}"
    },
    "projects": ["tag:publish:true", "!tag:production:false"],
    "projectsRelationship": "independent",
    "version": {
      "conventionalCommits": true,
      "preVersionCommand": "nx run-many -t build-package",
      "fallbackCurrentVersionResolver": "disk",
      "versionActionsOptions": {
        "gitCommit": true,
        "gitCommitMessage": "chore(version): [skip ci] {version}",
        "skipLockFileUpdate": true
      }
    },
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    }
  },
  "sync": {
    "applyChanges": true
  },
  "targetDefaults": {
    "@nx/js:tsc": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["^build", "^codegen-graphql", "^codegen-react-router"],
      "options": {
        "generateExportsField": false,
        "generatePackageJson": false,
        "main": "{projectRoot}/src/index.ts",
        "module": "{projectRoot}/src/index.ts",
        "outputPath": "{projectRoot}/dist",
        "rootDir": "{projectRoot}",
        "tsConfig": "{projectRoot}/tsconfig.lib.json"
      },
      "description": "Shared @nx/js:tsc compile defaults: emit the package to {projectRoot}/dist from src/index.ts using tsconfig.lib.json (after upstream build + codegen)."
    },
    "@nx/vite:build": {
      "executor": "@nx/vite:build",
      "options": {
        "buildLibsFromSource": true,
        "configFile": "{projectRoot}/vite.config.ts",
        "emptyOutDir": true,
        "generatePackageJson": false,
        "outputPath": "{projectRoot}/dist",
        "tsConfig": "{projectRoot}/tsconfig.lib.json"
      },
      "outputs": ["{options.outputPath}"],
      "description": "Shared @nx/vite:build defaults: bundle the library with its vite.config.ts to {projectRoot}/dist (libs built from source, tsconfig.lib.json)."
    },
    "build": {
      "cache": true,
      "executor": "@nx/vite:build",
      "dependsOn": [
        "^build",
        "^codegen-graphql",
        "^codegen-react-router",
        "^typecheck"
      ],
      "inputs": ["noMarkdown", "^noMarkdown"],
      "options": {
        "buildLibsFromSource": true,
        "emptyOutDir": true,
        "outputPath": "{projectRoot}/dist",
        "tsConfig": "{projectRoot}/tsconfig.lib.json"
      },
      "description": "Build the project to {projectRoot}/dist via @nx/vite:build; runs after upstream build, codegen, and typecheck."
    },
    "build-package": {
      "cache": true,
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node --experimental-strip-types ./scripts/pnpm-package.ts {projectRoot}"
      },
      "outputs": ["{projectRoot}/dist/package.json"],
      "description": "Generate the publishable {projectRoot}/dist/package.json via scripts/pnpm-package.ts (runs after build)."
    },
    "codegen": {
      "executor": "nx:run-commands",
      "configurations": {
        "graphql": {
          "command": "graphql-codegen",
          "dependsOn": ["^build"]
        },
        "graphql-watch": {
          "command": "graphql-codegen --watch",
          "continuous": true,
          "dependsOn": ["^build"]
        },
        "react-router": {
          "command": "react-router typegen",
          "dependsOn": ["^build"]
        },
        "react-router-watch": {
          "command": "react-router typegen --watch",
          "continuous": true,
          "dependsOn": ["^build"]
        }
      },
      "options": {
        "cwd": "{projectRoot}"
      },
      "description": "Run code generation for the project (configurations: graphql, graphql-watch, react-router, react-router-watch)."
    },
    "codegen-graphql": {
      "executor": "nx:run-commands",
      "options": {
        "command": "graphql-codegen",
        "cwd": "{projectRoot}"
      },
      "description": "Generate GraphQL types and typed operations for the project with graphql-codegen."
    },
    "codegen-graphql-watch": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "graphql-codegen --watch",
        "cwd": "{projectRoot}"
      },
      "description": "Watch mode for graphql-codegen — regenerate GraphQL types on change."
    },
    "codegen-react-router": {
      "executor": "nx:run-commands",
      "options": {
        "command": "react-router typegen",
        "cwd": "{projectRoot}"
      },
      "description": "Generate React Router route types with `react-router typegen`."
    },
    "codegen-react-router-watch": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "react-router typegen --watch",
        "cwd": "{projectRoot}"
      },
      "description": "Watch mode for `react-router typegen` — regenerate route types on change."
    },
    "dev": {
      "dependsOn": [
        "^dev",
        "^generate",
        "^codegen-graphql-watch",
        "^codegen-react-router-watch",
        "codegen-graphql-watch",
        "codegen-react-router-watch"
      ],
      "description": "Run the project in continuous watch mode, cascading dev and codegen-watch to dependencies."
    },
    "check-agent-assets-ssot": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./scripts/check-agent-assets-ssot.sh",
        "cwd": "{workspaceRoot}"
      },
      "description": "Verify agent-asset mirrors stay single-sourced via scripts/check-agent-assets-ssot.sh."
    },
    "validate-agent-assets-frontmatter": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx ./scripts/validate-agent-assets-frontmatter.ts",
        "cwd": "{workspaceRoot}"
      },
      "description": "Validate frontmatter on agent-asset files via scripts/validate-agent-assets-frontmatter.ts."
    },
    "check-migration-table-comments": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx ./scripts/check-migration-table-comments.ts",
        "cwd": "{workspaceRoot}"
      },
      "description": "Verify every migration table/column carries COMMENT ON metadata via scripts/check-migration-table-comments.ts."
    },
    "format-write": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write \"**/*.{css,html,js,json,jsx,less,md,mdx,sass,scss,ts,tsx,yaml,yml}\"",
        "cwd": "{workspaceRoot}"
      },
      "description": "Format the workspace in place with Prettier (css/html/js/json/md/ts/yaml and more)."
    },
    "format-check": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --check \"**/*.{css,html,js,json,jsx,less,md,mdx,sass,scss,ts,tsx,yaml,yml}\"",
        "cwd": "{workspaceRoot}"
      },
      "description": "Check workspace formatting with Prettier without writing — CI parity for format-write."
    },
    "ingest-agent-assets": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx ./scripts/openthrottle-ingest-agent-assets.ts",
        "cwd": "{workspaceRoot}"
      },
      "description": "Ingest agent assets into the OpenThrottle knowledge base via scripts/openthrottle-ingest-agent-assets.ts."
    },
    "knip___DISABLED_ON_PURPOSE___": {
      "cache": true,
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "knip --config knip.jsonc",
        "cwd": "{workspaceRoot}",
        "env": {
          "APP_NAME": "openthrottle-developer"
        }
      }
    },
    "lint": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["noMarkdown", "^noMarkdown"],
      "options": {
        "command": "pnpm exec eslint -c ./eslint.config.ts .",
        "cwd": "{projectRoot}"
      },
      "description": "Lint the project with ESLint using the workspace eslint.config.ts."
    },
    "nestjs": {
      "executor": "nx:run-commands",
      "configurations": {
        "build": {
          "command": "nest build --path ./tsconfig.app.json",
          "dependsOn": ["^build"]
        },
        "debug": {
          "continuous": true,
          "command": "NEST_DEBUG nest start --debug --path ./tsconfig.app.json --watch",
          "dependsOn": ["^dev"]
        },
        "dev": {
          "continuous": true,
          "command": "nest start --path ./tsconfig.app.json --watch",
          "dependsOn": ["^dev"]
        },
        "repl": {
          "command": "nest start --entryFile ./src/repl.js --path ./tsconfig.app.json --watch"
        },
        "start": {
          "command": "nest start --path ./tsconfig.app.json"
        }
      },
      "options": {
        "cwd": "{projectRoot}"
      },
      "description": "Drive a NestJS app through the Nest CLI (configurations: build, dev, debug, repl, start)."
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["build-package", "^build-package"],
      "options": {
        "packageRoot": "{projectRoot}/dist"
      },
      "description": "Publish the package to the registry via Nx release (@nx/js:release-publish)."
    },
    "test": {
      "cache": true,
      "configurations": {
        "coverage": {
          "ci": true,
          "coverage": true
        }
      },
      "dependsOn": ["^build"],
      "executor": "@nx/vitest:test",
      "inputs": ["default", "^default", "^production"],
      "options": {
        "configFile": "{projectRoot}/vitest.config.ts",
        "passWithNoTests": true,
        "reportsDirectory": "{workspaceRoot}/coverage/{projectRoot}",
        "watch": false
      },
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "description": "Run the project Vitest suite; the `coverage` configuration adds CI coverage reporting."
    },
    "test-e2e": {
      "configurations": {
        "record": {
          "command": "maestro record --local"
        },
        "studio": {
          "command": "maestro studio"
        },
        "watch": {
          "command": "maestro test --config tests/maestro.yml -c"
        }
      },
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "maestro test --config tests/maestro.yml",
        "cwd": "{projectRoot}"
      },
      "description": "Run the project end-to-end suite (configurations: record, studio, watch)."
    },
    "typecheck": {
      "cache": true,
      "dependsOn": [
        "^build",
        "^codegen-graphql",
        "^typecheck",
        "build",
        "codegen-graphql",
        "codegen-react-router"
      ],
      "outputs": [
        "{projectRoot}/dist/**/*.d.ts",
        "{projectRoot}/dist/**/*.d.ts.map",
        "{projectRoot}/tsconfig.tsbuildinfo"
      ],
      "description": "Type-check the project with tsc, emitting declarations to dist; runs after build and codegen."
    },
    "typecheck-tests": {
      "cache": true,
      "dependsOn": [
        "^codegen-graphql",
        "^typecheck",
        "codegen-graphql",
        "codegen-react-router",
        "typecheck"
      ],
      "executor": "nx:run-commands",
      "inputs": ["default", "^default", "{projectRoot}/tsconfig.test.json"],
      "options": {
        "command": "pnpm exec tsc --noEmit -p tsconfig.test.json",
        "cwd": "{projectRoot}"
      },
      "description": "Type-check test files only with `tsc --noEmit -p tsconfig.test.json` — does not execute tests."
    }
  },
  "tui": {
    "autoExit": 3,
    "enabled": true
  },
  "useInferencePlugins": false
}
