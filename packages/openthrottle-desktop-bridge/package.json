{
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {},
  "description": "Typed contract for the window.openthrottleDesktop bridge the Electron shell exposes to the Developer app: interface, IPC channel names, feature-detection guard, deep-link route mapper.",
  "devDependencies": {
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "name": "@openthrottle/openthrottle-desktop-bridge",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/openthrottle-desktop-bridge",
      "production:true",
      "publish:false",
      "technology:nodejs",
      "technology:typescript",
      "type:package"
    ],
    "targets": {
      "__build": {},
      "__build-package": {},
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  },
  "peerDependencies": {},
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "import": "./src/index.js",
        "require": "./src/index.js",
        "types": "./src/index.d.ts"
      },
      "./*": {
        "import": "./*.js",
        "require": "./*.js",
        "types": "./*.d.ts"
      }
    },
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "sideEffects": false,
  "type": "module",
  "types": "./src/index.ts",
  "version": "1.0.0",
  "license": "Apache-2.0"
}
