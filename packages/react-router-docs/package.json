{
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@openthrottle/react-router-markdown": "workspace:^",
    "@openthrottle/react-router-shadcn": "workspace:^",
    "clsx": "catalog:",
    "react-router": "catalog:",
    "yaml": "catalog:"
  },
  "description": "Source-first docs/FAQ rendering layer: turns a per-app Markdown content folder into routes with consistent nav and styling.",
  "devDependencies": {},
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "name": "@openthrottle/react-router-docs",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/react-router-docs",
      "production:true",
      "publish:false",
      "technology:react",
      "technology:react-router",
      "type:package"
    ],
    "targets": {
      "__build": {},
      "__build-package": {},
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "import": "./src/index.js",
        "require": "./src/index.js",
        "types": "./src/index.d.ts"
      },
      "./*": {
        "import": "./*.js",
        "require": "./*.js",
        "types": "./*.d.ts"
      }
    },
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts"
  },
  "version": "1.0.0",
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "sideEffects": false,
  "type": "module",
  "types": "./src/index.ts"
}
