  "dependencies": {},
  "description": "Isomorphic (Node + browser safe) canonical token-usage normalization: folds every agent-CLI backend's heterogeneous usage metadata into one NormalizedTokenUsage shape. Shared by the server persistence path and the chat UI so the SAME normalization runs everywhere.",
  "devDependencies": {},
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "name": "@openthrottle/agentic-token-usage",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/agentic-token-usage",
      "production:true",
      "publish:false",
      "technology:nodejs",
      "type:package"
    ],
    "targets": {
      "build": {},
      "build-package": {},
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  },
  "peerDependencies": {},
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "import": "./src/index.js",
        "require": "./src/index.js",
        "types": "./src/index.d.ts"
      },
      "./*": {
        "import": "./*.js",
        "require": "./*.js",
        "types": "./*.d.ts"
      }
    },
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "type": "module",
  "types": "./src/index.ts",
  "version": "1.0.0"
}
