{
  "name": "@openthrottle/openthrottle-developer-codegen",
  "description": "Workspace-only GraphQL codegen output for the openthrottle-developer app, emitting runtime enum objects (no enumsAsTypes) that the app's own codegen cannot provide; consumed via workspace:^ and regenerated with the codegen-graphql target.",
  "version": "1.0.0",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@openthrottle/graphql-codegen": "workspace:^"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/openthrottle-developer-codegen",
      "production:true",
      "publish:false",
      "technology:react",
      "technology:react-router",
      "type:package"
    ],
    "targets": {
      "__build": {},
      "__build-package": {},
      "codegen-graphql": {},
      "codegen-graphql-watch": {},
      "lint": {},
      "test": {},
      "typecheck": {},
      "verify-graphql-codegen": {
        "cache": false,
        "description": "Regenerate openthrottle-developer-codegen GraphQL types and fail if the committed src/__generated__ output drifts.",
        "executor": "nx:run-commands",
        "options": {
          "command": "(cd packages/openthrottle-developer-codegen && pnpm exec graphql-codegen) && git diff --exit-code -- packages/openthrottle-developer-codegen/src/__generated__",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "import": "./src/index.js",
        "require": "./src/index.js",
        "types": "./src/index.d.ts"
      },
      "./*": {
        "import": "./*.js",
        "require": "./*.js",
        "types": "./*.d.ts"
      }
    },
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "type": "module",
  "types": "./src/index.ts"
}
