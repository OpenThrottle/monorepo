{
  "name": "@openthrottle/openthrottle-developer-codegen",
  "description": "Workspace-only GraphQL codegen output for the openthrottle-developer app, emitting runtime enum objects (no enumsAsTypes) that the app's own codegen cannot provide; consumed via workspace:^ and regenerated with the codegen-graphql target.",
  "version": "1.0.0",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "catalog:",
    "@openthrottle/graphql-codegen": "workspace:^"
  },
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/openthrottle-developer-codegen",
      "production:true",
      "publish:false",
      "technology:react",
      "technology:react-router",
      "type:package"
    ],
    "targets": {
      "__build": {},
      "__build-package": {},
      "codegen-graphql": {
        "inputs": [
          "codegenGraphqlInputs",
          "{workspaceRoot}/applications/openthrottle-developer/app/**/*.graphql",
          "!{workspaceRoot}/applications/openthrottle-developer/app/**/__generated__/**"
        ]
      },
      "codegen-graphql-watch": {},
      "lint": {},
      "test": {},
      "typecheck": {},
      "verify-graphql-codegen": {
        "cache": false,
        "description": "Regenerate openthrottle-developer-codegen GraphQL types and fail if the generated src/__generated__ output drifts from the .graphql documents. Output is gitignored here, so the guard byte-compares against whatever is on disk rather than against git, and reports a vacuous pass when there is no baseline.",
        "executor": "nx:run-commands",
        "options": {
          "command": "tsx ./scripts/verify-graphql-codegen.ts --project=packages/openthrottle-developer-codegen",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "import": "./src/index.js",
        "require": "./src/index.js",
        "types": "./src/index.d.ts"
      },
      "./*": {
        "import": "./*.js",
        "require": "./*.js",
        "types": "./*.d.ts"
      }
    },
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "type": "module",
  "types": "./src/index.ts",
  "devDependencies": {
    "graphql-codegen-typescript-validation-schema": "catalog:",
    "vitest": "catalog:"
  }
}
