{
  "name": "@openthrottle/react-router-cms-core",
  "description": "OpenThrottle CMS foundation: content-model types, Jotai editor-state atoms, fragment-tree utils and drag-to-reorder primitives for the openthrottle-cms app.",
  "version": "1.0.0",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@openthrottle/react-router-shadcn": "workspace:^",
    "@phosphor-icons/react": "catalog:",
    "@types/json-schema": "catalog:",
    "dnd-core": "catalog:",
    "jotai": "catalog:",
    "json-schema": "catalog:",
    "react-dnd": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "react-dnd-html5-backend": "catalog:",
    "vitest": "catalog:"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/react-router-cms-core",
      "production:true",
      "publish:false",
      "technology:react",
      "technology:react-router",
      "type:package"
    ],
    "targets": {
      "__build": {},
      "__build-package": {},
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "import": "./src/index.js",
        "require": "./src/index.js",
        "types": "./src/index.d.ts"
      },
      "./*": {
        "import": "./*.js",
        "require": "./*.js",
        "types": "./*.d.ts"
      }
    },
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "types": "./src/index.ts"
}
