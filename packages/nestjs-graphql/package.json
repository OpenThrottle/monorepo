{
  "name": "@openthrottle/nestjs-graphql",
  "description": "NestJS Apollo GraphQL module (@nestjs/graphql, Apollo Server) with optional cache-control and response-cache plugins.",
  "version": "2.2.25",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@apollo/server": "catalog:",
    "@apollo/server-plugin-response-cache": "catalog:",
    "@nestjs/apollo": "catalog:",
    "@nestjs/graphql": "catalog:",
    "@openthrottle/nestjs-modules": "workspace:^",
    "@openthrottle/nestjs-redis": "workspace:^",
    "@openthrottle/nestjs-utils": "workspace:^",
    "graphql": "catalog:",
    "graphql-subscriptions": "catalog:",
    "graphql-ws": "catalog:",
    "jsonwebtoken": "catalog:"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "catalog:"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/nestjs-graphql",
      "production:true",
      "publish:false",
      "technology:nestjs",
      "type:package"
    ],
    "targets": {
      "build": {
        "executor": "@nx/js:tsc"
      },
      "dev": {
        "continuous": true,
        "executor": "@nx/js:tsc",
        "options": {
          "clean": false,
          "watch": true
        }
      },
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  },
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "type": "commonjs",
  "types": "./src/index.ts"
}
