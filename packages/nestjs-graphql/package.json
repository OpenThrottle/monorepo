{
  "name": "@openthrottle/nestjs-graphql",
  "description": "NestJS Apollo GraphQL module (@nestjs/graphql, Apollo Server) with optional cache-control and response-cache plugins.",
  "version": "2.2.25",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@apollo/server": "^5.2.0",
    "@apollo/server-plugin-response-cache": "^5.0.0",
    "@nestjs/apollo": "^13.2.3",
    "@nestjs/graphql": "^13.2.3",
    "graphql": "^16.13.2",
    "graphql-request": "^7.4.0",
    "graphql-scalars": "^1.25.0"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/nestjs-graphql",
      "production:true",
      "publish:false",
      "technology:nestjs",
      "type:package"
    ],
    "targets": {
      "build": {
        "executor": "@nx/js:tsc"
      },
      "dev": {
        "continuous": true,
        "executor": "@nx/js:tsc",
        "options": {
          "clean": false,
          "watch": true
        }
      },
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  },
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "type": "commonjs",
  "types": "./src/index.ts"
}
