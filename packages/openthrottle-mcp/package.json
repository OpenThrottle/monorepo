{
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "bin": {
    "openthrottle-mcp": "./dist/src/bin.js"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@openthrottle/agentic-evals": "workspace:^",
    "@openthrottle/agentic-hooks": "workspace:^",
    "@openthrottle/graphql-codegen": "workspace:^",
    "@openthrottle/nestjs-modules": "workspace:^",
    "@openthrottle/nodejs-graphql": "workspace:^",
    "@openthrottle/openthrottle-agentic-utils": "workspace:^",
    "@rekog/mcp-nest": "catalog:",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "description": "Model Context Protocol server for OpenThrottle: plans, tasks, and GraphQL-backed tools (no direct database access).",
  "devDependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@nestjs/testing": "catalog:",
    "esbuild": "catalog:",
    "graphql-codegen-typescript-validation-schema": "catalog:",
    "reflect-metadata": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    },
    "./auth": {
      "import": "./dist/src/auth/index.js",
      "require": "./dist/src/auth/index.js",
      "types": "./dist/src/auth/index.d.ts"
    },
    "./nest": {
      "import": "./dist/src/nest/index.js",
      "require": "./dist/src/nest/index.js",
      "types": "./dist/src/nest/index.d.ts"
    },
    "./nest-tool-handlers": {
      "import": "./dist/src/nest-tool-handlers.js",
      "require": "./dist/src/nest-tool-handlers.js",
      "types": "./dist/src/nest-tool-handlers.d.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "license": "Apache-2.0",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "name": "@openthrottle/openthrottle-mcp",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/openthrottle-mcp",
      "production:true",
      "publish:false",
      "technology:nodejs",
      "technology:typescript",
      "type:package"
    ],
    "targets": {
      "__dev": {
        "cache": false,
        "continuous": true,
        "dependsOn": [
          "codegen-graphql-watch"
        ],
        "executor": "@nx/js:tsc",
        "options": {
          "clean": false,
          "watch": true
        }
      },
      "build": {
        "dependsOn": [
          "^build",
          "codegen-graphql"
        ],
        "executor": "@nx/js:tsc"
      },
      "codegen-graphql": {
        "inputs": [
          "codegenGraphqlInputs",
          "{workspaceRoot}/packages/openthrottle-agentic-ralph/src/graphql/ralph/**/*.graphql"
        ]
      },
      "codegen-graphql-watch": {},
      "eval-tool-selection": {
        "cache": false,
        "dependsOn": [
          "^build",
          "codegen-graphql"
        ],
        "executor": "nx:run-commands",
        "metadata": {
          "description": "On-demand MCP tool-selection eval: runs every case in src/evals/tool-selection/data/data.cases.ts against the Claude Messages API (needs ANTHROPIC_API_KEY; spends tokens) and compares with the same-model baseline in src/evals/tool-selection/baselines/. Runs on the @openthrottle/agentic-evals core. Flags after `--`: --driver (api only), --model, --effort, --trials, --case <id|area,...>, --tolerance, --concurrency, --write-baseline. Exits 1 on a regression. Never wired into CI or check:local — only its grader unit tests run there, through `test`."
        },
        "options": {
          "command": "tsx ./packages/openthrottle-mcp/src/evals/tool-selection/cli.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "lint": {},
      "measure-tool-surface": {
        "cache": false,
        "dependsOn": [
          "codegen-graphql"
        ],
        "executor": "nx:run-commands",
        "metadata": {
          "description": "Measure the stdio MCP surface (instructions block + every tools/list entry, in UTF-8 bytes) over an in-memory client, both as an unconfigured client gets it (the default toolset) and in full with each tool's toolset, and write it to tmp/model-facing-text/tool-surface.json for monorepo:check-model-facing-text. Runs from source, so it needs codegen but not a build. Never cached: the tool schemas derive from gitignored __generated__ output that Nx cannot hash."
        },
        "options": {
          "command": "tsx ./packages/openthrottle-mcp/src/model-facing-text/writeToolSurface.ts ./tmp/model-facing-text/tool-surface.json",
          "cwd": "{workspaceRoot}"
        }
      },
      "serve": {
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "executor": "nx:run-commands",
        "metadata": {
          "description": "Run the built openthrottle-mcp server entrypoint (dist/src/bin.js) after build."
        },
        "options": {
          "command": "node ./dist/src/bin.js",
          "cwd": "{projectRoot}"
        }
      },
      "test": {},
      "typecheck": {},
      "verify-graphql-codegen": {
        "cache": false,
        "executor": "nx:run-commands",
        "metadata": {
          "description": "Regenerate openthrottle-mcp GraphQL types and fail if the generated src/__generated__ output drifts from the .graphql documents. Output is gitignored here, so the guard byte-compares against whatever is on disk rather than against git, and reports a vacuous pass when there is no baseline."
        },
        "options": {
          "command": "tsx ./scripts/verify-graphql-codegen.ts --project=packages/openthrottle-mcp",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "sideEffects": [
    "./dist/src/bin-http.js",
    "./dist/src/bin.js",
    "./dist/src/evals/tool-selection/cli.js",
    "./dist/src/model-facing-text/writeToolSurface.js",
    "./src/bin-http.ts",
    "./src/bin.ts",
    "./src/evals/tool-selection/cli.ts",
    "./src/model-facing-text/writeToolSurface.ts"
  ],
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "version": "1.0.0"
}
