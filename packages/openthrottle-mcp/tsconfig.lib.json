{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "outDir": "./dist",
    "rootDirs": ["./src", "./tests"]
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": [
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "dist"
  ],
  "references": [
    {
      "path": "../agentic-hooks/tsconfig.lib.json"
    },
    {
      "path": "../nestjs-modules/tsconfig.lib.json"
    },
    {
      "path": "../nodejs-graphql/tsconfig.lib.json"
    },
    {
      "path": "../../tools/dotfiles/tsconfig.lib.json"
    },
    {
      "path": "../graphql-codegen/tsconfig.lib.json"
    }
  ]
}
