{
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@huggingface/transformers": "catalog:",
    "@openthrottle/nestjs-repositories-server": "workspace:^",
    "@openthrottle/nodejs-utils": "workspace:^",
    "@openthrottle/openthrottle-agentic-utils": "workspace:^",
    "pg": "catalog:",
    "typeorm": "catalog:"
  },
  "description": "Node-only OpenThrottle data client: Postgres vector search, plan/task/note CRUD, and the single embedder (local nomic-embed-text-v1.5 or Ollama).",
  "devDependencies": {
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "name": "@openthrottle/node-client",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/node-client",
      "production:true",
      "publish:false",
      "technology:nodejs",
      "type:package"
    ],
    "targets": {
      "__build": {},
      "__build-package": {},
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  },
  "peerDependencies": {},
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "types": "./src/index.d.ts",
        "import": "./src/index.js",
        "require": "./src/index.js"
      },
      "./*": {
        "types": "./*.d.ts",
        "import": "./*.js",
        "require": "./*.js"
      }
    },
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "sideEffects": false,
  "type": "module",
  "types": "./src/index.ts",
  "version": "1.0.0"
}
