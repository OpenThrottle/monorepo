{
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@openthrottle/nestjs-modules": "workspace:^",
    "typeorm": "catalog:"
  },
  "description": "Postgres building blocks for NestJS + TypeORM: a generic BaseRepository and BaseModel, plus an opt-in @PostgresProfiling decorator that EXPLAINs the SQL a repository method issues.",
  "devDependencies": {
    "@faker-js/faker": "catalog:",
    "@openthrottle/nestjs-testing": "workspace:^",
    "fishery": "catalog:",
    "reflect-metadata": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "license": "Apache-2.0",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "name": "@openthrottle/nestjs-postgres",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/nestjs-postgres",
      "production:true",
      "publish:false",
      "technology:nestjs",
      "type:package"
    ],
    "targets": {
      "build": {
        "executor": "@nx/js:tsc"
      },
      "dev": {
        "cache": false,
        "continuous": true,
        "executor": "@nx/js:tsc",
        "options": {
          "clean": false,
          "watch": true
        }
      },
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  },
  "peerDependencies": {},
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "sideEffects": false,
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "version": "1.0.0"
}
