{
  "name": "@openthrottle/openthrottle-ide",
  "description": "Headless code-intelligence engine for agent-driven IDE experiences: gitignore-aware enumeration, ripgrep text search, ts-morph symbols, incremental sync, and pgvector semantic search over arbitrary workspaces.",
  "version": "1.0.0",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@vscode/ripgrep": "catalog:",
    "chokidar": "catalog:",
    "ignore": "catalog:",
    "ts-morph": "catalog:"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/openthrottle-ide",
      "production:true",
      "publish:false",
      "technology:nodejs",
      "type:package"
    ],
    "targets": {
      "__build": {},
      "__build-package": {},
      "lint": {},
      "test": {},
      "typecheck": {},
      "build": {
        "options": {
          "command": "tsc --build tsconfig.lib.json && (node --experimental-strip-types ../../scripts/verify-dist-complete.ts . || (echo 'verify-dist-complete: incomplete dist — forcing a clean rebuild' && rm -rf dist && tsc --build tsconfig.lib.json && node --experimental-strip-types ../../scripts/verify-dist-complete.ts .))"
        }
      },
      "verify-dist-complete": {
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "description": "Fail if dist/ is missing any compiled source module — guards the poisoned-Nx-cache truncated-dist class (tsc --build no-op against stale output). See plan 935ea415 and the poisoned-gcs-nx-remote-cache runbook.",
        "executor": "nx:run-commands",
        "options": {
          "command": "node --experimental-strip-types scripts/verify-dist-complete.ts packages/openthrottle-ide",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "import": "./src/index.js",
        "require": "./src/index.js",
        "types": "./src/index.d.ts"
      },
      "./*": {
        "import": "./*.js",
        "require": "./*.js",
        "types": "./*.d.ts"
      }
    },
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "type": "module",
  "types": "./src/index.ts"
}
