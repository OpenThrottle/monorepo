{
  "name": "@openthrottle/openthrottle-agentic-ralph",
  "description": "Ralph agentic workflow: codegen GraphQL client for Cortex plans/tasks, injected iteration runner, and GraphQL-only orchestrator (no NestJS or Postgres).",
  "version": "1.0.0",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@openthrottle/nodejs-graphql": "workspace:*",
    "@openthrottle/openthrottle-agentic-workflow": "workspace:*"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/openthrottle-agentic-ralph",
      "production:true",
      "publish:false",
      "technology:nodejs",
      "type:package"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "codegen-graphql"
        ]
      },
      "build-package": {},
      "codegen-graphql": {},
      "__codegen-graphql-watch": {},
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  },
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "import": "./src/index.js",
        "require": "./src/index.js",
        "types": "./src/index.d.ts"
      },
      "./*": {
        "import": "./*.js",
        "require": "./*.js",
        "types": "./*.d.ts"
      }
    },
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/OpenThrottle.git",
  "scripts": {},
  "type": "module",
  "types": "./src/index.ts"
}
