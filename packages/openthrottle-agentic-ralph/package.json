{
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@openthrottle/graphql-codegen": "workspace:^",
    "@openthrottle/nodejs-graphql": "workspace:^",
    "@openthrottle/openthrottle-agentic-utils": "workspace:^",
    "@openthrottle/openthrottle-agentic-workflow": "workspace:^"
  },
  "description": "Ralph agentic workflow: codegen GraphQL client for Cortex plans/tasks, injected iteration runner, and GraphQL-only orchestrator (no NestJS or Postgres).",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "name": "@openthrottle/openthrottle-agentic-ralph",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/openthrottle-agentic-ralph",
      "production:true",
      "publish:false",
      "technology:nodejs",
      "technology:typescript",
      "type:package"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "codegen-graphql"
        ]
      },
      "build-package": {},
      "codegen-graphql": {},
      "lint": {},
      "test": {},
      "typecheck": {},
      "verify-graphql-codegen": {
        "cache": false,
        "description": "Regenerate agentic-ralph GraphQL types and fail if the committed src/__generated__ output drifts.",
        "executor": "nx:run-commands",
        "options": {
          "command": "(cd packages/openthrottle-agentic-ralph && pnpm exec graphql-codegen) && git diff --exit-code -- packages/openthrottle-agentic-ralph/src/__generated__",
          "cwd": "{workspaceRoot}"
        }
      },
      "typecheck-tests": {}
    }
  },
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "import": "./src/index.js",
        "require": "./src/index.js",
        "types": "./src/index.d.ts"
      },
      "./*": {
        "import": "./*.js",
        "require": "./*.js",
        "types": "./*.d.ts"
      }
    },
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "type": "module",
  "types": "./src/index.ts",
  "version": "1.0.0"
}
