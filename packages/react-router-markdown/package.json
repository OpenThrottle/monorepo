{
  "name": "@openthrottle/react-router-markdown",
  "description": "SSR-capable Markdown renderer for OpenThrottle React Router apps — compiles trusted CommonMark + GFM to React components via MDX (literal text, no raw HTML).",
  "version": "1.0.0",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@mdx-js/mdx": "catalog:",
    "@mdx-js/react": "catalog:",
    "remark-gfm": "catalog:"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/react-router-markdown",
      "production:true",
      "publish:false",
      "technology:react",
      "technology:react-router",
      "type:package"
    ],
    "targets": {
      "__build": {},
      "__build-package": {},
      "lint": {},
      "test": {},
      "typecheck": {},
      "typecheck-tests": {}
    }
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "import": "./src/index.js",
        "require": "./src/index.js",
        "types": "./src/index.d.ts"
      },
      "./*": {
        "import": "./*.js",
        "require": "./*.js",
        "types": "./*.d.ts"
      }
    },
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "type": "module",
  "types": "./src/index.ts"
}
