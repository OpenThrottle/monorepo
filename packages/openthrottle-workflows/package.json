{
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@openthrottle/graphql-codegen": "workspace:^",
    "@openthrottle/nodejs-graphql": "workspace:^",
    "@openthrottle/openthrottle-agentic-utils": "workspace:^",
    "@openthrottle/openthrottle-agentic-workflow": "workspace:^"
  },
  "devDependencies": {
    "@openthrottle/openthrottle-agentic-ralph": "workspace:^"
  },
  "description": "GraphQL-first workflow building blocks for OpenThrottle: typed GraphQL client, Ralph flow contract types, and blueprints (no CLI; see tools/workflows for shipped workflow-ralph).",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "name": "@openthrottle/openthrottle-workflows",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/openthrottle-workflows",
      "production:true",
      "publish:false",
      "technology:nodejs",
      "technology:typescript",
      "type:package"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "codegen-graphql"
        ]
      },
      "build-package": {},
      "codegen-graphql": {},
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  },
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "import": "./src/index.js",
        "require": "./src/index.js",
        "types": "./src/index.d.ts"
      },
      "./*": {
        "import": "./*.js",
        "require": "./*.js",
        "types": "./*.d.ts"
      }
    },
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "type": "module",
  "types": "./src/index.ts",
  "version": "1.0.0"
}
