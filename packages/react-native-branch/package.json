{
  "name": "@shiftsmartinc/react-native-branch",
  "description": "Shared Branch.io integration for Expo React Native apps.",
  "version": "0.0.1",
  "files": [
    "app.plugin.js",
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "devDependencies": {
    "@config-plugins/react-native-branch": "^12.0.0",
    "react-native-branch": "^6.9.0"
  },
  "peerDependencies": {
    "@config-plugins/react-native-branch": "^12.0.0",
    "expo": "^55",
    "react-native": ">=0.60",
    "react-native-branch": "^6.9.0"
  },
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@shiftsmartinc/react-native-branch",
      "production:true",
      "publish:false",
      "technology:react-native",
      "type:package"
    ],
    "targets": {
      "build": {
        "executor": "@nx/js:tsc"
      },
      "__dev": {
        "continuous": true,
        "executor": "@nx/js:tsc",
        "options": {
          "clean": false,
          "watch": true
        }
      },
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  },
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "repository": "git://github.com/OpenThrottle/OpenThrottle.git",
  "type": "commonjs",
  "types": "./src/index.ts"
}
