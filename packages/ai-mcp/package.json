{
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "bin": {
    "ai-mcp": "./dist/src/bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@openthrottle/nestjs-repositories": "workspace:^",
    "@openthrottle/openthrottle-agentic-utils": "workspace:^",
    "openai": "catalog:",
    "pidusage": "catalog:",
    "pg": "catalog:",
    "typeorm": "catalog:",
    "zod": "catalog:"
  },
  "description": "Legacy MCP server for OpenThrottle Cortex plans and tasks (direct Postgres and embeddings); prefer @openthrottle/openthrottle-mcp for new use.",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "name": "@openthrottle/ai-mcp",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/ai-mcp",
      "production:true",
      "publish:false",
      "technology:nodejs",
      "technology:typescript",
      "type:package"
    ],
    "targets": {
      "__dev": {
        "continuous": true,
        "executor": "@nx/js:tsc",
        "options": {
          "clean": false,
          "watch": true
        }
      },
      "build": {
        "executor": "@nx/js:tsc"
      },
      "lint": {},
      "serve": {
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "description": "Run the built ai-mcp server entrypoint (dist/src/bin.js) after build.",
        "executor": "nx:run-commands",
        "options": {
          "command": "node ./dist/src/bin.js",
          "cwd": "{projectRoot}"
        }
      },
      "test": {},
      "typecheck": {},
      "typecheck-tests": {}
    }
  },
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "type": "module",
  "types": "./src/index.ts",
  "version": "1.0.0"
}
