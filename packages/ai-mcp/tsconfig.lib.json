{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../openthrottle-agentic-utils/tsconfig.lib.json"
    },
    {
      "path": "../nestjs-repositories/tsconfig.lib.json"
    },
    {
      "path": "../../tools/dotfiles/tsconfig.lib.json"
    }
  ]
}
