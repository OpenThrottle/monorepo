  },
  "peerDependencies": {},
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "repository": "git://github.com/visormatt/monorepo.git",
  "scripts": {},
  "type": "module",
  "types": "./src/index.ts"
