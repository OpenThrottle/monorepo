{
  "name": "@openthrottle/docs-mcp",
  "description": "MCP server for semantic search over monorepo documentation ingested into Cortex Postgres (documentation_embeddings); docs only, not plans or tasks.",
  "version": "1.0.0",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "bin": {
    "docs-mcp": "./dist/src/bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "openai": "^6.16.0",
    "pg": "^8.17.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {},
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    },
    "./cortex-server": {
      "import": "./dist/src/cortex-server.js",
      "require": "./dist/src/cortex-server.js",
      "types": "./dist/src/cortex-server.d.ts"
    },
    "./embedding": {
      "import": "./dist/src/embedding.js",
      "require": "./dist/src/embedding.js",
      "types": "./dist/src/embedding.d.ts"
    },
    "./entities": {
      "import": "./dist/src/entities/index.js",
      "require": "./dist/src/entities/index.js",
      "types": "./dist/src/entities/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/docs-mcp",
      "production:true",
      "publish:false",
      "technology:typescript",
      "type:tool",
      "type:package"
    ],
    "targets": {
      "build": {
        "executor": "@nx/js:tsc"
      },
      "__dev": {
        "continuous": true,
        "executor": "@nx/js:tsc",
        "options": {
          "clean": false,
          "watch": true
        }
      },
      "lint": {},
      "serve": {
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node ./dist/src/bin.js",
          "cwd": "{projectRoot}"
        }
      },
      "test": {},
      "typecheck": {}
    }
  },
  "peerDependencies": {},
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "repository": "git://github.com/visormatt/monorepo.git",
  "scripts": {},
  "type": "module",
  "types": "./src/index.ts"
}