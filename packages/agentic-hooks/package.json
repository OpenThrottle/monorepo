{
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@openthrottle/nodejs-utils": "workspace:^"
  },
  "description": "Tool-neutral skill-usage hook core (scope, privacy, buildUsageEvent, GraphQL/JSONL persistence, outcome/duration correlation, drain) authored in TS. Per-tool adapters are esbuild entrypoints bundled to self-contained committed .cjs under each tool's hook folder (.claude/hooks, .cursor/hooks, ...) — zero runtime node_modules dependency, fail-open. A drift check keeps committed bundles from rotting.",
  "devDependencies": {
    "esbuild": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "main": "./src/index.ts",
  "name": "@openthrottle/agentic-hooks",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/agentic-hooks",
      "production:true",
      "publish:false",
      "technology:nodejs",
      "type:package"
    ],
    "targets": {
      "__build": {},
      "__build-package": {},
      "bundle-hooks": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "description": "esbuild-bundle each per-tool hook adapter into a self-contained committed .cjs under its tool hook folder (.claude/hooks, .cursor/hooks), and generate the distributable Claude Code plugin payload under plugins/openthrottle from the same sources.",
        "executor": "nx:run-commands",
        "inputs": [
          "{projectRoot}/package.json",
          "{projectRoot}/scripts/bundle-hooks.ts",
          "{projectRoot}/src/**/*",
          "^production"
        ],
        "options": {
          "command": "pnpm exec tsx packages/agentic-hooks/scripts/bundle-hooks.ts",
          "cwd": "{workspaceRoot}"
        },
        "outputs": [
          "{workspaceRoot}/.claude/hooks/plan-run-janitor.cjs",
          "{workspaceRoot}/.claude/hooks/skill-usage-capture.cjs",
          "{workspaceRoot}/.claude/hooks/skill-usage-complete.cjs",
          "{workspaceRoot}/.claude/hooks/skill-usage-drain.cjs",
          "{workspaceRoot}/.claude/hooks/skill-usage-outcome.cjs",
          "{workspaceRoot}/.claude/hooks/skill-usage-scope.cjs",
          "{workspaceRoot}/.cursor/hooks/skill-usage-capture.cjs",
          "{workspaceRoot}/plugins/openthrottle/.claude-plugin/plugin.json",
          "{workspaceRoot}/plugins/openthrottle/README.md",
          "{workspaceRoot}/plugins/openthrottle/hooks/hooks.json",
          "{workspaceRoot}/plugins/openthrottle/hooks/skill-usage-capture.cjs",
          "{workspaceRoot}/plugins/openthrottle/hooks/skill-usage-complete.cjs"
        ]
      },
      "bundle-hooks-check": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "description": "Drift gate: regenerate the hook bundles and the plugin payload in-memory and diff against the committed files, failing on drift (codegen-style).",
        "executor": "nx:run-commands",
        "inputs": [
          "^production",
          "{projectRoot}/package.json",
          "{projectRoot}/scripts/bundle-hooks.ts",
          "{projectRoot}/src/**/*",
          "{workspaceRoot}/.claude/hooks/plan-run-janitor.cjs",
          "{workspaceRoot}/.claude/hooks/skill-usage-capture.cjs",
          "{workspaceRoot}/.claude/hooks/skill-usage-complete.cjs",
          "{workspaceRoot}/.claude/hooks/skill-usage-drain.cjs",
          "{workspaceRoot}/.claude/hooks/skill-usage-outcome.cjs",
          "{workspaceRoot}/.claude/hooks/skill-usage-scope.cjs",
          "{workspaceRoot}/.cursor/hooks/skill-usage-capture.cjs",
          "{workspaceRoot}/plugins/openthrottle/.claude-plugin/plugin.json",
          "{workspaceRoot}/plugins/openthrottle/README.md",
          "{workspaceRoot}/plugins/openthrottle/hooks/hooks.json",
          "{workspaceRoot}/plugins/openthrottle/hooks/skill-usage-capture.cjs",
          "{workspaceRoot}/plugins/openthrottle/hooks/skill-usage-complete.cjs"
        ],
        "options": {
          "command": "pnpm exec tsx packages/agentic-hooks/scripts/bundle-hooks.ts --check",
          "cwd": "{workspaceRoot}"
        }
      },
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  },
  "peerDependencies": {},
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "import": "./src/index.js",
        "require": "./src/index.js",
        "types": "./src/index.d.ts"
      },
      "./*": {
        "import": "./*.js",
        "require": "./*.js",
        "types": "./*.d.ts"
      }
    },
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "type": "module",
  "types": "./src/index.ts",
  "version": "1.0.0"
}
