{
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@openthrottle/agentic-token-usage": "workspace:^",
    "@openthrottle/nodejs-utils": "workspace:^",
    "@openthrottle/openthrottle-agentic-utils": "workspace:^"
  },
  "description": "Tool-neutral skill-usage hook core (scope, privacy, buildUsageEvent, GraphQL/JSONL persistence, outcome/duration correlation, drain) authored in TS. Per-tool adapters are esbuild entrypoints bundled into installable plugin payloads under plugins/ (telemetry, workflow, guards) — zero runtime node_modules dependency, fail-open.",
  "devDependencies": {
    "esbuild": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "name": "@openthrottle/agentic-hooks",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/agentic-hooks",
      "production:true",
      "publish:false",
      "technology:nodejs",
      "type:package"
    ],
    "targets": {
      "__build": {},
      "__build-package": {},
      "bundle-hooks": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "executor": "nx:run-commands",
        "inputs": [
          "{projectRoot}/package.json",
          "{projectRoot}/scripts/bundle-hooks.ts",
          "{projectRoot}/src/**/*",
          "^production"
        ],
        "metadata": {
          "description": "esbuild-bundle each per-tool hook adapter into plugins/<payload>/dist/, behind fixed stubs in hooks/ and bin/, and generate each payload's manifests, hook config and README from the same sources."
        },
        "options": {
          "command": "pnpm exec tsx packages/agentic-hooks/scripts/bundle-hooks.ts",
          "cwd": "{workspaceRoot}"
        },
        "outputs": [
          "{workspaceRoot}/.agents/plugins/openthrottle/dist/*.cjs",
          "{workspaceRoot}/.agents/plugins/openthrottle/hooks/*.cjs",
          "{workspaceRoot}/plugins/**/*"
        ]
      },
      "bundle-hooks-check": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "executor": "nx:run-commands",
        "inputs": [
          "^production",
          "{projectRoot}/package.json",
          "{projectRoot}/scripts/bundle-hooks.ts",
          "{projectRoot}/src/**/*",
          "{workspaceRoot}/.agents/plugins/openthrottle/dist/*.cjs",
          "{workspaceRoot}/.agents/plugins/openthrottle/hooks/*.cjs",
          "{workspaceRoot}/plugins/**/*"
        ],
        "metadata": {
          "description": "Drift gate: regenerate the hook bundles and the plugin payload in-memory and diff against the committed files, failing on drift (codegen-style)."
        },
        "options": {
          "command": "pnpm exec tsx packages/agentic-hooks/scripts/bundle-hooks.ts --check",
          "cwd": "{workspaceRoot}"
        }
      },
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  },
  "peerDependencies": {},
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "import": "./src/index.js",
        "require": "./src/index.js",
        "types": "./src/index.d.ts"
      },
      "./*": {
        "import": "./*.js",
        "require": "./*.js",
        "types": "./*.d.ts"
      }
    },
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "sideEffects": [
    "./src/adapters/antigravity/heartbeat.ts",
    "./src/adapters/claude/backfill.ts",
    "./src/adapters/claude/bash-guard.ts",
    "./src/adapters/claude/capture.ts",
    "./src/adapters/claude/complete.ts",
    "./src/adapters/claude/doctor.ts",
    "./src/adapters/claude/drain.ts",
    "./src/adapters/claude/heartbeat.ts",
    "./src/adapters/claude/memory-index-guard.ts",
    "./src/adapters/claude/outcome.ts",
    "./src/adapters/claude/plan-auto-close.ts",
    "./src/adapters/claude/plan-inbox-claim.ts",
    "./src/adapters/claude/plan-run-janitor.ts",
    "./src/adapters/claude/plan-run-task-guard.ts",
    "./src/adapters/claude/require-ot-plan-kickoff.ts",
    "./src/adapters/claude/resegment.ts",
    "./src/adapters/claude/scope.ts",
    "./src/adapters/codex/capture.ts",
    "./src/adapters/codex/complete.ts",
    "./src/adapters/codex/heartbeat.ts",
    "./src/adapters/cursor/bash-guard.ts",
    "./src/adapters/cursor/capture.ts",
    "./src/adapters/cursor/complete.ts",
    "./src/adapters/cursor/heartbeat.ts"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "version": "1.3.0"
}
