{
  "name": "@openthrottle/nestjs-profiling",
  "description": "NestJS profiling utilities for response-time measurement and structured execution metadata (decorators, profileExecution util, optional NDJSON reporter for tuning and debugging).",
  "version": "1.0.0",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@openthrottle/nestjs-modules": "workspace:^"
  },
  "devDependencies": {},
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/nestjs-profiling",
      "production:true",
      "publish:false",
      "technology:nestjs",
      "type:package"
    ],
    "targets": {
      "build": {
        "executor": "@nx/js:tsc"
      },
      "dev": {
        "continuous": true,
        "executor": "@nx/js:tsc",
        "options": {
          "clean": false,
          "watch": true
        }
      },
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  },
  "peerDependencies": {},
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "type": "commonjs",
  "types": "./src/index.ts"
}
