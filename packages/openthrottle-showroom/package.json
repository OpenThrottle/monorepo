{
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@openthrottle/nestjs-modules": "workspace:^",
    "@openthrottle/nestjs-repositories": "workspace:^",
    "@openthrottle/openthrottle-agentic-utils": "workspace:*",
    "@openthrottle/openthrottle-skills": "workspace:^",
    "pg": "catalog:",
    "typeorm": "catalog:"
  },
  "description": "Screencast pipeline for the @OpenThrottleAI '0-60' channel: typed episode scripts, demo flows, Playwright capture, narration, assembly and leak scanning.",
  "devDependencies": {
    "playwright": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "name": "@openthrottle/openthrottle-showroom",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/openthrottle-showroom",
      "production:false",
      "publish:false",
      "technology:nodejs",
      "type:package"
    ],
    "targets": {
      "__build": {},
      "__build-package": {},
      "lint": {},
      "snapshot-refresh": {},
      "test": {},
      "typecheck": {},
      "video-assemble": {},
      "video-narrate": {},
      "video-record": {},
      "video-scan": {},
      "video-seed": {},
      "video-seed-verify": {},
      "video-validate": {}
    }
  },
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "import": "./src/index.js",
        "require": "./src/index.js",
        "types": "./src/index.d.ts"
      },
      "./*": {
        "import": "./*.js",
        "require": "./*.js",
        "types": "./*.d.ts"
      }
    },
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "sideEffects": [
    "./src/assemble/assemble.ts",
    "./src/episodes/05-connect-ot-mcp/surface.ts",
    "./src/narrate/narrate.ts",
    "./src/runner/run.ts",
    "./src/scan/leak-scan.ts",
    "./src/scripts/demo-live-run.ts",
    "./src/scripts/ensure-demo-database.ts",
    "./src/scripts/resolve-demo-url.ts",
    "./src/scripts/seed-demo.ts",
    "./src/scripts/snapshot-export.ts",
    "./src/scripts/verify-demo-data.ts",
    "./src/validate/validate.ts"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "version": "1.0.0"
}
