{
  "name": "@openthrottle/react-router-notifications",
  "description": "React Router providers, hooks, and UI for OpenThrottle in-app notifications: Socket.IO client wiring, store context, bell and list components, and browser permission flows.",
  "version": "1.0.0",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@openthrottle/react-router-shadcn": "workspace:*",
    "@openthrottle/openthrottle-notifications": "workspace:*",
    "@openthrottle/react-router-utils": "workspace:*",
    "classnames": "^2.5.1",
    "lucide-react": "^1.7.0",
    "react-router": "^7.14.0",
    "socket.io-client": "^4.8.3"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/react-router-notifications",
      "production:true",
      "publish:false",
      "technology:react",
      "technology:react-router",
      "type:package"
    ],
    "targets": {
      "__build": {},
      "__build-package": {},
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  },
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "import": "./src/index.js",
        "require": "./src/index.js",
        "types": "./src/index.d.ts"
      },
      "./*": {
        "import": "./*.js",
        "require": "./*.js",
        "types": "./*.d.ts"
      }
    },
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/OpenThrottle.git",
  "scripts": {},
  "type": "module",
  "types": "./src/index.ts",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1"
  }
}
