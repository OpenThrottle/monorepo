{
  "name": "@openthrottle/nestjs-worktrees",
  "description": "NestJS module for git worktree workflows: WorktreeTargetsTracker from WORKTREE_TARGETS, plus runWorktreeWorkflow and runChildJob (argv aligned with @tools/workflows) for queue processors.",
  "version": "1.0.0",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@openthrottle/openthrottle-agentic-utils": "workspace:^",
    "@openthrottle/openthrottle-agentic-workflow": "workspace:^",
    "@openthrottle/openthrottle-mcp": "workspace:^",
    "@tools/workflows": "workspace:^",
    "pg": "catalog:"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/nestjs-worktrees",
      "production:true",
      "publish:false",
      "technology:nestjs",
      "type:package"
    ],
    "targets": {
      "__dev": {
        "continuous": true,
        "executor": "@nx/js:tsc",
        "options": {
          "clean": false,
          "watch": true
        }
      },
      "build": {
        "executor": "@nx/js:tsc"
      },
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  },
  "peerDependencies": {
    "@nestjs/common": "catalog:"
  },
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "type": "commonjs",
  "types": "./src/index.ts"
}
