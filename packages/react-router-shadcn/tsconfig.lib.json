{
  "compilerOptions": {
    "baseUrl": "./",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "resolvePackageJsonImports": true,
    "rootDirs": ["./src", "./tests"]
  },
  "exclude": [
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.stories.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "dist"
  ],
  "extends": "./tsconfig.json",
  "include": ["**/*.json", "src/**/*", "tests/**/*"],
  "references": [
    {
      "path": "../../tools/dotfiles/tsconfig.lib.json"
    }
  ]
}
