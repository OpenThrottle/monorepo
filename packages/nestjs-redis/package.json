{
  "name": "@openthrottle/nestjs-redis",
  "description": "NestJS module with Joi-validated Redis env config (REDIS_HOST, REDIS_PORT) and an injectable NestjsRedisService scaffold.",
  "version": "2.2.25",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@apollo/utils.keyvadapter": "^4.0.1",
    "@apollo/utils.keyvaluecache": "^4.0.0",
    "@keyv/redis": "^4.4.0",
    "joi": "^18.1.2",
    "keyv": "^5.6.0"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/nestjs-redis",
      "production:true",
      "publish:false",
      "technology:nestjs",
      "type:package"
    ],
    "targets": {
      "build": {
        "executor": "@nx/js:tsc"
      },
      "dev": {
        "continuous": true,
        "executor": "@nx/js:tsc",
        "options": {
          "clean": false,
          "watch": true
        }
      },
      "lint": {},
      "test": {},
      "typecheck": {},
      "typecheck-tests": {}
    }
  },
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "type": "commonjs",
  "types": "./src/index.ts"
}
