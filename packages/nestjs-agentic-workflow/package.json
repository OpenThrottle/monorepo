{
  "name": "@openthrottle/nestjs-agentic-workflow",
  "description": "TODO: Add a description",
  "version": "1.0.0",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@openthrottle/nodejs-graphql": "workspace:*",
    "@openthrottle/openthrottle-agentic-workflow": "workspace:*"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./testing": {
      "import": "./dist/src/testing/index.js",
      "require": "./dist/src/testing/index.js",
      "types": "./dist/src/testing/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/nestjs-agentic-workflow",
      "production:true",
      "publish:false",
      "technology:nestjs",
      "type:package"
    ],
    "targets": {
      "__build-package": {
        "executor": "@nx/js:tsc"
      },
      "build": {
        "executor": "@nx/js:tsc"
      },
      "dev": {
        "continuous": true,
        "executor": "@nx/js:tsc",
        "options": {
          "clean": false,
          "watch": true
        }
      },
      "lint": {},
      "test": {},
      "typecheck": {},
      "typecheck-tests": {}
    }
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0"
  },
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "import": "./src/index.js",
        "require": "./src/index.js",
        "types": "./src/index.d.ts"
      },
      "./testing": {
        "import": "./src/testing/index.js",
        "require": "./src/testing/index.js",
        "types": "./src/testing/index.d.ts"
      },
      "./*": {
        "import": "./*.js",
        "require": "./*.js",
        "types": "./*.d.ts"
      }
    },
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "type": "commonjs",
  "types": "./src/index.ts",
  "devDependencies": {
    "@golevelup/ts-vitest": "^4.0.0",
    "@nestjs/testing": "^11.1.18",
    "@openthrottle/nestjs-modules": "workspace:*"
  }
}
