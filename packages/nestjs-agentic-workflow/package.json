{
  "name": "@openthrottle/nestjs-agentic-workflow",
  "description": "NestJS module that registers agentic workflows (Ralph and future side-by-side workflows) into an id-keyed registry, wiring worker GraphQL auth and an executeGraphqlV2 executor for the openthrottle-server orchestrator.",
  "version": "1.0.0",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "catalog:",
    "@openthrottle/nestjs-modules": "workspace:^",
    "@openthrottle/nodejs-graphql": "workspace:^",
    "@openthrottle/openthrottle-agentic-ralph": "workspace:^",
    "@openthrottle/openthrottle-agentic-workflow": "workspace:^"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./testing": {
      "import": "./src/testing/index.ts",
      "require": "./dist/src/testing/index.js",
      "types": "./dist/src/testing/index.d.ts"
    },
    "./*": {
      "import": "./*.ts",
      "require": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@openthrottle/nestjs-agentic-workflow",
      "production:true",
      "publish:false",
      "technology:nestjs",
      "type:package"
    ],
    "targets": {
      "__build-package": {
        "executor": "@nx/js:tsc"
      },
      "build": {
        "executor": "@nx/js:tsc"
      },
      "dev": {
        "continuous": true,
        "executor": "@nx/js:tsc",
        "options": {
          "clean": false,
          "watch": true
        }
      },
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  },
  "peerDependencies": {
    "@nestjs/common": "catalog:"
  },
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "import": "./src/index.js",
        "require": "./src/index.js",
        "types": "./src/index.d.ts"
      },
      "./testing": {
        "import": "./src/testing/index.js",
        "require": "./src/testing/index.js",
        "types": "./src/testing/index.d.ts"
      },
      "./*": {
        "import": "./*.js",
        "require": "./*.js",
        "types": "./*.d.ts"
      }
    },
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./src/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "type": "commonjs",
  "types": "./src/index.ts",
  "devDependencies": {
    "@golevelup/ts-vitest": "catalog:",
    "@nestjs/testing": "catalog:",
    "@openthrottle/nestjs-modules": "workspace:^"
  }
}
