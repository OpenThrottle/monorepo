    },
    {
      "path": "../react-router-chat/tsconfig.lib.json"
    },
    {
      "path": "../openthrottle-developer-codegen/tsconfig.lib.json"
    },
    {
      "path": "../nodejs-utils/tsconfig.lib.json"
