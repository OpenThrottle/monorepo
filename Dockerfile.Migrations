# OpenThrottle database migrations — one-shot runner image for the consumer install.
#
# Tiny image (node + pg + databases/<db>/migrations) that applies pending SQL
# migrations to every registered database (openthrottle, cms) on the compose
# Postgres, creating any that are missing, then exits. Wired into
# the root docker-compose.yml and applications/openthrottle/docker-compose.yml as
# the `migrations` init service (server depends_on it with
# service_completed_successfully).
#
# It runs the same schema_migrations ledger as `pnpm run database:migrate`
# (databases/migration-runner.ts), so each migration is applied exactly once and a
# steady-state redeploy touches no rows. A fresh volume gets every migration; a
# volume migrated by an older, ledgerless image gets a one-time cut-over that
# applies every file once and records it.
#
# The entrypoint is TypeScript run by Node's native type stripping — no build
# step — so NODE_VERSION must be >= 22.18 (or >= 23.6).
#
# Build (from repo root): docker build -f Dockerfile.Migrations -t openthrottle/migrations:local .
# Published as openthrottle/migrations:<tag> alongside server/developer.
###########################################################################
ARG NODE_VERSION="24"
FROM node:${NODE_VERSION}-trixie-slim AS production

WORKDIR /app

ENV NODE_ENV="production"

# Only runtime dep is `pg`; install it standalone so the image carries no
# workspace, no pnpm, and no build toolchain. The package.json only marks the
# runner's .ts files as ES modules, so Node never has to guess.
RUN echo '{ "private": true, "type": "module" }' > package.json \
  && npm install --no-save --omit=dev pg@8

# The runner resolves each database's migrations relative to itself
# (databases/<db>/migrations/, per databases/database-registry.ts). One COPY per
# registered database: copying all of databases/ would also pick up a local
# openthrottle/seed.sql, which .dockerignore re-includes for the postgres image.
COPY ./databases/migrate.ts ./databases/migration-runner.ts ./databases/database-registry.ts ./databases/
COPY ./databases/openthrottle/migrations ./databases/openthrottle/migrations
COPY ./databases/cms/migrations ./databases/cms/migrations

# Non-root.
RUN useradd --system --uid 1001 appuser && chown -R appuser /app
USER appuser

CMD ["node", "databases/migrate.ts"]
