{
  "servers": {
    "fetch": {
      "args": ["mcp-server-fetch"],
      "command": "uvx",
      "type": "stdio"
    },
    "github": {
      "args": ["./scripts/run-github-mcp.sh"],
      "command": "bash",
      "type": "stdio"
    },
    "maestro": {
      "args": ["mcp"],
      "command": "maestro",
      "type": "stdio"
    },
    "openthrottle-mcp": {
      "args": ["./scripts/run-openthrottle-mcp.sh"],
      "command": "bash",
      "type": "stdio"
    },
    "shadcn": {
      "args": ["shadcn@latest", "mcp"],
      "command": "npx",
      "type": "stdio"
    }
  }
}
