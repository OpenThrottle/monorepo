{
  "cSpell.words": [
    "agentic",
    "openthrottle",
    "OpenThrottle",
    "Worktree",
    "worktree"
  ],
  "editor.codeActionsOnSave": {
    "eslint.experimental.useFlatConfig": "always",
    "source.fixAll.eslint": "explicit"
  },
  "editor.fontFamily": "'DroidSansM Nerd Font', 'Jetbrains mono', 'Inter V', 'Fira Mono for Powerline', 'Courier New', monospaceex",
  "editor.fontSize": 15,
  "editor.formatOnSave": true,
  "eslint.useFlatConfig": true,
  "openthrottle.apiBaseUrl": "http://localhost:6021",
  "terminal.integrated.env.osx": {
    "NX_ISOLATE_PLUGINS": "false"
  },
  "terminal.integrated.env.linux": {
    "NX_ISOLATE_PLUGINS": "false"
  },
  "terminal.integrated.env.windows": {
    "NX_ISOLATE_PLUGINS": "false"
  },
  "terminal.integrated.shellArgs.osx": ["-l"],
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "workbench.colorCustomizations": {
    // "tab.activeBackground": "#000000",
    "tab.activeBorderTop": "#ff0000",
    // "tab.activeForeground": "#FFFFFF",
    "titleBar.activeBackground": "#ff0000",
    "titleBar.activeForeground": "#FFFF",
    "titleBar.inactiveBackground": "#ff0000",
    "titleBar.inactiveForeground": "#FFFF"
  },
  "window.zoomLevel": 1,
  "workbench.activityBar.compact": true,
  "workbench.secondarySideBar.showLabels": true,
  "workbench.sideBar.location": "right"
}
