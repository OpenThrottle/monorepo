{
  "openthrottle-deny": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node --experimental-strip-types ../../../scripts/antigravity-deny-hook.ts",
            "timeout": 10
          }
        ],
        "matcher": "run_command"
      }
    ]
  },
  "openthrottle-telemetry": {
    "SessionStart": [
      {
        "command": "node ./hooks/skill-usage-heartbeat.cjs",
        "timeout": 10
      }
    ]
  }
}
