{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "compilerOptions": {
    "builder": "tsc",
    "deleteOutDir": true,
    "tsConfigPath": "applications/openthrottle-server/tsconfig.app.json",
    "typeCheck": false,
    "webpack": false
  },
  "generateOptions": {
    "caseNaming": "camel",
    "flat": false,
    "spec": true,
    "specFileSuffix": "test"
  },
  "language": "ts",
  "projects": {
    "openthrottle-server": {
      "compilerOptions": {
        "tsConfigPath": "applications/openthrottle-server/tsconfig.app.json"
      },
      "root": "applications/openthrottle-server",
      "sourceRoot": "applications/openthrottle-server/src",
      "type": "application"
    }
  },
  "monorepo": true,
  "root": "applications/openthrottle-server"
}
