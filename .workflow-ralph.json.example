{
  "backend": "cursor",
  "prompt": "/agents/ralph",
  "iterations": 10,
  "iterationTimeout": 1800,
  "model": "auto",
  "debug": "omit",
  "transport": "graphql",
  "spawn": {
    "otRoot": "/absolute/path/to/openthrottle"
  },
  "diagnostics": {
    "ot": false,
    "spawn": false
  },
  "lifecycleHooksChildJobs": true
}
