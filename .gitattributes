#############################################################################
# Committed generator output
#
# Everything listed here is written by a generator, committed because something
# has to run it from a bare checkout, and gated in CI so it cannot drift. None
# of it is authored and none of it is reviewable by eye.
#
#   linguist-generated=true  GitHub collapses the file in a PR's "Files changed"
#                            view (still expandable), and drops it from language
#                            stats and code search.
#   -diff                    git itself treats the path as binary: `git diff` and
#                            `git log -p` print "Binary files differ" instead of
#                            the hunks. Display only — storage, staging, merging
#                            and the byte-for-byte drift gates are unaffected.
#
# Match by folder glob, never by file name. `plan-run-janitor.cjs` was added
# without anyone updating .prettierignore's per-file list and the drift gate
# failed; a folder glob covers the next payload the moment it lands. The
# check:local guard fails the build if a file carrying the GENERATED banner is
# not covered here.
#
# Keep patterns in each section alphabetized (case-insensitive), each with its
# own comment.
#############################################################################

# graphql-codegen output; regenerated by codegen-graphql / codegen-react-router
# and drift-checked in CI. Collapsed in review but still diffable — a codegen
# diff occasionally reveals a schema change nobody intended.
**/__generated__/**    linguist-generated=true

# esbuild bundles of packages/agentic-hooks/src/adapters/**, drift-gated
# byte-for-byte by @openthrottle/agentic-hooks:bundle-hooks-check. Review the
# TypeScript source named in each bundle's header banner instead — `git blame`
# on a bundle line names whoever last ran bundle-hooks, not whoever changed the
# behavior. The same bundles also land in plugins/*/hooks/ below.
.claude/hooks/*.cjs    -diff linguist-generated=true
.codex/hooks/*.cjs     -diff linguist-generated=true
.cursor/hooks/*.cjs    -diff linguist-generated=true

# Written by scripts/sync-agent-config.ts from .agents/agent-config.json and
# drift-checked with --check. Explicit paths, not folder globs: .cursor/ and
# .vscode/ also hold hand-authored files, and opencode.json and
# .claude/settings.json are only partly generated, so they stay unmarked.
.agents/plugins/openthrottle/*.json linguist-generated=true
.codex/config.toml     linguist-generated=true
.codex/rules/default.rules linguist-generated=true
.cursor/cli.json       linguist-generated=true
.cursor/mcp.json       linguist-generated=true
.mcp.json              linguist-generated=true
.vscode/mcp.json       linguist-generated=true

# CMS block JSON Schemas + manifest, written by scripts/generate-cms-schemas.ts
# (`<project>:cms-schemas:write`) and drift-checked by `cms-schemas:check` in
# CI. Review the props interface in the package's src/components/ instead.
packages/*/schemas/*.json linguist-generated=true

# The agentic-hooks esbuild bundles again (see .claude/hooks/ above), written
# into each plugin by the same bundle-hooks target.
plugins/*/hooks/*.cjs  -diff linguist-generated=true

# Plugin READMEs are rendered by the same bundle-hooks target that writes the
# payloads beside them (renderPluginReadme). Left diffable — the install
# instructions are prose a reviewer may legitimately want to read.
plugins/*/README.md    linguist-generated=true

# Frozen openthrottle pg_dump (ledger included) written by
# databases/openthrottle/old-schema/freeze.sh and restored by the server image's
# boot check. Collapsed but diffable — on a deliberate re-freeze the diff is the
# schema delta being signed off.
databases/openthrottle/old-schema/*.sql linguist-generated=true

# Generated by scripts/generate-third-party-notices.ts, drift-checked in CI.
THIRD-PARTY-LICENSES.md linguist-generated=true

#############################################################################
# Vendored third-party content
#
#   linguist-vendored=true   Dropped from language stats and code search. Unlike
#                            linguist-generated, the diff is NOT collapsed.
#############################################################################

# Third-party skills installed 1:1 by `npx skills add` (pinned in
# skills-lock.json). OT-owned skills here are untracked symlinks into skills/,
# so only vendored copies match. Not marked generated on purpose: a changed
# third-party prompt or script is supply-chain input a reviewer must see
# expanded.
.agents/skills/**      linguist-vendored=true

#############################################################################
# Deliberately absent
#
# Paths that look like they belong above but must stay unmarked.
#############################################################################

# applications/openthrottle-server/schema.gql — generated too, but the schema
# diff *is* the review: CLAUDE.md requires that fields are deprecated rather
# than removed, and that is only enforceable if a reviewer sees the change. Do
# not "fix" this omission — it is held in place by ATTRIBUTE_EXEMPT_PATHS in
# scripts/check-generated-attributes.ts, which is the guard that fails when a
# banner-headed file is missing from this file.

# pnpm-lock.yaml — GitHub already handles it. Linguist's built-in rules
# (`pnpm_lock?` in lib/linguist/generated.rb) mark it generated, so it
# collapses in "Files changed" without a line here.

# skills-lock.json — its computedHash diff is how a reviewer sees which
# vendored skill changed, so it stays expanded.
