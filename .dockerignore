#############################################################################
# Files
#############################################################################
*.log
*.tsbuildinfo

# Never bake env files into images. Runtime config comes from compose
# `environment`/`env_file` (or the deploy platform); a copied dev .env would
# otherwise leak secrets and override runtime vars (e.g. POSTGRES_URL=localhost),
# breaking the container in compose/production.
.env
.env.*
**/.env
**/.env.*

#############################################################################
# Folders
#############################################################################
# .npmrc

.claude
.cursor
.gemini
.git
.github
.gitignore
.husky
.nx
.pnpm-store
.venv
.vscode
coverage
databases
node_modules
services
tmp

#############################################################################
# Artifacts
#############################################################################
applications/**/build/
applications/**/dist/
applications/**/node_modules/
applications/**/public/build/
packages/**/dist/
packages/**/node_modules/
tools/**/dist/
tools/**/node_modules/


