#############################################################################
# Files
#############################################################################
*.log
*.tsbuildinfo

# Never bake env files into images. Runtime config comes from compose
# `environment`/`env_file` (or the deploy platform); a copied dev .env would
# otherwise leak secrets and override runtime vars (e.g. POSTGRES_URL=localhost),
# breaking the container in compose/production.
.env
.env.*
**/.env
**/.env.*

#############################################################################
# Folders
#############################################################################
# .npmrc

.claude
.cursor
.gemini
.git
.github
.gitignore
.husky
.nx
.pnpm-store
.venv
.vscode
coverage
databases
node_modules
services
tmp

#############################################################################
# Artifacts
#############################################################################
applications/**/build/
applications/**/dist/
applications/**/node_modules/
applications/**/public/build/
packages/**/dist/
packages/**/node_modules/
tools/**/dist/
tools/**/node_modules/


#############################################################################
# Includes
#############################################################################
# Optional local seed dump: if a dev generates databases/seed.sql (e.g. from a
# backup), re-include it so the postgres image bakes it into
# /docker-entrypoint-initdb.d. It is gitignored, so it stays local — the
# public/fresh DB has no seed and is populated by migrate + bootstrap scripts.
!databases/seed.sql
# Migrations runner image (Dockerfile.Migrations) needs these from the context.
!databases/migrations
!databases/migrations/**
!databases/run-migrations.mjs
