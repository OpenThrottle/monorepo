/**
 * This file is used to configure the workspace for VSCode. We track a template
 * version of this file in the repository, and ignore all other "*.code-workspace"
 * files. This allows each user to create as many workspaces as they'd like,
 * and customize them to their heart's content, without polluting the repository.
 *
 * @link https://code.visualstudio.com/docs/editor/workspaces
 */
{
  "folders": [
    // 📁 Top level stuff
    {
      "name": "🐙 Monorepo",
      "path": "./",
    },

    // 📦 All our applications
    {
      "name": "🚀 OpenThrottle",
      "path": "./applications/openthrottle",
    },

    // 📦 All our packages
    {
      "name": "📦 packages",
      "path": "./packages",
    },
  ],
  "settings": {
    "files.exclude": {
      "./": true,

      // 🧑‍💻 All our applications
      "./applications": true,

      // 📦 All our packages
      "./packages": false,
      "./packages/shared-ui": false,

      // 📦 All our tools
      "./tools": true,

      "./monorepo.code-workspace": false,
    },
  },
}
