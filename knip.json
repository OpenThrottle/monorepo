{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "nx": {
    "config": "nx.json"
  },
  "vitest": false,
  "entry": [
    "applications/**/*.{ts,tsx,js,jsx}",
    "packages/**/src/index.{ts,tsx,js,jsx}",
    "packages/**/src/bin.{ts,js}",
    "tools/**/*.{ts,tsx,js,jsx}"
  ],
  "project": [
    "applications/**/*.{ts,tsx,js,jsx}",
    "packages/**/*.{ts,tsx,js,jsx}",
    "tools/**/*.{ts,tsx,js,jsx}",
    "scripts/**/*.{ts,tsx,js,jsx}",
    "!**/codegen.{ts,js}"
  ],
  "ignore": [
    "**/*.test.{ts,tsx,js,jsx}",
    "**/__tests__/**",
    "**/__snapshots__/**",
    "**/dist/**",
    "**/build/**",
    "**/.cache/**",
    "**/node_modules/**",
    "**/.nx/**",
    "**/coverage/**",
    "vitest.workspace.ts",
    "**/*.config.{ts,js}",
    "**/*.workspace.{ts,js}",
    "**/codegen.{ts,js}"
  ],
  "ignoreDependencies": [
    "@types/*",
    "eslint-*",
    "@typescript-eslint/*",
    "prettier",
    "typescript",
    "vitest",
    "@vitest/*",
    "@testing-library/*",
    "@nx/*"
  ]
}
