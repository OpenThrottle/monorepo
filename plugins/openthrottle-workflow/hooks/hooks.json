{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/plan-auto-close.cjs\"",
            "statusMessage": "Report plan auto-close (PostToolUse)",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "mcp__.*__update_task"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/require-ot-plan-kickoff.cjs\"",
            "statusMessage": "Require an OT plan for session kickoffs (PreToolUse)",
            "type": "command"
          }
        ],
        "matcher": "mcp__ccd_session__start_session|mcp__ccd_session__hand_off_to_session"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/plan-run-task-guard.cjs\"",
            "statusMessage": "Plan-run task guard (PreToolUse)",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/plan-inbox-claim.cjs\"",
            "statusMessage": "Plan inbox claim (PreToolUse)",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|Agent|Task"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/plan-run-janitor.cjs\"",
            "statusMessage": "Settle abandoned plan runs (Stop)",
            "type": "command"
          }
        ]
      }
    ]
  }
}
