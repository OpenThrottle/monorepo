{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // Treat in-file-only interface/type exports as used (component Props, public API types).
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true,
  },
  // Public API exports are marked with the JSDoc /** @public */ tag, which knip
  // recognizes natively (excluded from unused-export reports) — no custom "tags"
  // filter needed. See docs/monorepo/Knip.md.
  // React Router typegen: @/* → .react-router/types/* (generated at build; not on disk for report-only Knip).
  "ignoreUnresolved": ["@/app/\\+types/.*", "@/app/routes/\\+types/.*"],
  "entry": [
    // "applications/**/*.{ts,tsx,js,jsx}", // Uncomment this to include all applications
    // NestJS applications
    "applications/**/main.ts",
    // React Router applications
    "applications/**/entry.client.tsx",
    "applications/**/entry.server.tsx",
    "applications/**/root.tsx",
    "applications/**/app/routes/**/*.{ts,tsx}",
    "applications/**/tests/setup.ts",
    "applications/**/app/testing/**/*.{ts,tsx}",
    // Packages
    "packages/**/src/index.{ts,tsx,js,jsx}",
    "packages/**/src/bin.{ts,js}",
    // Storybook: stories are co-located in the package they document and are
    // loaded by the openthrottle-workbench host's `stories` glob, so they are
    // unreachable from src/index.ts. Declared as entries rather than ignored,
    // so package exports a story consumes stay correctly marked as used.
    // Knip's Storybook plugin also infers these from .storybook/main.ts —
    // listing them makes the contract explicit rather than implicit.
    "packages/**/src/**/*.stories.tsx",
    "applications/openthrottle-workbench/.storybook/{main,preview}.{ts,tsx}",
    // Tools
    "tools/**/*.{ts,tsx,js,jsx}",
  ],
  "ignore": [
    // Note: dist/build/coverage/node_modules/.nx/.cache are gitignored, so knip skips
    // them by default (gitignore-aware) — no need to list them here. Only NON-gitignored
    // paths need entries (.expo/.venv are not gitignored).
    "**/__snapshots__/**",
    "**/__tests__/**",
    "**/.expo/**",
    "**/.venv/**",
    "**/*.config.{ts,js,mjs,mts}",
    "**/public/worker.js",
    "**/apollo.config.mjs",
    "**/*.spec.{ts,tsx,js,jsx}",
    "**/*.test.{ts,tsx,js,jsx}",
    "**/*.workspace.{ts,js}",
    // Vitest setup harnesses: referenced by each project's vitest.config.ts, not by the
    // import graph. The vitest plugin is off (see the "vitest" key), so ignore by glob
    // instead of listing each one. Covers tests/setup.ts and *.setup.ts across all workspaces.
    "**/tests/setup.ts",
    "**/vitest.setup.ts",
    "**/codegen.{ts,js}",
    "tools/generators/src/generators/*/files/**",
    // openthrottle-developer: kept for commented JSX / intentional rollback (see @deprecated)
    "applications/openthrottle-developer/app/routing/agents/components/AgentsSectionQuickLinks.tsx",
    "applications/openthrottle-developer/app/routing/dashboard/components/DashboardQueueStats.tsx",
    "applications/openthrottle-developer/app/routing/dashboard/components/DashboardQuickNavigation.tsx",
    "applications/openthrottle-developer/app/routing/home/components/HomeBuiltWith.tsx",
    "applications/openthrottle-developer/app/routing/home/data/technology.ts",
    "applications/openthrottle-developer/app/routing/queues/components/QueuesToolbar.tsx",
    // Shared jump-link data for DashboardQuickNavigation (commented on dashboard; unit tests cover routes)
    "applications/openthrottle-developer/app/routing/navigation/data/workspace-jump-links.ts",
    // Vitest / route test harness (entry globs do not satisfy knip file graph yet)
    "applications/openthrottle-developer/app/testing/route-fixtures.tsx",
    "applications/openthrottle-developer/app/testing/search-route-fixtures.ts",
    // openthrottle-server: Stripe payments / RBAC roles disabled in app.module (intentional rollback; see @deprecated)
    "applications/openthrottle-server/src/graphql/payments/**",
    "applications/openthrottle-server/src/graphql/roles/**",
    "applications/openthrottle-server/src/modules/payments/**",
    // Golden prompts consumed by agents-mcp-router.golden-prompts.test.ts (knip excludes *.test.ts)
    "applications/openthrottle-server/src/graphql/agents/agents-mcp-router.golden-prompts.ts",
    // openthrottle-email: commented layout chrome (intentional rollback; see @deprecated)
    "applications/openthrottle-email/app/global/components/GlobalFooter.tsx",
    "applications/openthrottle-email/app/global/components/GlobalHeader.tsx",
    // @openthrottle/react-router-shadcn: CSS entrypoints (app @import)
    "packages/react-router-shadcn/src/theme.css",
    "packages/react-router-shadcn/src/commander.css",
    // Ambient window.env merge (consumed via TypeScript program, not import graph)
    "packages/react-router-ui-global/src/types/global.d.ts",
    // infra/ is Terraform-only (no TS project graph)
    "infra/**",
  ],
  "ignoreDependencies": [
    // Internal
    "@openthrottle/*",
    "@tools/*",

    // External
    "@nx/*",
    "@testing-library/*",
    "@types/*",
    "@typescript-eslint/*",
    "@vitest/*",
    "eslint-*",
    "prettier",
    "typescript",
    "vitest",
    // vscode-openthrottle: used by nx `project:build` (`pnpm exec vsce package`)
    "@vscode/vsce",
  ],
  "project": [
    "applications/**/*.{ts,tsx,js,jsx}",
    "packages/**/*.{ts,tsx,js,jsx}",
    "scripts/**/*.{ts,tsx,js,jsx}",
    "tools/**/*.{ts,tsx,js,jsx}",
    "!**/build/**",
    "!**/codegen.{ts,js}",
    "!**/coverage/**",
    "!**/dist/**",
    "!**/node_modules/**",
  ],
  "nx": {
    "config": "nx.json",
  },
  // Vitest plugin stays OFF: every vitest.config in this repo is dynamic (a function
  // export using loadEnv, or the createVitestConfig* factory from @tools/dotfiles), so
  // knip can't statically read `setupFiles`. Enabling it fails to resolve setup files
  // (they'd report as unused) AND pulls test-only imports in as "unlisted" deps. Setup
  // files are ignored by glob below instead. (Revisit if configs become static objects.)
  "vitest": false,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/pnpm-package.ts",
        "scripts/parallelize-tasks.ts",
        "scripts/update-openthrottle-plan-status.ts",
        "scripts/update-openthrottle-task-status.ts",
        "scripts/openthrottle-ingest-agent-assets.ts",
        "scripts/openthrottle-ingest-docs.ts",
        "scripts/validate-agent-assets-frontmatter.ts",
        "scripts/check-migration-table-comments.ts",
        "scripts/openthrottle-database-backup.ts",
        "scripts/openthrottle-database-migrations.ts",
        "scripts/openthrottle-database-reset.ts",
        "scripts/nx-validate-confgurations.ts",
        "scripts/nx-validate-projects.ts",
        "scripts/nx-validate-tags.ts",
        "scripts/nx-dependency-graph.ts",
        "scripts/nx-circular-dependencies.ts",
        "scripts/audit-templates-compliance.ts",
        ".agents/skills/monitor-ci/scripts/*.mjs",
        ".cursor/skills/monitor-ci/scripts/*.mjs",
        ".opencode/skills/monitor-ci/scripts/*.mjs",
        ".github/actions/nx-affected-docker-apps/compute-outputs.mjs",
      ],
      "project": [
        "scripts/**/*.{ts,tsx,js,mjs}",
        ".github/actions/**/*.mjs",
        ".agents/skills/monitor-ci/scripts/*.mjs",
        ".cursor/skills/monitor-ci/scripts/*.mjs",
        ".opencode/skills/monitor-ci/scripts/*.mjs",
      ],
      // Root package.json is the pnpm hoist catalog (apps use empty package.json deps).
      "ignoreDependencies": [
        "@apollo/cache-control-types",
        "@apollo/server",
        "@apollo/server-plugin-response-cache",
        "@apollo/utils.keyvadapter",
        "@apollo/utils.keyvaluecache",
        // Peer of @nestjs/apollo (Express 5 middleware); hoisted at root, not imported directly
        "@as-integrations/express5",
        "@commitlint/config-conventional",
        "@commitlint/config-nx-scopes",
        "@golevelup/ts-vitest",
        "@headlessui/react",
        "@keyv/redis",
        "@langchain/classic",
        "@langchain/community",
        "@langchain/google-vertexai",
        "@langchain/langgraph",
        "@langchain/langgraph-checkpoint-postgres",
        "@langchain/textsplitters",
        "@mjackson/file-storage",
        "@mjackson/form-data-parser",
        "@mjackson/multipart-parser",
        "@modelcontextprotocol/sdk",
        "@nestjs/apollo",
        "@nestjs/cli",
        "@nestjs/devtools-integration",
        "@nestjs/swagger",
        "@nestjs/testing",
        "@nestjs/throttler",
        "@parcel/watcher",
        "@radix-ui/react-slot",
        "@react-router/express",
        "@rollbar/react",
        "@tanstack/query-sync-storage-persister",
        "@tanstack/react-query",
        "@tanstack/react-query-persist-client",
        "@tinymce/tinymce-react",
        "@vercel/analytics",
        "ajv",
        "ajv-formats",
        "ansi-regex",
        "array-move",
        "async-limiter",
        "autoprefixer",
        "axios",
        "buffer",
        "chalk",
        "compression",
        "concurrently",
        "cssnano",
        "dnd-core",
        "enhanced-resolve",
        "framer-motion",
        "globals",
        "graphql-request",
        "graphql-scalars",
        "husky",
        "i18next",
        "i18next-browser-languagedetector",
        "i18next-http-backend",
        "i18next-resources-for-ts",
        "ignore",
        "immutability-helper",
        "invariant",
        "jimp",
        "jose",
        "json-schema",
        "langchain",
        "lightningcss",
        "logform",
        "memoize-one",
        "ml-distance",
        "morgan",
        "motion",
        "nestjs-cls",
        "normalize.css",
        "nullthrows",
        "pdf-parse",
        "pino",
        "postcss",
        "postcss-import",
        "postcss-nesting",
        "postcss-preset-env",
        "prettier-plugin-tailwindcss",
        "react-i18next",
        "react-scan",
        "react-test-renderer",
        "react-toastify",
        "react-tooltip",
        "react-use",
        "reading-time",
        "remix-development-tools",
        "rollbar",
        "sanitize-html",
        "schema-to-yup",
        "shadcn",
        "socket.io-client",
        "stripe",
        "swc-loader",
        "tailwind-merge",
        "tailwindcss-animate",
        "tiny-invariant",
        "tmp",
        "tslab",
        "tsup",
        "typescript-json-schema",
        "use-latest-callback",
        "usehooks-ts",
        "uuid",
        "vscode-openthrottle",
        "waait",
        "webpack-cli",
        "whatwg-url-without-unicode",
        "winston",
        "winston-transport",
        "yargs",
        "youtubei.js",
        "zod-to-json-schema",
      ],
      "ignoreBinaries": ["caddy"],
    },
    "tools/generators": {
      "entry": [
        "src/index.ts",
        "src/generators/folders/generator.ts",
        "src/generators/nestjs/generator.ts",
        "src/generators/nestjs/generator.ai-agent.ts",
        "src/generators/nestjs/generator.application.ts",
        "src/generators/nestjs/generator.graphql-service.ts",
        "src/generators/nestjs/generator.module.ts",
        "src/generators/nestjs/generator.queue.ts",
        "src/generators/nestjs/generator.simple-service.ts",
        "src/generators/package/generator.ts",
        "src/generators/react/generator.ts",
        "src/generators/react/generator.component.ts",
        "src/generators/react/generator.hook.ts",
        "src/generators/react/generator.util.ts",
        "src/generators/react-router/generator.ts",
        "src/generators/react-router/generator.application.ts",
        "src/generators/react-router/generator.component.ts",
        "src/generators/react-router/generator.form.ts",
        "src/generators/react-router/generator.modal.ts",
        "src/generators/react-router/generator.route.ts",
        "src/generators/react-router/generator.table.ts",
      ],
      "project": ["src/**/*.ts"],
      "ignore": ["src/generators/*/files/**"],
    },
    "tools/ollama-proxy": {
      "entry": ["src/server.ts", "scripts/e2e.mjs"],
      "project": ["src/**/*.ts", "scripts/**/*.{js,mjs}"],
    },
    "tools/dotfiles": {
      "project": ["src/**/*.ts"],
    },
    "packages/nestjs-agentic-workflow": {
      "entry": ["src/index.ts", "src/testing/index.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@golevelup/ts-vitest", "@nestjs/testing"],
    },
    "packages/nestjs-repositories": {
      "entry": ["src/index.ts", "src/nestjs-repositories.module.ts"],
      "project": ["src/**/*.ts"],
    },
    "packages/nestjs-typeorm": {
      "entry": ["src/index.ts", "src/nestjs-typeorm.module.ts"],
      "project": ["src/**/*.ts"],
    },
    "packages/openthrottle-mcp": {
      "entry": [
        "src/index.ts",
        "src/bin.ts",
        "src/run-server.ts",
        "src/nest-tool-handlers.ts",
        "src/nest/bootstrap-openthrottle-mcp-app.ts",
      ],
      "project": ["src/**/*.ts"],
    },
    "packages/nodejs-graphql": {
      "entry": ["src/index.ts", "src/index-v2.ts", "src/graphql-v2.ts"],
      "project": ["src/**/*.ts"],
    },
    "packages/graphql-codegen": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@graphql-codegen/client-preset",
        "graphql-codegen-typescript-validation-schema",
      ],
    },
    "packages/openthrottle-agentic-ralph": {
      "entry": ["src/index.ts", "codegen.ts"],
      "project": ["src/**/*.ts", "graphql/**/*.graphql"],
    },
    "packages/openthrottle-agentic-workflow": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
    },
    "packages/openthrottle-developer-codegen": {
      "entry": ["src/index.ts", "codegen.ts"],
      "project": ["src/**/*.ts", "graphql/**/*.graphql"],
    },
    "packages/openthrottle-notifications": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
    },
    "tools/workflows": {
      "entry": [
        "src/index.ts",
        "src/bin/ralph.ts",
        "src/bin/link-merge.ts",
        "src/bin/lighthouse.ts",
        "src/bin/run-iteration.ts",
        "src/doc-ingestion/index.ts",
        "src/utils/ralph-debug-logger.ts",
        "scripts/*.{ts,js}",
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,js}"],
    },
  },
  "ignoreIssues": {
    // Nx generator factories export both a named function and default (required by @nx/devkit).
    "tools/generators/src/generators/folders/generator.ts": ["duplicates"],
    "tools/generators/src/generators/nestjs/generator.ts": ["duplicates"],
    "tools/generators/src/generators/package/generator.ts": ["duplicates"],
    "tools/generators/src/generators/react/generator.ts": ["duplicates"],
    "tools/generators/src/generators/react-router/generator.ts": ["duplicates"],
  },
}
