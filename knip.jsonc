{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // Treat in-file-only interface/type exports as used (component Props, public API types).
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true,
  },
  // Public API exports are marked with the JSDoc /** @public */ tag, which knip
  // recognizes natively (excluded from unused-export reports) — no custom "tags"
  // filter needed. See docs/monorepo/Knip.md.
  // React Router typegen: @/* → .react-router/types/* (generated at build; not on disk for report-only Knip).
  "ignoreUnresolved": ["@/app/\\+types/.*", "@/app/routes/\\+types/.*"],
  "entry": [
    // "applications/**/*.{ts,tsx,js,jsx}", // Uncomment this to include all applications
    // NestJS applications
    "applications/**/main.ts",
    // React Router applications
    "applications/**/entry.client.tsx",
    "applications/**/entry.server.tsx",
    "applications/**/root.tsx",
    "applications/**/app/routes/**/*.{ts,tsx}",
    "applications/**/tests/setup.ts",
    "applications/**/app/testing/**/*.{ts,tsx}",
    // Packages
    "packages/**/src/index.{ts,tsx,js,jsx}",
    "packages/**/src/bin.{ts,js}",
    // Storybook: stories are co-located in the package they document and are
    // loaded by the openthrottle-workbench host's `stories` glob, so they are
    // unreachable from src/index.ts. Declared as entries rather than ignored,
    // so package exports a story consumes stay correctly marked as used.
    // Knip's Storybook plugin also infers these from .storybook/main.ts —
    // listing them makes the contract explicit rather than implicit.
    "packages/**/src/**/*.stories.tsx",
    "applications/openthrottle-workbench/.storybook/{main,preview}.{ts,tsx}",
    // Tools
    "tools/**/*.{ts,tsx,js,jsx}",
  ],
  "ignore": [
    // Note: dist/build/coverage/node_modules/.nx/.cache are gitignored, so knip skips
    // them by default (gitignore-aware) — no need to list them here. Only NON-gitignored
    // paths need entries (.expo/.venv are not gitignored).
    "**/__snapshots__/**",
    "**/__tests__/**",
    "**/.expo/**",
    "**/.venv/**",
    "**/*.config.{ts,js,mjs,mts}",
    "**/public/worker.js",
    "**/apollo.config.mjs",
    "**/*.spec.{ts,tsx,js,jsx}",
    "**/*.test.{ts,tsx,js,jsx}",
    "**/*.workspace.{ts,js}",
    // Vitest setup harnesses: referenced by each project's vitest.config.ts, not by the
    // import graph. The vitest plugin is off (see the "vitest" key), so ignore by glob
    // instead of listing each one. Covers tests/setup.ts and *.setup.ts across all workspaces.
    "**/tests/setup.ts",
    "**/vitest.setup.ts",
    "**/codegen.{ts,js}",
    "tools/generators/src/generators/*/files/**",
    // Committed GraphQL codegen output (server, website). The barrel files are emitted
    // whether or not anything imports them; the gitignored copies are skipped already.
    "**/__generated__/**",
    // Test-only support modules: imported solely by __tests__ / *.test.ts files, which
    // the globs above hide from the import graph.
    "applications/*/app/routing/*/testing/**",
    "applications/openthrottle-cms/app/routing/fragments/data/mock.fragment-editor.ts",
    "applications/openthrottle-server/src/graphql/agents/mcp-router/golden-prompts/**",
    "packages/agentic-replay-testing/tests/support/**",
    "tools/ot-telemetry/tests/**",
    // openthrottle-developer: kept for commented JSX / intentional rollback (see @deprecated)
    "applications/openthrottle-developer/app/routing/agents/components/AgentsSectionQuickLinks.tsx",
    "applications/openthrottle-developer/app/routing/dashboard/components/DashboardQueueStats.tsx",
    "applications/openthrottle-developer/app/routing/dashboard/components/DashboardQuickNavigation.tsx",
    "applications/openthrottle-developer/app/routing/home/components/HomeBuiltWith.tsx",
    "applications/openthrottle-developer/app/routing/home/data/technology.ts",
    "applications/openthrottle-developer/app/routing/queues/components/QueuesToolbar.tsx",
    // Shared jump-link data for DashboardQuickNavigation (commented on dashboard; unit tests cover routes)
    "applications/openthrottle-developer/app/routing/navigation/data/workspace-jump-links.ts",
    // Vitest / route test harness (entry globs do not satisfy knip file graph yet)
    "applications/openthrottle-developer/app/testing/route-fixtures.tsx",
    "applications/openthrottle-developer/app/testing/search-route-fixtures.ts",
    // @openthrottle/react-router-cms-core: spec-only fixtures (knip ignores __tests__, and stories stay in react-router-shadcn)
    "packages/react-router-cms-core/src/data/mock.*.ts",
    // openthrottle-server: Stripe payments / RBAC roles disabled in app.module (intentional rollback; see @deprecated)
    "applications/openthrottle-server/src/graphql/payments/**",
    "applications/openthrottle-server/src/graphql/roles/**",
    "applications/openthrottle-server/src/modules/payments/**",
    // Golden prompts consumed by agents-mcp-router.golden-prompts.test.ts (knip excludes *.test.ts)
    "applications/openthrottle-server/src/graphql/agents/agents-mcp-router.golden-prompts.ts",
    // @openthrottle/react-router-shadcn: CSS entrypoints (app @import)
    "packages/react-router-shadcn/src/theme.css",
    "packages/react-router-shadcn/src/commander.css",
    // Ambient window.env merge (consumed via TypeScript program, not import graph)
    "packages/react-router-ui-global/src/types/global.d.ts",
    // infra/ is Terraform-only (no TS project graph)
    "infra/**",
  ],
  "ignoreDependencies": [
    // Internal
    "@openthrottle/*",
    "@tools/*",

    // External
    "@nx/*",
    "@testing-library/*",
    "@types/*",
    "@vitest/*",
    // Test-only: the HTML5 drag backend wraps react-dnd specs (react-router-cms-core); knip ignores __tests__
    "react-dnd-html5-backend",
    "eslint-*",
    "prettier",
    "typescript",
    "vitest",

    // Consumed ONLY by the react-router `form` generator templates under
    // tools/generators/src/generators/react-router/files/form/, which are
    // .ts/.tsx template files rather than compiled source — so knip cannot
    // see the imports and reports all three as unused. They are declared at
    // the root so scaffolded forms resolve them in any app. Removing them
    // breaks the `form` generator silently, with the failure landing on
    // whoever scaffolds a form next. See the matching note in
    // pnpm-workspace.yaml. (formik is additionally a real dependency of
    // @openthrottle/react-router-utils, which declares it directly.)
    "focus-formik-error",
    "formik",
    "yup",
  ],
  "project": [
    "applications/**/*.{ts,tsx,js,jsx}",
    "packages/**/*.{ts,tsx,js,jsx}",
    "scripts/**/*.{ts,tsx,js,jsx}",
    "tools/**/*.{ts,tsx,js,jsx}",
    "!**/build/**",
    "!**/codegen.{ts,js}",
    "!**/coverage/**",
    "!**/dist/**",
    "!**/node_modules/**",
  ],
  "nx": {
    "config": "nx.json",
  },
  // Vitest plugin stays OFF: every vitest.config in this repo is dynamic (a function
  // export using loadEnv, or the createVitestConfig* factory from @tools/dotfiles), so
  // knip can't statically read `setupFiles`. Enabling it fails to resolve setup files
  // (they'd report as unused) AND pulls test-only imports in as "unlisted" deps. Setup
  // files are ignored by glob below instead. (Revisit if configs become static objects.)
  "vitest": false,
  "workspaces": {
    "applications/openthrottle-developer": {
      "entry": [
        "app/entry.client.tsx",
        "app/entry.server.tsx",
        "app/root.tsx",
        "app/routes/**/*.{ts,tsx}",
        "app/testing/**/*.{ts,tsx}",
      ],
      "ignoreDependencies": [
        // Read by apollo.config.mjs, which the root ignore hides.
        "dotenv",
        // Plugin named in codegen.ts (root-ignored); its output is gitignored.
        "graphql-codegen-typescript-validation-schema",
        // A runtime dependency, not dead: the SSR build externalizes it from
        // react-router-shadcn's Sonner.tsx, so the image must ship it (the
        // boot check fails otherwise), and 14 specs `vi.mock('sonner')`.
        "sonner",
      ],
    },
    "applications/openthrottle-admin": {
      "ignoreDependencies": [
        // Imported only by the gitignored app/__generated__ codegen output.
        "@graphql-typed-document-node/core",
        "zod",
        // Read by apollo.config.mjs, which the root ignore hides.
        "dotenv",
        // Plugin named in codegen.ts (root-ignored).
        "graphql-codegen-typescript-validation-schema",
      ],
    },
    "applications/openthrottle-cms": {
      "ignoreDependencies": [
        // Read by apollo.config.mjs, which the root ignore hides.
        "dotenv",
        // Imported only by the gitignored app/__generated__ codegen output.
        "zod",
      ],
    },
    "applications/openthrottle-website": {
      // Read by apollo.config.mjs, which the root ignore hides.
      "ignoreDependencies": ["dotenv"],
    },
    // Screencast pipeline (PIPELINE.md). The CLI entrypoints and demo-database scripts
    // are each run by an Nx `video-*` / `snapshot-refresh` target rather than imported,
    // so without this every module they pull in reads as unused. The episode flows and
    // surfaces are entries too: run.ts resolves them by slug through a dynamic import
    // that knip cannot follow.
    "packages/openthrottle-showroom": {
      "entry": [
        "src/index.ts",
        "src/assemble/assemble.ts",
        "src/episodes/*/{flow,surface}.ts",
        "src/episodes/flows.ts",
        "src/narrate/narrate.ts",
        "src/runner/run.ts",
        "src/scan/leak-scan.ts",
        "src/scripts/*.ts",
        "src/validate/validate.ts",
      ],
      "ignore": [
        // Leak scanner for the committed snapshot; exercised only by snapshot-data.test.ts.
        "src/snapshot/scanSnapshotText.ts",
      ],
    },
    // Hook bundles. Nothing imports an adapter: scripts/bundle-hooks.ts hands each one
    // to esbuild as an entrypoint by path (its BUNDLES array), and the scripts are run
    // through tsx by this package's Nx targets.
    "packages/agentic-hooks": {
      "entry": [
        "src/index.ts",
        "scripts/*.ts",
        "src/adapters/{antigravity,claude,codex,cursor}/*.ts",
      ],
    },
    // check-drift.ts and record.ts are run through tsx by this package's Nx targets.
    "packages/agentic-replay-testing": {
      "entry": ["src/index.ts", "scripts/*.ts"],
    },
    // check-surfaces.ts and generate-surfaces.ts are run by this package's Nx targets.
    "packages/openthrottle-social": {
      // The scheduled jobs and the setup run these with `node` (pnpm run social:*).
      "entry": ["src/index.ts", "src/scripts/*.ts"],
    },
    "packages/openthrottle-product": {
      "entry": ["src/index.ts", "src/scripts/*.ts"],
    },
    "packages/react-router-markdown": {
      // Test-only: specs import react-dom/server and resolve tailwindcss/theme.css.
      "ignoreDependencies": ["react-dom", "tailwindcss"],
    },
    "packages/react-router-shadcn": {
      "ignoreDependencies": [
        // Test-only: specs use createRoutesStub (knip ignores __tests__).
        "react-router",
        // CSS `@import` in src/theme.css, which is not in the import graph.
        "tw-animate-css",
      ],
    },
    "tools/ot-telemetry": {
      // Runs this package's Nx target command (`tsx ... src/index.ts`).
      "ignoreDependencies": ["tsx"],
    },
    // Electron shell. None of these are imported: electron-vite's config names the main,
    // child-server and preload entries as strings, the renderer is reached from
    // index.html, `package` runs stage-app.ts through tsx, and the opt-in
    // `test-e2e` target runs the Playwright smoke suite through vitest.e2e.config.ts.
    // The vitest/electron-vite plugins are off here, so they are listed explicitly.
    "applications/openthrottle-app": {
      "entry": [
        "electron.vite.config.ts",
        "scripts/stage-app.ts",
        "src/main/main.ts",
        "src/preload/preload.ts",
        "src/renderer/main.tsx",
        "src/server/server-entry.ts",
        "tests/e2e/*.e2e.ts",
        "vitest.e2e.config.ts",
      ],
      // Ambient `window.openthrottleShell` merge (TypeScript program, not import graph).
      "ignore": ["src/renderer/global.d.ts"],
      // CLI / CSS consumers knip cannot see: the `package` target runs the
      // electron-builder binary, and styles.css @imports the two Tailwind packages.
      "ignoreDependencies": [
        "electron-builder",
        "tailwindcss",
        "tw-animate-css",
      ],
      "project": ["{scripts,src,tests}/**/*.{ts,tsx}", "*.config.ts"],
    },
    ".": {
      "entry": [
        "scripts/pnpm-package.ts",
        "scripts/parallelize-tasks.ts",
        "scripts/update-openthrottle-plan-status.ts",
        "scripts/update-openthrottle-task-status.ts",
        "scripts/openthrottle-ingest-agent-assets.ts",
        "scripts/openthrottle-ingest-docs.ts",
        "scripts/validate-agent-assets-frontmatter.ts",
        "scripts/check-migration-table-comments.ts",
        "scripts/check-model-facing-text.ts",
        "scripts/openthrottle-database-backup.ts",
        "scripts/openthrottle-database-migrations.ts",
        // Run by the migrations image (Dockerfile.Migrations CMD), not imported.
        "databases/migrate.ts",
        "scripts/openthrottle-database-reset.ts",
        "scripts/openthrottle-database-seed-blog.ts",
        "scripts/nx-validate-confgurations.ts",
        "scripts/nx-validate-projects.ts",
        "scripts/nx-validate-tags.ts",
        "scripts/nx-dependency-graph.ts",
        "scripts/nx-circular-dependencies.ts",
        "scripts/audit-templates-compliance.ts",
        // Run by nx.json targets.
        "scripts/check-claude-config-json.ts",
        "scripts/check-folder-vocabulary.ts",
        "scripts/check-generated-attributes.ts",
        "scripts/check-local-ci-parity.ts",
        "scripts/check-migration-hygiene.ts",
        "scripts/check-nodenext-references.ts",
        "scripts/check-package-entrypoints.ts",
        "scripts/check-side-effects.ts",
        "scripts/check-test-file-filter-docs.ts",
        "scripts/check-test-file-names.ts",
        "scripts/sync-agent-config.ts",
        // Run by root package.json scripts.
        "scripts/ensure-embedding-model.ts",
        "scripts/ensure-migrations.ts",
        "scripts/ollama.ts",
        // Run by CI (and the codegen packages' verify targets).
        "scripts/generate-shard-weights.ts",
        "scripts/verify-graphql-codegen.ts",
        // Run by scripts/setup.sh, the worktree hooks (skills/ot-worktree,
        // .worktree/teardown.sh) and scripts/run-openthrottle-mcp.sh.
        "scripts/heal_worktree.ts",
        "scripts/run-openthrottle-mcp.ts",
        "scripts/setup.ts",
        "scripts/setup_worktree.ts",
        "scripts/teardown_worktree.ts",
        // Run by .agents/plugins/openthrottle/hooks.json.
        "scripts/antigravity-deny-hook.ts",
        // Documented manual CLIs with no in-repo invoker.
        "scripts/audit-docs-index.ts",
        "scripts/ci-timings.ts",
        "scripts/codemod-import-extensions.ts",
        "scripts/docker-smoke-test.ts",
        "scripts/gcs-docker-upload.ts",
        "scripts/verify-openthrottle-mcp-env.ts",
        ".agents/skills/monitor-ci/scripts/*.mjs",
        ".cursor/skills/monitor-ci/scripts/*.mjs",
        ".opencode/skills/monitor-ci/scripts/*.mjs",
        ".github/actions/nx-affected-docker-apps/compute-outputs.mjs",
      ],
      "project": [
        "scripts/**/*.{ts,tsx,js,mjs}",
        ".github/actions/**/*.mjs",
        ".agents/skills/monitor-ci/scripts/*.mjs",
        ".cursor/skills/monitor-ci/scripts/*.mjs",
        ".opencode/skills/monitor-ci/scripts/*.mjs",
      ],
      // Root package.json is the pnpm hoist catalog (apps use empty package.json deps).
      "ignoreDependencies": [
        "@apollo/cache-control-types",
        "@apollo/server",
        "@apollo/server-plugin-response-cache",
        "@apollo/utils.keyvadapter",
        "@apollo/utils.keyvaluecache",
        // Peer of @nestjs/apollo (Express 5 middleware); hoisted at root, not imported directly
        "@as-integrations/express5",
        "@commitlint/config-conventional",
        "@commitlint/config-nx-scopes",
        "@golevelup/ts-vitest",
        // Provides the `graphql-codegen` binary the nx.json codegen-graphql target runs.
        "@graphql-codegen/cli",
        "@headlessui/react",
        "@keyv/redis",
        "@langchain/classic",
        "@langchain/community",
        "@langchain/google-vertexai",
        "@langchain/langgraph",
        "@langchain/langgraph-checkpoint-postgres",
        "@langchain/textsplitters",
        "@mjackson/file-storage",
        "@mjackson/form-data-parser",
        "@mjackson/multipart-parser",
        "@modelcontextprotocol/sdk",
        "@nestjs/apollo",
        "@nestjs/cli",
        "@nestjs/swagger",
        "@nestjs/testing",
        "@nestjs/throttler",
        "@parcel/watcher",
        "@radix-ui/react-slot",
        // Hoisted for the React Router apps, which each declare and import it themselves.
        "@react-router/dev",
        "@react-router/express",
        "@rollbar/react",
        "@tanstack/query-sync-storage-persister",
        "@tanstack/react-query",
        "@tanstack/react-query-persist-client",
        "@tinymce/tinymce-react",
        "@vercel/analytics",
        "ajv",
        "ajv-formats",
        "ansi-regex",
        "array-move",
        "async-limiter",
        "autoprefixer",
        "axios",
        "buffer",
        "chalk",
        "compression",
        "concurrently",
        "cssnano",
        "dnd-core",
        "enhanced-resolve",
        "framer-motion",
        "globals",
        "graphql-request",
        "graphql-scalars",
        "husky",
        "i18next",
        "i18next-browser-languagedetector",
        "i18next-http-backend",
        "i18next-resources-for-ts",
        "ignore",
        "immutability-helper",
        "invariant",
        "jimp",
        "jose",
        "json-schema",
        "langchain",
        "lightningcss",
        "logform",
        "memoize-one",
        "ml-distance",
        "morgan",
        "motion",
        "nestjs-cls",
        "normalize.css",
        "nullthrows",
        "pdf-parse",
        "pino",
        "postcss",
        "postcss-import",
        "postcss-nesting",
        "postcss-preset-env",
        "prettier-plugin-tailwindcss",
        "react-i18next",
        "react-scan",
        "react-toastify",
        "react-tooltip",
        "react-use",
        "reading-time",
        "remix-development-tools",
        "rollbar",
        "sanitize-html",
        "schema-to-yup",
        "shadcn",
        "socket.io-client",
        "stripe",
        "swc-loader",
        "tailwind-merge",
        "tailwindcss-animate",
        "tiny-invariant",
        "tmp",
        "tslab",
        "tsup",
        // Named in tools/nx-plugins/typecheck-compiler.ts `externalDependencies`, not imported.
        "typescript7",
        "typescript-json-schema",
        "use-latest-callback",
        "usehooks-ts",
        "uuid",
        "waait",
        "webpack-cli",
        "whatwg-url-without-unicode",
        "winston",
        "winston-transport",
        "yargs",
        "youtubei.js",
        "zod-to-json-schema",
      ],
      // System binaries spawned by scripts, not npm packages (knip 6 reports
      // unlisted binaries): caddy (local proxy), pg_dump (database:backup).
      "ignoreBinaries": ["caddy", "pg_dump"],
    },
    "tools/generators": {
      "entry": [
        "src/index.ts",
        "src/generators/folders/generator.ts",
        "src/generators/nestjs/generator.ts",
        "src/generators/nestjs/generator.ai-agent.ts",
        "src/generators/nestjs/generator.application.ts",
        "src/generators/nestjs/generator.graphql-service.ts",
        "src/generators/nestjs/generator.module.ts",
        "src/generators/nestjs/generator.queue.ts",
        "src/generators/nestjs/generator.simple-service.ts",
        "src/generators/package/generator.ts",
        "src/generators/react/generator.ts",
        "src/generators/react/generator.component.ts",
        "src/generators/react/generator.hook.ts",
        "src/generators/react/generator.util.ts",
        "src/generators/react-router/generator.ts",
        "src/generators/react-router/generator.application.ts",
        "src/generators/react-router/generator.component.ts",
        "src/generators/react-router/generator.form.ts",
        "src/generators/react-router/generator.modal.ts",
        "src/generators/react-router/generator.route.ts",
        "src/generators/react-router/generator.table.ts",
      ],
      "project": ["src/**/*.ts"],
      "ignore": ["src/generators/*/files/**"],
    },
    "tools/ollama-proxy": {
      "entry": ["src/server.ts", "scripts/e2e.mjs"],
      "project": ["src/**/*.ts", "scripts/**/*.{js,mjs}"],
    },
    "tools/dotfiles": {
      "project": ["src/**/*.ts"],
    },
    "packages/nestjs-graphql": {
      "entry": [
        "src/index.ts",
        // Shell-invoked with no in-repo importer: the nx.json `graphql-schema`
        // targetDefault runs `node .../dist/src/bin.js`, so knip cannot reach it
        // (or schema/graphql-schema-command.ts, which it imports) via the import graph.
        "src/bin.ts",
      ],
      // Runtime driver behind @nestjs/apollo's `subscriptions['graphql-ws']`; never imported.
      "ignoreDependencies": ["graphql-ws"],
      "project": ["src/**/*.ts"],
    },
    // Every file Node runs directly in the production image: the server, the one-shot
    // `bootstrap` compose service, and the NODE_OPTIONS=--import preload (Dockerfile.NestJS).
    "applications/openthrottle-server": {
      "entry": [
        "src/bootstrap.ts",
        "src/main.ts",
        "src/register-workspace-type-stripping.ts",
      ],
      // macOS Spotlight CLI spawned by editor presence; a system binary, not a dependency.
      "ignoreBinaries": ["mdfind"],
      "ignoreDependencies": [
        // nest-cli.json `collection`; knip reports it as unlisted otherwise.
        "@nestjs/schematics",
        // Used by vitest.config.ts, which the root ignore hides.
        "unplugin-swc",
      ],
    },
    // Test support (fixtures, factories, the TestRecord entity) is imported only by
    // *.test.ts files, which the root ignore hides from the import graph.
    "packages/nestjs-postgres": {
      "entry": ["src/index.ts"],
      "ignore": ["src/**/*.factory.ts", "src/**/testing/**"],
      "ignoreDependencies": ["@faker-js/faker", "fishery"],
      "project": ["src/**/*.ts"],
    },
    "packages/nestjs-typeorm": {
      "entry": ["src/index.ts", "src/nestjs-typeorm.module.ts"],
      "project": ["src/**/*.ts"],
    },
    "packages/openthrottle-mcp-evals": {
      "entry": [
        "src/index.ts",
        // Run by the on-demand `eval-tool-selection` Nx target (tsx); reaches
        // the rest of src/tool-selection/, which it imports.
        "src/tool-selection/cli.ts",
        // Run by the on-demand `eval-search-ranking` Nx target (tsx); reaches
        // the rest of src/search-ranking/, which it imports.
        "src/search-ranking/cli.ts",
        // Spawned by cli.ts as a stdio child through a `new URL(...)` path,
        // not an import, so knip cannot reach it from the graph.
        "src/sandbox/bin-sandbox.ts",
      ],
    },
    "packages/openthrottle-mcp": {
      "entry": [
        "src/index.ts",
        "src/bin.ts",
        "src/runServer.ts",
        "src/nest-tool-handlers.ts",
        "src/nest/bootstrapMcpDeveloperApp.ts",
        // Run by the `measure-tool-surface` Nx target (tsx); also reaches
        // surface.ts, which it imports.
        "src/model-facing-text/writeToolSurface.ts",
        // Public `./tool-surface` subpath, consumed by openthrottle-mcp-evals.
        "src/tool-surface.ts",
        // Streamable-HTTP MCP surface. Shell-invoked container entrypoints with
        // no in-repo importer, so knip cannot reach them via the import graph:
        // Dockerfile.NestJS `mcp-development` runs `tsx src/bin-http.ts`, and the
        // distroless `mcp` stage ships the bundle built from it. Declaring
        // bin-http.ts here also covers runServerHttp.ts and
        // http/mcp-http-auth.middleware.ts, which it imports.
        "src/bin-http.ts",
        // Bundler for the above, run as `node esbuild.http.mjs` by the
        // Dockerfile.NestJS `mcp-build` stage. Keeps the `esbuild` devDependency
        // accounted for.
        "esbuild.http.mjs",
      ],
      // Plugin named in codegen.ts (root-ignored).
      "ignoreDependencies": ["graphql-codegen-typescript-validation-schema"],
      "project": ["src/**/*.ts"],
    },
    "packages/nodejs-graphql": {
      "entry": ["src/index.ts", "src/executeGraphqlV2.ts", "src/graphql-v2.ts"],
      "project": ["src/**/*.ts"],
    },
    "packages/graphql-codegen": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@graphql-codegen/client-preset",
        "graphql-codegen-typescript-validation-schema",
      ],
    },
    "packages/openthrottle-developer-codegen": {
      "entry": ["src/index.ts", "codegen.ts"],
      "ignoreDependencies": [
        // Imported only by the gitignored __generated__ output.
        "@graphql-typed-document-node/core",
        // Plugin named in codegen.ts.
        "graphql-codegen-typescript-validation-schema",
      ],
      "project": ["src/**/*.ts", "graphql/**/*.graphql"],
    },
    "packages/openthrottle-notifications": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
    },
  },
  "ignoreIssues": {
    // Nx generator factories export both a named function and default (required by @nx/devkit).
    "tools/generators/src/generators/folders/generator.ts": ["duplicates"],
    "tools/generators/src/generators/nestjs/generator.ts": ["duplicates"],
    "tools/generators/src/generators/package/generator.ts": ["duplicates"],
    "tools/generators/src/generators/react/generator.ts": ["duplicates"],
    "tools/generators/src/generators/react-router/generator.ts": ["duplicates"],
  },
}
