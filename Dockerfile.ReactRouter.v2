# React Router apps — multi-stage build from monorepo root (v2 optimization target).
# Copy of Dockerfile.ReactRouter; all size/optimization changes go here. Baseline kept in Dockerfile.ReactRouter.
# Build: docker build -f Dockerfile.ReactRouter.v2 [--build-arg ...] .
# See docs/openthrottle/docker-image-build-strategy.md and docs/openthrottle/docker-react-router-v2.md.
###########################################################################
#
#     👀 https://pnpm.io/docker using NX for the monorepo build
#
###########################################################################
ARG NODE_VERSION="22"
FROM node:${NODE_VERSION}-alpine AS base
# FROM node:${NODE_VERSION}-slim AS base

WORKDIR /app

ARG APP_ENV="production"
ARG APP_NAME="__REQUIRED_ARG__"
ARG APP_VERSION="__REQUIRED_ARG__"
ARG GITHUB_TOKEN="__REQUIRED_ARG__"
ARG NX_VERSION="__REQUIRED_ARG__"
ARG NX_KEY="__REQUIRED_ARG__"
ARG PNPM_VERSION="__REQUIRED_ARG__"

ENV APP_ENV="${APP_ENV}"
ENV APP_NAME="${APP_NAME}"
ENV APP_VERSION="${APP_VERSION}"
ENV NX_DAEMON="false"

# Enable pnpm via npm
RUN npm install --global pnpm@${PNPM_VERSION}

# Avoid gid/uid 1000 — node:alpine already has node:1000:1000
RUN addgroup --system --gid 1001 appuser
RUN adduser --system --uid 1001 --ingroup appuser appuser

################################################################################
#
#   BUILDER ~ Everything needed to build the application(s)
#
################################################################################
FROM base AS builder

# We limit the token to this layer, which is disposed of in the final build
ENV CI="true"
ENV GITHUB_TOKEN=${GITHUB_TOKEN}
ENV NODE_ENV="development"

# Only copy what's needed to install our dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

COPY ./applications/${APP_NAME}/package.json ./applications/${APP_NAME}/package.json
COPY ./packages ./packages
COPY ./tools ./tools

# Python tools are required to build
RUN apk add --update build-base python3 make g++\
  && rm -rf /var/cache/apk/*

# General best practice, keep it up to date
RUN apk update && apk upgrade

# Install "all" dependencies from NPM + Github Packages
RUN pnpm install


################################################################################
#
#   DEPENDENCIES ~ Trim the non-production dependencies - used in production
#
################################################################################
FROM builder AS dependencies

# Set the environment to production for the build
ENV NODE_ENV="production"

# Trim those packages down to what we need for production
RUN pnpm install --frozen-lockfile --prod

# Prune the store to reduce image size
RUN pnpm store prune

# Remove NestJS, Expo and React Native modules (not needed for React Router applications)
RUN rm -rf /app/node_modules/.pnpm/@nestjs*


################################################################################
#
#   BUILD - This layer builds the application and we grab the artifacts from
#
################################################################################
FROM builder AS build

# Set the environment to production for the build
ENV NODE_ENV="production"
ENV NX_DAEMON="false"
ENV NX_KEY=${NX_KEY}
ENV NX_SWC="true"

# Now we copy over all the source code
COPY . .

# Install dependencies
RUN --mount=type=cache,id=pnpm-development,target=/pnpm/store pnpm install --frozen-lockfile

# Build the application using GCS cache for Nx (secret is not persisted in final image)
RUN --mount=type=secret,id=gcs_credentials,target=/tmp/gcs-credentials.json \
  export GOOGLE_APPLICATION_CREDENTIALS=/tmp/gcs-credentials.json && \
  npx nx@${NX_VERSION} run ${APP_NAME}:build

# App-only runtime deps: deploy creates /app/pruned with only this app + its production node_modules
RUN pnpm --filter "${APP_NAME}" --prod deploy /app/pruned --legacy


################################################################################
#
#   PRODUCTION-ALPINE - Alternative: node:alpine base (has shell, can add curl)
#
################################################################################
# Use this target if you need a shell for debugging or curl for healthchecks:
#   docker build -f Dockerfile.ReactRouter.v2 --target production-alpine ...
FROM base AS production-alpine

ENV NODE_ENV="production"

# Production gets only the pruned app tree (no full /app/packages or /app/tools).
COPY --from=build /app/pruned/. /app/

# Curl is not installed in production by default. For dev/docker-compose healthchecks,
# either use wget (Alpine has it) or uncomment the line below and use --target production-alpine.
# RUN apk --update --no-cache add curl

RUN chown -R appuser:appuser /app
USER appuser

# Run React Router server via node (no pnpm in pruned image)
CMD ["node", "node_modules/@react-router/serve/bin.js", "build/server/index.js"]

################################################################################
#
#   PRODUCTION - Default: minimal footprint distroless/nodejs (no shell, no package manager)
#
################################################################################
# Distroless nodejs22 (Debian 12 base, nonroot). Smaller than node:alpine; no curl/shell.
# For a shell + curl (e.g. local healthchecks), use --target production-alpine.
FROM gcr.io/distroless/nodejs22-debian12:nonroot AS production

ENV NODE_ENV="production"

# Production gets only the pruned app tree (no full /app/packages or /app/tools).
COPY --from=build --chown=65532:65532 /app/pruned/. /app/

WORKDIR /app

# distroless nodejs image ENTRYPOINT is node; CMD is the script path + args
CMD ["node_modules/@react-router/serve/bin.js", "build/server/index.js"]
