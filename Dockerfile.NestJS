# OpenThrottle server — canonical multi-stage build from the monorepo root.
#
# v3 is the single source of truth for the openthrottle-server image. It supersedes the
# baseline `Dockerfile.NestJS` (fat Alpine image that copied the whole monorepo node_modules)
# and `Dockerfile.NestJS.v2` (distroless + pruned deploy, but with fragile hand-pruning).
#
# Build: docker build -f Dockerfile.NestJS --target production --build-arg APP_NAME=openthrottle-server [...] .
# Or via Nx: pnpm nx run openthrottle-server:docker-build
# See docs/openthrottle/docker-image-build-strategy.md.
#
# Targets: `production` (default — distroless, pruned), `production-debian` (shell + git
# for the host execution bridge), and `development` (builder-based, shell + full
# workspace, runs `pnpm nx run ${APP_NAME}:dev` with NX_DAEMON=false; used by the compose
# `dev` profile with `develop.watch`).
#
# Pruning: each app declares its real runtime deps (see applications/*/package.json), and
# `pnpm --filter <app> --prod deploy` produces the production tree. No manual
# `rm -rf node_modules/.pnpm/...` surgery — that was compensating for an over-broad
# `--legacy` deploy and is tracked for a real fix (injected strict deploy) in a follow-up plan.
#
# Production runtime: gcr.io/distroless/nodejs24-debian12:nonroot (glibc). Build stages use
# node:24-bookworm-slim so pruned native addons match distroless (Alpine/musl would not, and
# the build Node major must match the runtime's nodejs24 to keep native ABIs compatible).
###########################################################################
#
#     👀 https://pnpm.io/docker using NX for the monorepo build
#
###########################################################################
ARG NODE_VERSION="24"
FROM node:${NODE_VERSION}-bookworm-slim AS base

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ARG APP_ENV="production"
ARG APP_NAME="__REQUIRED_ARG__"
ARG APP_VERSION="__REQUIRED_ARG__"
ARG GITHUB_TOKEN="__REQUIRED_ARG__"
ARG NX_VERSION="__REQUIRED_ARG__"
ARG NX_KEY="__REQUIRED_ARG__"
ARG PNPM_VERSION="__REQUIRED_ARG__"

ENV APP_ENV="${APP_ENV}"
ENV APP_NAME="${APP_NAME}"
ENV APP_VERSION="${APP_VERSION}"
ENV CI="true"
ENV HUSKY="0"
ENV NX_DAEMON="false"

# Enable pnpm via npm
RUN npm install --global pnpm@${PNPM_VERSION}

# Only copy what's needed to install our dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig*.json ./

# Non-root identity for intermediate stages (final image uses distroless `nonroot`).
RUN groupadd --system --gid 1001 appuser \
  && useradd --system --uid 1001 --gid appuser appuser

################################################################################
#
#   BUILDER ~ Everything needed to build the application(s)
#
################################################################################
FROM base AS builder

# We limit the token to this layer, which is disposed of in the final build
ENV GITHUB_TOKEN=${GITHUB_TOKEN}
ENV NODE_ENV="development"

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY ./applications/${APP_NAME}/package.json ./applications/${APP_NAME}/package.json
COPY ./packages ./packages
COPY ./tools ./tools

COPY ./.agents ./.agents
COPY ./skills ./skills

# pnpm 11 won't expand ${GITHUB_TOKEN} from the committed .npmrc; write the
# GitHub Packages credential to the trusted user-level config. Confined to the
# build stages (builder and the development/build stages that derive from it) —
# the distroless production stage only copies the pruned tree, never this .npmrc.
RUN pnpm config set "//npm.pkg.github.com/:_authToken" "${GITHUB_TOKEN}"

# Install "all" dependencies from NPM + Github Packages
RUN pnpm install --frozen-lockfile

################################################################################
#
#   DEVELOPMENT - Shell-capable dev image running the Nx dev target (hot reload)
#
################################################################################
# Not distroless, no pruning: full workspace install retained so `nest start --watch`
# can rebuild on source changes synced in by `docker compose watch`. `production`
# (last stage) remains the default target, so builds without --target are unaffected.
FROM builder AS development

ENV NODE_ENV="development"
ENV NX_DAEMON="false"

# procps: nx/dev-server process management spawns `ps` (pidtree) — absent from
# bookworm-slim. git: common dev tooling shells out to it.
RUN apt-get update \
  && apt-get install -y --no-install-recommends git procps \
  && rm -rf /var/lib/apt/lists/*

COPY . .

RUN --mount=type=cache,id=pnpm-development,target=/pnpm/store pnpm install --frozen-lockfile

# Workspace packages/tools resolve from their dist/ outputs, which only the
# production `build` stage produces — build them once here so the dev server
# starts clean; the dev target's ^dev watchers keep them fresh afterwards.
# No GCS credentials in this stage: force the remote cache off. NODE_ENV=production
# for this command only — the codegen-graphql configs read the committed schema.gql
# but hard-require API_URL_INTERNAL (a live server) when NODE_ENV=development.
# --parallel=1: several build targets nest `nx run <proj>:build:tsc`, and with the
# daemon off each nested invocation recomputes the project graph; run in parallel
# they race on tmp/**/tsconfig.generated.*.json (ENOENT) and readCachedProjectGraph.
RUN unset NX_KEY && export NX_DISABLE_REMOTE_CACHE=true NODE_ENV=production && \
  pnpm dlx nx@${NX_VERSION} run-many --target build --projects tag:type:package,tag:type:tool --parallel=1

CMD ["sh", "-c", "pnpm nx run ${APP_NAME}:dev"]

################################################################################
#
#   BOOTSTRAP - no dedicated stage/image.
#
################################################################################
# One-shot provisioning (default user + service-account credentials) runs from
# the `production` server image via a command override on build/src/bootstrap.js
# (see the `bootstrap` service in docker-compose.yml). No separate bootstrap image
# is built or published. The host path still uses scripts/bootstrap-*.ts directly.

################################################################################
#
#   MCP-DEVELOPMENT - openthrottle-mcp HTTP from source via tsx (compose dev)
#
################################################################################
# Source + tsx + full workspace, for the compose `mcp-dev` service (develop.watch
# hot reload). Never published — the distroless `mcp` stage below is the shippable
# image. A long-running service: clients register { "type": "http", "url": ".../mcp" }.
FROM development AS mcp-development

ENV NODE_ENV="production"

HEALTHCHECK --interval=10s --timeout=10s --retries=3 --start-period=120s \
  CMD ["node", "-e", "require('http').request({host:'127.0.0.1',port:Number(process.env.OT_MCP_HTTP_PORT||6026),path:'/mcp',method:'POST',headers:{'content-type':'application/json','accept':'application/json, text/event-stream'}},function(r){process.exit(r.statusCode>0?0:1)}).on('error',function(){process.exit(1)}).end('{\"jsonrpc\":\"2.0\",\"id\":0,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-03-26\",\"capabilities\":{},\"clientInfo\":{\"name\":\"healthcheck\",\"version\":\"0\"}}}')"]

CMD ["sh", "-c", "node_modules/.bin/tsx packages/openthrottle-mcp/src/bin-http.ts"]

################################################################################
#
#   MCP-BUILD - esbuild the HTTP entry into ONE self-contained bundle
#
################################################################################
# The `builder` stage already has the full packages/ source + installed deps
# (incl. the mcp package's esbuild devDep), so this stage only runs the bundler —
# no Nx, no extra COPY/install. esbuild.http.mjs resolves @openthrottle/* from
# src and inlines every reachable dep into dist-bundle/bin-http.mjs (~10MB). No
# pnpm --prod deploy, no --legacy whole-workspace store: the final image ships a
# single file and needs zero node_modules.
FROM builder AS mcp-build

RUN node packages/openthrottle-mcp/esbuild.http.mjs

################################################################################
#
#   MCP - openthrottle-mcp over streamable HTTP (distroless; the shippable image)
#
################################################################################
# Distroless + ONE bundled file — no source, node_modules, tsx, Nx, pnpm, or shell.
# Clients register { "type": "http", "url": "http://<host>:<port>/mcp" }.
FROM gcr.io/distroless/nodejs24-debian12:nonroot AS mcp

WORKDIR /app

ENV NODE_ENV="production"

COPY --from=mcp-build --chown=65532:65532 /app/packages/openthrottle-mcp/dist/bundle/bin-http.mjs /app/bin-http.mjs

# In-image probe (distroless: node only, no curl). POST tools/list to the endpoint.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD ["/nodejs/bin/node", "-e", "require('http').request({host:'127.0.0.1',port:Number(process.env.OT_MCP_HTTP_PORT||6026),path:'/mcp',method:'POST',headers:{'content-type':'application/json','accept':'application/json, text/event-stream'}},function(r){process.exit(r.statusCode>0?0:1)}).on('error',function(){process.exit(1)}).end('{\"jsonrpc\":\"2.0\",\"id\":0,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-03-26\",\"capabilities\":{},\"clientInfo\":{\"name\":\"healthcheck\",\"version\":\"0\"}}}')"]

# ENTRYPOINT is Node; CMD is argv only (distroless/nodejs).
CMD ["bin-http.mjs"]

################################################################################
#
#   BUILD - Nx build + pnpm deploy pruned runtime tree
#
################################################################################
FROM builder AS build

# Set the environment to production for the build
ENV NODE_ENV="production"
ENV NX_DAEMON="false"
ENV NX_KEY=${NX_KEY}
ENV NX_SWC="true"

# Now we copy over all the source code
COPY . .

# Install dependencies
RUN --mount=type=cache,id=pnpm-development,target=/pnpm/store pnpm install --frozen-lockfile

# Build the application using GCS cache for Nx (secret is not persisted in final image).
# The @nx/gcs-cache remote cache is best-effort: it needs both a GCS credentials file
# (the gcs_credentials build secret) and NX_KEY. CI supplies both; local `nx docker-build`,
# forks, and compose-without-secrets supply neither. Only point GOOGLE_APPLICATION_CREDENTIALS
# at the secret when it was actually mounted (non-empty file) — otherwise Nx aborts with ENOENT
# reading a missing credentials file. Likewise unset an empty/placeholder NX_KEY, which Nx would
# reject with "Failed to decode the Nx key", and disable the remote cache (NX_DISABLE_REMOTE_CACHE)
# so the build never reaches out to GCS. With neither, the build runs on the local cache only;
# a real key + credentials (CI) are left intact and the remote cache is used.
RUN --mount=type=secret,id=gcs_credentials,target=/tmp/gcs-credentials.json \
  if [ -s /tmp/gcs-credentials.json ]; then export GOOGLE_APPLICATION_CREDENTIALS=/tmp/gcs-credentials.json; fi && \
  if [ -z "${GOOGLE_APPLICATION_CREDENTIALS}" ] || [ -z "${NX_KEY}" ] || [ "${NX_KEY}" = "__REQUIRED_ARG__" ]; then unset NX_KEY; export NX_DISABLE_REMOTE_CACHE=true; fi && \
  pnpm dlx nx@${NX_VERSION} run-many --target build --projects tag:type:package,tag:type:tool --parallel=1 && \
  pnpm dlx nx@${NX_VERSION} run ${APP_NAME}:build && \
  mkdir -p /app/applications/${APP_NAME}/i18n

# App-only runtime tree: pruned package dir with build/ + isolated production node_modules
# (same pattern as Dockerfile.ReactRouter — avoids copying the full monorepo node_modules,
# packages/, tools/). The production node_modules is resolved from the app's declared deps.
RUN pnpm --filter "${APP_NAME}" --prod deploy /app/pruned --legacy

################################################################################
#
#   PRODUCTION-DEBIAN ~ Debian slim + shell + git (host-execution-bridge friendly)
#
################################################################################
# Use when the container must run git against mounted host checkouts (the
# consumer host execution bridge) — distroless `production` has no shell or git:
#   docker build -f Dockerfile.NestJS --target production-debian ...
FROM base AS production-debian

ENV NODE_ENV="production"

RUN apt-get update \
  && apt-get install -y --no-install-recommends git procps \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/pruned/. /app/

RUN chown -R appuser:appuser /app

USER appuser

# Same probe as the distroless image, via the base image's node binary.
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD ["node", "-e", "require('http').get('http://127.0.0.1:'+String(process.env.PORT||'3000')+'/health',function(r){r.resume();r.on('end',function(){process.exit(r.statusCode===200?0:1)})}).on('error',function(){process.exit(1)})"]

CMD ["node", "-r", "dotenv/config", "build/src/main.js"]

################################################################################
#
#   PRODUCTION - Finally, build the production image with a "minimal" footprint
#
################################################################################
# Distroless: no shell, package manager, curl, or wget. We use Node's built-in HTTP client for
# the health probe (no extra packages). Compose maps PORT from OPENTHROTTLE_SERVER_PORT. If you
# override the healthcheck in compose, use exec form with /nodejs/bin/node (CMD-SHELL + wget will
# not run on distroless).
FROM gcr.io/distroless/nodejs24-debian12:nonroot AS production

WORKDIR /app

ENV NODE_ENV="production"

# Production ships only `pnpm deploy` output: the app package, its `build/`, and prod `node_modules`.
# We never COPY monorepo roots `/app/packages` or `/app/tools` into this stage; workspace libraries
# the server needs at runtime are already resolved into the pruned tree (built artifacts + linked deps).
COPY --from=build --chown=65532:65532 /app/pruned/. /app/

# In-image probe only — no curl. Matches root compose intent (GET /health on PORT).
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD ["/nodejs/bin/node", "-e", "require('http').get('http://127.0.0.1:'+String(process.env.PORT||'3000')+'/health',function(r){r.resume();r.on('end',function(){process.exit(r.statusCode===200?0:1)})}).on('error',function(){process.exit(1)})"]

# ENTRYPOINT is Node; CMD is argv only (see distroless/nodejs README).
CMD ["-r", "dotenv/config", "build/src/main.js"]
