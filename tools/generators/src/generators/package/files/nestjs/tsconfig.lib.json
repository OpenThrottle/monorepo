{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist",
    "rootDirs": [
      "./src",
      "./tests"
    ]
  },
  "include": [
    "src/**/*.json",
    "src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "dist"
  ]
}
