{
  "name": "<%= name %>",
  "description": "NestJS REST API",
  "version": "1.3.0",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {},
  "devDependencies": {},
  "engines": {
    "node": ">=22"
  },
  "main": "./src/main.ts",
  "module": "./src/main.ts",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "projectType": "application",
    "sourceRoot": "./",
    "tags": [
      "name:<%= name %>",
      "production:true",
      "technology:nestjs",
      "type:application"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "nest build --path {projectRoot}/tsconfig.app.json"
        },
        "dependsOn": [
          "^build",
          "^build-package"
        ]
      },
      "dev": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "nest start --path {projectRoot}/tsconfig.app.json --watch"
        },
        "dependsOn": [
          "^dev"
        ]
      },
      "lint": {
        "options": {
          "command": "pnpm exec eslint -c ./eslint.config.mts .",
          "cwd": "{projectRoot}"
        }
      },
      "start": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "nest start --path {projectRoot}/tsconfig.app.json"
        }
      },
      "test": {},
      "typecheck": {}
    }
  },
  "private": true,
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {
    "langgraph": "npx @langchain/langgraph-cli dev",
    "start:docker": "node -r dotenv/config ./build/src/main.js"
  },
  "sideEffects": false,
  "type": "commonjs"
}