{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["../../tsconfig.react-router.json", "../../tsconfig.vitest-react.json"],
  "compilerOptions": {
    "baseUrl": "./",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "paths": {
      "#/*": ["*"],
      "@/*": [".react-router/types/*"],
      "~/*": ["app/*"]
    },
    "rootDirs": ["./", ".react-router/types"]
  },
  "exclude": ["build", "dist", "node_modules"],
  "include": [
    ".react-router/types/**/*",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
