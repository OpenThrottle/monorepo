{
  "name": "@tools/dotfiles",
  "description": "Shared ESLint, Prettier, Vite, and Vitest configuration for the monorepo.",
  "version": "3.2.25",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "@nx/eslint": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@typescript-eslint/utils": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-eslint-comments": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-jest": "catalog:",
    "eslint-plugin-json": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "eslint-plugin-sort-keys-fix": "catalog:",
    "eslint-plugin-typescript-sort-keys": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@tools/dotfiles",
      "production:true",
      "publish:false",
      "technology:nodejs",
      "technology:typescript",
      "type:package"
    ],
    "targets": {
      "__dev": {
        "continuous": true,
        "executor": "@nx/js:tsc",
        "options": {
          "clean": false,
          "watch": true
        }
      },
      "build": {
        "executor": "@nx/js:tsc"
      },
      "lint": {
        "dependsOn": [
          "build"
        ]
      },
      "test": {},
      "typecheck": {},
      "typecheck-tests": {}
    }
  },
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "directory": "./",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "type": "module",
  "types": "./src/index.ts"
}
