{
  "name": "@tools/dotfiles",
  "description": "Shared ESLint, Vite, and Vitest configuration for the monorepo.",
  "version": "3.2.25",
  "author": {
    "email": "matthew.scholta@gmail.com",
    "name": "Matthew Scholta",
    "url": "https://mattscholta.com"
  },
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "@nx/eslint": "22.6.4",
    "@nx/eslint-plugin": "22.6.4",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@typescript-eslint/utils": "^8.53.0",
    "eslint": "^9.39.2",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.1",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-typescript-sort-keys": "^3.3.0",
    "typescript-eslint": "^8.58.0"
  },
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./dist/src/config.js",
      "require": "./dist/src/config.js",
      "default": "./dist/src/config.js"
    },
    "./vite-config": {
      "types": "./src/vite-config.ts",
      "import": "./dist/src/vite-config.js",
      "require": "./dist/src/vite-config.js",
      "default": "./dist/src/vite-config.js"
    },
    "./vitest-config": {
      "types": "./src/vitest-config.ts",
      "import": "./dist/src/vitest-config.js",
      "require": "./dist/src/vitest-config.js",
      "default": "./dist/src/vitest-config.js"
    }
  },
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@tools/dotfiles",
      "production:true",
      "publish:false",
      "technology:nodejs",
      "technology:typescript",
      "type:package"
    ],
    "targets": {
      "__dev": {
        "continuous": true,
        "executor": "@nx/js:tsc",
        "options": {
          "clean": false,
          "watch": true
        }
      },
      "build": {
        "executor": "@nx/js:tsc"
      },
      "lint": {
        "dependsOn": [
          "build"
        ]
      },
      "test": {},
      "typecheck": {},
      "typecheck-tests": {}
    }
  },
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "directory": "./",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  },
  "repository": "git://github.com/OpenThrottle/monorepo.git",
  "scripts": {},
  "type": "module",
  "types": "./src/index.ts"
}
