{
  // Emit-only compile for the `build` target: the same split the
  // openthrottle-server build makes with `--noCheck`. This package compiles
  // generated GraphQL client code and sits in openthrottle-server's build
  // graph, so a type-checking build fails on stale generated types whenever a
  // branch adds a schema field and code that reads it, before
  // graphql-schema:write can emit the schema that codegen needs (OT plan
  // 74ecccb1). The `typecheck` target is the type gate; it builds
  // tsconfig.lib.json, which must not carry noCheck.
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "noCheck": true
  },
  "references": [
    {
      "path": "../../packages/openthrottle-drivers/tsconfig.lib.json"
    },
    {
      "path": "../../packages/openthrottle-agentic-workflow/tsconfig.lib.json"
    },
    {
      "path": "../../packages/openthrottle-agentic-utils/tsconfig.lib.json"
    },
    {
      "path": "../../packages/openthrottle-agentic-ralph/tsconfig.lib.json"
    },
    {
      "path": "../../packages/nodejs-utils/tsconfig.lib.json"
    },
    {
      "path": "../dotfiles/tsconfig.lib.json"
    }
  ]
}
