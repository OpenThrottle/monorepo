{
  "bin": {
    "workflow-link-merge": "./dist/src/bin/link-merge.js",
    "workflow-lighthouse": "./dist/src/bin/lighthouse.js",
    "workflow-ralph": "./dist/src/bin/ralph.js"
  },
  "dependencies": {
    "@nx/devkit": "catalog:",
    "@openthrottle/openthrottle-agentic-ralph": "workspace:^",
    "@openthrottle/openthrottle-agentic-utils": "workspace:^",
    "@openthrottle/openthrottle-agentic-workflow": "workspace:^",
    "@tools/generators": "workspace:^",
    "commander": "catalog:",
    "pg": "catalog:",
    "pidusage": "catalog:"
  },
  "deprecated": "Use @openthrottle/nestjs-agentic-workflow for BullMQ agentic workflows. See tools/workflows/README.md.",
  "description": "[DEPRECATED] Legacy workflow CLIs and re-exports. New code should use @openthrottle/nestjs-agentic-workflow (queued runs), @openthrottle/nestjs-worktrees (worktrees), and @openthrottle/openthrottle-agentic-workflow (contracts). workflow-ralph remains a thin local CLI shim; workflow-link-merge and workflow-lighthouse stay here until relocated.",
  "devDependencies": {
    "@types/pidusage": "catalog:"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    },
    "./doc-ingestion": {
      "types": "./dist/src/doc-ingestion/index.d.ts",
      "import": "./dist/src/doc-ingestion/index.js",
      "require": "./dist/src/doc-ingestion/index.js"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "name": "@tools/workflows",
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [],
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@tools/workflows",
      "production:true",
      "publish:false",
      "technology:nodejs",
      "technology:typescript",
      "type:package"
    ],
    "targets": {
      "build": {
        "cache": false,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "nx run @tools/workflows:build:tsc",
            "chmod +x ./dist/src/bin/*.js"
          ],
          "parallel": false
        }
      },
      "build:tsc": {
        "cache": false,
        "description": "Compile @tools/workflows to dist with @nx/js:tsc.",
        "executor": "@nx/js:tsc"
      },
      "dev": {
        "continuous": true,
        "executor": "@nx/js:tsc",
        "options": {
          "clean": false,
          "watch": true
        }
      },
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  },
  "private": true,
  "scripts": {
    "postbuild": "chmod +x ./dist/src/bin/*.js"
  },
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "doc-ingestion": [
        "./dist/src/doc-ingestion/index.d.ts"
      ]
    }
  },
  "version": "1.0.0"
}
