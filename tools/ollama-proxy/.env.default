# Optional overrides (defaults shown). Copy to .env to customize.
OLLAMA_PROXY_PORT=11435
OLLAMA_BASE_URL=https://ollama.local
OLLAMA_PROXY_TARGET_MODEL=qwen3-coder-next
OLLAMA_PROXY_TIMEOUT_MS=120000
OLLAMA_PROXY_MAX_BODY_BYTES=10485760
# Comma-separated CORS allowlist; unset = no CORS headers (native clients only).
# OLLAMA_PROXY_ALLOWED_ORIGINS=http://localhost:3000
