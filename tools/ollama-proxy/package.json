{
  "name": "@tools/ollama-proxy",
  "description": "Local OpenAI-compatible HTTP proxy for Cursor and other clients: rewrites chat model names and forwards requests to Ollama.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "ollama-proxy": "./dist/server.js"
  },
  "scripts": {
    "start": "node ./dist/server.js",
    "build": "nx run @tools/ollama-proxy:build:tsc",
    "e2e": "node scripts/e2e.mjs"
  },
  "nx": {
    "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "./",
    "tags": [
      "name:@tools/ollama-proxy",
      "production:false",
      "technology:nodejs",
      "technology:typescript",
      "type:tool"
    ],
    "targets": {
      "build": {
        "cache": false,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "nx run @tools/ollama-proxy:build:tsc"
          ]
        },
        "parallel": false
      },
      "build:tsc": {
        "cache": false,
        "executor": "@nx/js:tsc",
        "options": {
          "outputPath": "{projectRoot}/dist",
          "rootDir": "{projectRoot}/src",
          "tsConfig": "{projectRoot}/tsconfig.lib.json"
        },
        "description": "Compile @tools/ollama-proxy to dist with @nx/js:tsc (src rootDir, tsconfig.lib.json)."
      },
      "e2e": {
        "cache": false,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "node scripts/e2e.mjs"
          ]
        },
        "description": "Run the @tools/ollama-proxy end-to-end check via scripts/e2e.mjs."
      },
      "lint": {},
      "serve": {
        "cache": false,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "nx run @tools/ollama-proxy:build:tsc",
            "node --env-file=.env.default --env-file=.env ./dist/server.js"
          ],
          "parallel": false
        },
        "description": "Build then run the ollama-proxy server (dist/server.js) with .env.default/.env loaded."
      },
      "typecheck-tests": {}
    }
  }
}
